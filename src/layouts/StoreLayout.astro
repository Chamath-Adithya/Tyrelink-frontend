---
const { title = 'Tyrelink', description = 'Find, compare and fit tyres with confidence.' } = Astro.props;
---
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><link rel="icon" href="/favicon.svg" /><title>{title}</title></head><body><a class="skip" href="#main">Skip to content</a><header><div class="top"><div class="wrap">Islandwide Sri Lanka · 24-hour WhatsApp support</div></div><div class="nav wrap"><a class="brand" href="/"><span>›››</span>TYRE<span>LINK</span></a><nav><a href="/shop">Shop tyres</a><a href="/#garages">Garage solutions</a><a href="/#learn">Learn</a><a href="/warranty-check">Warranty</a><a href="/track-order">Track order</a></nav><span class="cart" aria-live="polite">Saved tyres: <b id="cart-count">0</b></span><a class="wa" href="https://wa.me/94783724920">WhatsApp us</a></div></header><main id="main"><slot /></main><footer><div class="wrap"><strong>TYRE<span>LINK</span></strong><p>ඔබේ ගමනට නිවැරදි ටයරය.</p><a href="tel:+94783724920">078 372 4920 · Available 24 hours</a></div></footer><script>const key='tyrelink-cart';const refresh=()=>{const items=JSON.parse(localStorage.getItem(key)||'[]');const el=document.querySelector('#cart-count');if(el)el.textContent=items.length};refresh();window.addEventListener('tyrelink:cart-updated',refresh);</script></body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#f7f7f4;color:#111;font-family:Inter,system-ui,sans-serif}:global(a){color:inherit;text-decoration:none}.wrap{width:min(1180px,calc(100% - 40px));margin:auto}.top{background:#111;color:#fff;font-size:11px;padding:9px 0}.nav{height:76px;display:flex;align-items:center;gap:30px}.brand{font-weight:900;font-size:22px;letter-spacing:-1px;margin-right:auto}.brand>span:first-child{color:#ed1c24;margin-right:8px}.brand>span:last-child{color:#ed1c24}nav{display:flex;gap:24px;color:#555;font-size:13px}nav a:hover{color:#ed1c24}.wa{background:#25d366;color:#fff;padding:11px 15px;font-size:12px;font-weight:800;border-radius:3px}.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;background:#fff;padding:10px;z-index:20}main{min-height:70vh}footer{background:#111;color:#fff;padding:42px 0;margin-top:70px}footer strong{font-size:22px}footer strong span{color:#ed1c24}footer p{color:#999}footer a{font-size:12px;color:#ddd}@media(max-width:760px){nav{display:none}.nav{height:64px}.wa{font-size:11px}.top{font-size:10px}}
</style>
