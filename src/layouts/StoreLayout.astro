---
const { title = 'Tyrelink', description = 'Find, compare and fit tyres with confidence.' } = Astro.props;
const path = Astro.url.pathname;
const whatsapp = '94783724920';
---
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content="#101010" /><link rel="icon" href="/favicon.svg" /><title>{title}</title></head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="trust-bar"><div class="shell trust-inner"><span><i></i> Trusted tyre guidance for Sri Lanka</span><div class="trust-links"><a href="/warranty-check">Warranty</a><span>·</span><a href="/track-order">Track order</a><span>·</span><a href={`tel:+${whatsapp}`}>078 372 4920</a></div></div></div>
      <div class="nav-shell shell">
        <a class="brand" href="/" aria-label="Tyrelink home"><span class="brand-mark">›››</span><strong>TYRE<span>LINK</span></strong></a>
        <nav class="desktop-nav" aria-label="Primary navigation"><a class:list:active={path === '/'} href="/">Home</a><a class:list:active={path.startsWith('/shop')} href="/shop">Shop tyres</a><a href="/#garages">Garage solutions</a><a href="/#learn">Learn</a><a href="/contact">Contact</a></nav>
        <div class="nav-actions"><a class="saved" href="/shop" aria-label="Saved tyres">Saved <b id="cart-count">0</b></a><a class="whatsapp-button" href={`https://wa.me/${whatsapp}?text=${encodeURIComponent('Hello Tyrelink, I need help choosing a tyre.')}`} target="_blank" rel="noopener noreferrer">WhatsApp <span>↗</span></a><button class="menu-button" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">☰</button></div>
      </div>
      <div class="mobile-menu" id="mobile-menu" hidden><nav aria-label="Mobile navigation"><a href="/">Home</a><a href="/shop">Shop tyres</a><a href="/#garages">Garage solutions</a><a href="/#learn">Learn</a><a href="/warranty-check">Warranty</a><a href="/track-order">Track order</a><a href="/contact">Contact</a></nav></div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="shell footer-grid"><div><a class="brand footer-brand" href="/"><span class="brand-mark">›››</span><strong>TYRE<span>LINK</span></strong></a><p>ඔබේ ගමනට නිවැරදි ටයරය.<br />Find the right tyre. Fit it with confidence.</p></div><div><b>Explore</b><a href="/shop">Shop tyres</a><a href="/about">About Tyrelink</a><a href="/faq">FAQs</a></div><div><b>Support</b><a href="/warranty-check">Warranty check</a><a href="/track-order">Track order</a><a href={`tel:+${whatsapp}`}>078 372 4920</a></div></div><div class="shell footer-bottom"><span>© 2026 Tyrelink</span><span>Prices and availability are confirmed on WhatsApp.</span></div></footer>
    <a class="floating-whatsapp" href={`https://wa.me/${whatsapp}?text=${encodeURIComponent('Hello Tyrelink, I need help with tyres.')}`} target="_blank" rel="noopener noreferrer" aria-label="Chat with Tyrelink on WhatsApp">◔ <span>WhatsApp help</span></a>
    <script>
      const key = 'tyrelink-cart'; const refresh = () => { const el = document.querySelector('#cart-count'); if (!el) return; try { el.textContent = String(JSON.parse(localStorage.getItem(key) || '[]').length); } catch { el.textContent = '0'; } }; refresh(); window.addEventListener('tyrelink:cart-updated', refresh);
      const menu = document.querySelector('#mobile-menu'); const button = document.querySelector('.menu-button'); button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); if (menu) menu.hidden = open; });
    </script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#f5f5f2;color:#121212;font-family:'Plus Jakarta Sans',Inter,ui-sans-serif,system-ui,sans-serif}:global(a){color:inherit;text-decoration:none}.shell{width:min(1180px,calc(100% - 40px));margin-inline:auto}.skip{position:absolute;left:-999px;top:8px}.skip:focus{left:12px;z-index:100;background:#fff;padding:12px;border:2px solid #ed1c24}.trust-bar{background:#111;color:#d7d7d2;font-size:11px}.trust-inner{display:flex;justify-content:space-between;gap:20px;padding:9px 0}.trust-inner i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#ed1c24;margin-right:7px}.trust-links{display:flex;gap:9px}.trust-links a:hover{color:#fff}.nav-shell{min-height:78px;display:flex;align-items:center;gap:28px}.brand{display:flex;align-items:center;gap:9px;white-space:nowrap}.brand strong{font-size:21px;letter-spacing:-1.2px}.brand strong span{color:#ed1c24}.brand-mark{color:#ed1c24;font-size:29px;line-height:1;letter-spacing:-12px;width:27px;overflow:hidden;transform:skew(-18deg)}.desktop-nav{display:flex;align-items:center;gap:25px;margin-left:auto;color:#5f5f5a;font-size:12px;font-weight:700}.desktop-nav a{padding:30px 0;border-bottom:2px solid transparent;transition:color .18s,border-color .18s}.desktop-nav a:hover,.desktop-nav a.active{color:#ed1c24;border-color:#ed1c24}.nav-actions{display:flex;align-items:center;gap:10px;margin-left:auto}.saved{font-size:11px;color:#666;padding:10px}.saved b{color:#ed1c24}.whatsapp-button{background:#25d366;color:#fff;border-radius:14px;padding:12px 15px;font-size:11px;font-weight:800;box-shadow:0 6px 16px #25d36633;transition:transform .18s,box-shadow .18s}.whatsapp-button:hover{transform:translateY(-2px);box-shadow:0 10px 24px #25d36655}.menu-button{display:none;border:1px solid #ddd;background:#fff;border-radius:12px;padding:10px 12px;font-size:18px}.mobile-menu{border-top:1px solid #e5e5df;background:#fff;padding:10px 20px 18px}.mobile-menu nav{width:min(1180px,100%);margin:auto;display:grid;gap:3px}.mobile-menu a{padding:12px;border-radius:10px;font-size:13px;font-weight:700}.mobile-menu a:hover{background:#f7e9e9;color:#ed1c24}.site-footer{background:#111;color:#fff;margin-top:78px;padding:54px 0 20px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:36px}.footer-brand{color:#fff}.footer-grid p{color:#969692;font-size:12px;line-height:1.8}.footer-grid>div:not(:first-child){display:grid;align-content:start;gap:10px;font-size:12px;color:#bbb}.footer-grid b{color:#fff;margin-bottom:4px}.footer-bottom{border-top:1px solid #333;margin-top:42px;padding-top:18px;display:flex;justify-content:space-between;color:#777;font-size:10px}.floating-whatsapp{position:fixed;z-index:20;right:22px;bottom:22px;background:#25d366;color:#fff;border-radius:999px;padding:13px 17px;font-size:12px;font-weight:800;box-shadow:0 10px 25px #25d36655;transition:transform .18s}.floating-whatsapp:hover{transform:translateY(-3px)}@media(max-width:820px){.shell{width:min(100% - 32px,620px)}.desktop-nav{display:none}.nav-shell{min-height:70px}.nav-actions{margin-left:auto}.menu-button{display:block}.trust-inner{font-size:10px}.trust-links{display:none}.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}.footer-bottom{display:block}.footer-bottom span{display:block;margin-top:7px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}@media(max-width:480px){.saved{display:none}.whatsapp-button{padding:11px 12px}.whatsapp-button span{display:none}.floating-whatsapp{right:14px;bottom:calc(14px + env(safe-area-inset-bottom));padding:13px 15px}.floating-whatsapp span{display:none}}
</style>
