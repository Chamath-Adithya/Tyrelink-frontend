---
import Layout from '../../layouts/Layout.astro';
import MoreProducts from '../../components/MoreProducts';
import ProductVideoReview from '../../components/ProductVideoReview';
import ProductImageGallery from '../../components/ProductImageGallery.astro';
import ProductPurchaseActions from '../../components/ProductPurchaseActions';
import ProductStickyBuyBar from '../../components/ProductStickyBuyBar';
import ProductAdminBar from '../../components/admin/ProductAdminBar';
import ProductKokoBanner from '../../components/ProductKokoBanner';
import ProductExperience from '../../components/ProductExperience';
import productsData from '../../data/products.json';
import type { Product } from '../../types';
import '../../styles/product-detail.css';
export function getStaticPaths() {
  return (productsData as Product[]).map(product => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props as { product: Product };
const relatedProducts = (productsData as Product[]).filter(p => p.category === product.category && p.id !== product.id).slice(0, 4);
const category = product.category.replaceAll('-', ' ');
const faqs = [
  { question: `Will ${product.title} fit my vehicle?`, answer: `Check the listed specifications against your vehicle requirements. Send our team a photo of your current tyre sidewall or equipment requirements to confirm compatibility before ordering.` },
  { question: 'What warranty applies?', answer: `${product.warranty}. Ask our team to confirm the applicable manufacturer terms, exclusions and claim process before purchase.` },
  { question: 'Can I pay in instalments?', answer: 'Koko and Payzy options are shown with the price. Provider eligibility and terms apply; confirm the available payment option when placing your order.' },
  { question: 'How do I confirm delivery and manufacture date?', answer: 'Send us your town and required quantity. Our team will confirm stock, delivery charges, estimated timing and the available manufacture date before you pay.' },
];
const breadcrumbs = [
  { name: 'Home', item: new URL('/', Astro.url).href },
  { name: category, item: new URL(`/category/${product.category}`, Astro.url).href },
  { name: product.title, item: Astro.url.href },
];
---
<Layout title={`${product.title} | TyreLink Sri Lanka`} description={`${product.shortDescription} View specifications, payment options and compare ${category} at TyreLink.`} image={product.featuredImage} product={product} breadcrumbs={breadcrumbs} faq={faqs}>
  <article class="product-detail">
    <ProductAdminBar client:load product={product} />
    <nav class="pd-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={`/category/${product.category}`}>{category}</a><span>/</span><span aria-current="page">{product.title}</span></nav>
    <div class="pd-hero">
      <div class="pd-visual">
        <div class="pd-gallery-wrap" data-pd-reveal>
          <div class="pd-eyebrow"><span>{product.brand}</span><span>Made for your next journey</span></div>
          <ProductImageGallery title={product.title} images={product.images?.length ? product.images : [product.featuredImage]} featuredImage={product.featuredImage} isFlashDeal={product.isFlashDeal} flashDealDiscount={product.flashDealDiscount} />
          <p class="pd-image-caption">Explore the details. Select the image for a closer look.</p>
        </div>
      </div>
      <div class="pd-summary" data-pd-reveal>
        <div class="pd-eyebrow"><a href={`/category/${product.category}`}>{category}</a><span class:list={['pd-stock', { 'pd-unavailable': !product.inStock }]}>{product.inStock ? 'Available to order' : 'Enquire about availability'}</span></div>
        <h1>{product.title}</h1>
        <p class="pd-description product-speakable-summary">{product.shortDescription}</p>
        <a class="pd-spec-link" href="#product-specifications">Explore specifications ↓</a>
        <div class="pd-price-block">
          <div class="pd-price"><strong>Rs. {product.price.toLocaleString('en-US')}</strong>{product.originalPrice && product.originalPrice > product.price && <del>Rs. {product.originalPrice.toLocaleString('en-US')}</del>}</div>
          <p class="pd-price-note">Price per item · Confirm current stock with our team</p>
          <ProductKokoBanner client:load product={product} />
        </div>
        <div id="main-buy-cta"><ProductPurchaseActions client:load product={product} /></div>
        <div class="pd-assurance"><span>01 / Fitment guidance</span><span>02 / Islandwide delivery enquiries</span><span>03 / {product.warranty}</span></div>
      </div>
    </div>
    <section class="pd-details" id="product-specifications" aria-labelledby="spec-title">
      <div class="pd-chapter" data-pd-reveal><span class="pd-eyebrow">01 / A closer look</span><h2 id="spec-title">The details.<br/><span>The right fit.</span></h2><p>Know what you’re choosing. Match these specifications to your vehicle or workshop before you order.</p>
      <svg class="pd-road" viewBox="0 0 400 180" fill="none" aria-hidden="true"><path d="M-20 150C90 150 70 20 180 30S280 180 420 40" stroke="currentColor" stroke-width="38"/><path class="pd-road-line" d="M-20 150C90 150 70 20 180 30S280 180 420 40" stroke="#fafaf8" stroke-width="2" stroke-dasharray="12 12"/><circle cx="180" cy="30" r="10" fill="#ed1c24"/></svg>
      </div>
      <dl class="pd-specs" data-pd-reveal>{Object.entries(product.specs || {}).map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}<div><dt>Brand</dt><dd>{product.brand}</dd></div><div><dt>Manufacture date</dt><dd>{product.specs['Manufacture date'] || 'Confirm available batch with our team'}</dd></div></dl>
    </section>
    <div class="pd-video" data-pd-reveal><ProductVideoReview client:load productId={product.id} productTitle={product.title} youtubeId={product.youtubeReviewId} /></div>
    <ProductExperience client:load product={product} />
    <section class="pd-faq" aria-labelledby="pd-faq-title"><div data-pd-reveal><span class="pd-eyebrow">Before you choose</span><h2 id="pd-faq-title">A little clarity.<br/><span>A better journey.</span></h2></div><div>{faqs.map((faq, i) => <details data-pd-reveal><summary><span>0{i+1}</span>{faq.question}<b>+</b></summary><p>{faq.answer}</p></details>)}</div></section>
    <MoreProducts client:visible current={product} />
  </article>
  <!-- =====================================================
       NEXT-LEVEL FLOATING QUICK BUY DOCK (Appears on Scroll)
       ===================================================== -->
  <aside 
    id="sticky-buy-bar"
    class="fixed bottom-0 left-0 right-0 z-40 bg-white/98 backdrop-blur-xl border-t border-slate-200/90 shadow-[0_-10px_35px_-5px_rgba(0,0,0,0.12)] px-4 pt-3 pb-[max(0.75rem,calc(0.5rem+env(safe-area-inset-bottom,0px)))] sm:py-3.5"
    aria-label="Quick order dock"
  >
    <div class="max-w-[1440px] mx-auto flex items-center justify-between gap-4">
      {/* Product Mini Preview */}
      <div class="flex items-center gap-3.5 min-w-0">
        <div class="w-12 h-12 rounded-xl bg-slate-50 p-1 shrink-0 border border-slate-200/80 flex items-center justify-center">
          <img src={product.featuredImage} alt={product.title} class="w-full h-full object-contain" />
        </div>
        <div class="min-w-0 text-left">
          <p class="text-xs sm:text-sm font-bold text-slate-900 truncate max-w-xs sm:max-w-md">
            {product.title}
          </p>
          <div class="flex items-center gap-2 text-xs">
            <span class="font-black text-brand-600 font-mono">
              Rs. {product.price.toLocaleString('en-US')}
            </span>
          </div>
        </div>
      </div>

      {/* Instant Action CTAs */}
      <ProductStickyBuyBar client:load product={product} />
    </div>
  </aside>

  <!-- Product Detail Page Dynamic Scroll Behaviors -->
  <script>
    (function () {
      function initProductReveals() {
        const elements = document.querySelectorAll<HTMLElement>('[data-pd-reveal]');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const observer = new IntersectionObserver(entries => entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.classList.add('pd-visible');
            observer.unobserve(el);
          }
        }), { threshold: .12, rootMargin: '0px 0px -8% 0px' });
        elements.forEach(el => { el.classList.add('pd-motion-ready'); observer.observe(el); });
        document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
      }
      initProductReveals();
      document.addEventListener('astro:page-load', initProductReveals);
      function initProductScroll() {
        const stickyBar = document.getElementById('sticky-buy-bar');
        const mainCta = document.getElementById('main-buy-cta');
        const footer = document.getElementById('site-footer');

        if (stickyBar && mainCta) {
          let ticking = false;
          function updateBarVisibility() {
            ticking = false;
            const pastMainCta = mainCta!.getBoundingClientRect().bottom < 0;
            const overlap = footer ? Math.max(0, window.innerHeight - footer.getBoundingClientRect().top) : 0;
            (stickyBar as HTMLElement).style.bottom = `${overlap}px`;
            const visible = pastMainCta;
            stickyBar!.classList.toggle('is-visible', visible);
            stickyBar!.setAttribute('aria-hidden', String(!visible));
            (stickyBar as HTMLElement).inert = !visible;
          }
          function scheduleUpdate() {
            if (!ticking) { ticking = true; requestAnimationFrame(updateBarVisibility); }
          }
          window.addEventListener('scroll', scheduleUpdate, { passive: true });
          window.addEventListener('resize', scheduleUpdate, { passive: true });
          updateBarVisibility();
          document.addEventListener('astro:before-swap', () => {
            window.removeEventListener('scroll', scheduleUpdate);
            window.removeEventListener('resize', scheduleUpdate);
          }, { once: true });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProductScroll);
      } else {
        initProductScroll();
      }
      document.addEventListener('astro:page-load', initProductScroll);
    })();
  </script>
</Layout>
