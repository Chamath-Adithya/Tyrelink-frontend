---
import StoreLayout from '../../layouts/StoreLayout.astro'; import { products, formatLKR } from '../../data/products';
export function getStaticPaths() { return products.map((product) => ({ params: { slug: product.slug } })); }
const slug = Astro.params.slug || ''; const product = products.find((p) => p.slug === slug); if (!product) return Astro.redirect('/shop'); const phone='94783724920'; const message=encodeURIComponent(`Hello Tyrelink, I want ${product.brand} ${product.name} (${product.size}). Please confirm fitment, current price, delivery and fitting.`);
---
<StoreLayout title={`${product.brand} ${product.name} ${product.size} | Tyrelink`} description={`${product.name} ${product.size}. View indicative price and confirm fitment with Tyrelink on WhatsApp.`}><section class="pdp wrap"><a class="crumb" href="/shop">← Back to shop</a><div class="pdp-grid"><div class="visual"><div class="wheel">{product.brand}</div></div><div><p class="eyebrow">{product.category} · {product.tier}</p><p class="brand">{product.brand}</p><h1>{product.name}</h1><p class="size">{product.size} · {product.rating}</p><p class="desc">{product.description}</p><ul>{product.features.map((f)=><li>✓ {f}</li>)}</ul><div class="price"><span>Indicative public price</span><strong>{formatLKR(product.price)}</strong></div><p class="notice">Final price, availability, fitment and delivery are confirmed by our team before order acceptance.</p><div class="actions"><button class="save" data-product={product.slug}>Save tyre</button><a class="order" href={`https://wa.me/${phone}?text=${message}`}>Ask / Buy via WhatsApp ↗</a></div><small id="saved" role="status"></small></div></div></section></StoreLayout><script define:vars={{slug:product.slug}}>{`const key='tyrelink-cart';const button=document.querySelector('[data-product]');button?.addEventListener('click',()=>{const items=JSON.parse(localStorage.getItem(key)||'[]');if(!items.includes(slug))items.push(slug);localStorage.setItem(key,JSON.stringify(items));document.querySelector('#saved').textContent='Saved for your WhatsApp enquiry.';window.dispatchEvent(new Event('tyrelink:cart-updated'));});`}</script>
<style>.pdp{padding:70px 0}.crumb{font-size:12px;color:#777}.pdp-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;margin-top:35px}.visual{background:#181818;min-height:500px;display:grid;place-items:center;overflow:hidden}.wheel{width:330px;height:330px;border-radius:50%;background:repeating-conic-gradient(#222 0 7deg,#080808 7deg 15deg);box-shadow:inset 0 0 0 32px #111,0 30px 40px #0008;color:#ed1c24;display:grid;place-items:center;font-weight:900;transform:rotate(-15deg)}.eyebrow{color:#ed1c24;text-transform:uppercase;letter-spacing:2px;font-size:10px;font-weight:800}.brand{color:#ed1c24;letter-spacing:3px;font-size:12px;font-weight:800}.pdp h1{font-size:54px;line-height:.95;letter-spacing:-3px;margin:7px 0}.size{color:#777}.desc{line-height:1.6;color:#666}.pdp ul{list-style:none;padding:0;color:#444;line-height:2;font-size:13px}.price{border-top:1px solid #ddd;margin-top:25px;padding-top:17px}.price span{display:block;color:#888;font-size:11px}.price strong{font-size:30px}.notice{background:#fff2db;padding:13px;font-size:11px;line-height:1.5}.actions{display:flex;gap:10px;align-items:center}.save{border:1px solid #111;background:#fff;padding:14px 17px;font-weight:800}.order{display:inline-block;background:#25d366;color:#fff;padding:16px 20px;font-weight:800;font-size:13px}#saved{display:block;color:#1b8c45;margin-top:12px}@media(max-width:760px){.pdp{padding:45px 0}.pdp-grid{grid-template-columns:1fr;gap:35px}.visual{min-height:330px}.wheel{width:240px;height:240px}.pdp h1{font-size:42px}.actions{display:block}.actions>*{margin-top:8px}}
</style>
