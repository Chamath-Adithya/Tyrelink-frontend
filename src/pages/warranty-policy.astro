---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://tyrelink.lk/' },
  { name: 'Warranty & Replacement Policy', item: 'https://tyrelink.lk/warranty-policy' }
];

const sections = [
  {
    num: '01',
    color: 'from-emerald-500/15 to-teal-500/8',
    textColor: 'text-emerald-600',
    borderColor: 'border-emerald-100',
    title: 'Digital Warranty Registration',
    content: `Every tyre and garage machine purchased from Tyrelink is registered digitally under the customer's invoice and serial / DOT number in our verified warranty database. No physical paper card loss anxiety! You can verify your active coverage days anytime at <a href="/warranty-check" class="text-brand-600 font-bold hover:underline">/warranty-check</a>.`
  },
  {
    num: '02',
    color: 'from-brand-500/15 to-red-500/8',
    textColor: 'text-brand-600',
    borderColor: 'border-brand-100',
    title: 'Manufacturer Warranty Terms',
    content: `Tyres under company manufacturer warranty (including CEAT, DSI, Michelin, Bridgestone, Dunlop, Hankook) covering manufacturing and structural defects are honored directly with factory inspection and replacement or pro-rata credit according to the brand's policy.`
  },
  {
    num: '03',
    color: 'from-red-500/15 to-rose-500/8',
    textColor: 'text-red-600',
    borderColor: 'border-red-100',
    title: 'Exclusions from Warranty',
    content: null,
    exclusions: [
      'Punctures, cuts, or sidewall bulges resulting from external road hazard impacts (potholes, curbs).',
      'Irregular tread wear caused by improper wheel alignment, suspension faults, or under/over-inflation.',
      'Tyres used for track racing, burnout stunts, or fitted to unapproved rim sizes.'
    ]
  },
  {
    num: '04',
    color: 'from-blue-500/15 to-indigo-500/8',
    textColor: 'text-blue-600',
    borderColor: 'border-blue-100',
    title: 'How to Claim Your Warranty',
    content: null,
    steps: [
      `Visit <a href="/warranty-check" class="text-brand-600 font-bold hover:underline">/warranty-check</a> and verify your active coverage status with your invoice or serial number.`,
      `Contact our dedicated WhatsApp hotline at <a href="https://wa.me/94783724920" class="text-emerald-600 font-bold hover:underline">078 372 4920</a> with photos of the tyre sidewall DOT code, tread depth, and invoice.`,
      `Bring the tyre to our partner fitting centre or send for manufacturer technical inspection.`
    ]
  }
];
---

<Layout
  title="Warranty & Replacement Policy | Tyrelink Sri Lanka"
  description="Learn about the Tyrelink digital warranty policy, company replacement terms, claim procedure, and hardware coverage."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-20 space-y-12 sm:space-y-14">
    
    <!-- Hero Header Stage -->
    <div class="text-center space-y-4 max-w-2xl mx-auto reveal">
      <span class="section-badge">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Transparency & Customer Protection
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 font-display tracking-tight leading-[1.08]">
        Warranty & Replacement Policy
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 font-sinhala leading-relaxed">
        වගකීම් කොන්දේසි සහ භාණ්ඩ ආපසු භාරගැනීමේ නිල ප්‍රතිපත්තිය
      </p>
    </div>

    <!-- Policy Sections -->
    <div class="space-y-5">
      {sections.map((sec, idx) => (
        <div
          class="reveal bg-white/80 backdrop-blur-2xl rounded-2xl p-8 sm:p-10 shadow-[0_12px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_48px_rgba(237,28,36,0.18)] hover:-translate-y-1 transition-all duration-300 text-left space-y-4 border border-white/90 glass-card"
          data-delay={idx * 90}
        >
          <div class="flex items-center gap-4">
            <span class={`w-11 h-11 rounded-2xl bg-gradient-to-br ${sec.color} ${sec.textColor} font-black text-sm flex items-center justify-center shrink-0 border ${sec.borderColor}`}>
              {sec.num}
            </span>
            <h2 class="text-lg sm:text-xl font-black text-slate-900 font-display">
              {sec.title}
            </h2>
          </div>
          <div class="pl-[60px] text-xs sm:text-sm text-slate-600 leading-relaxed space-y-2">
            {sec.content && <p set:html={sec.content} />}
            {sec.exclusions && (
              <ul class="space-y-2">
                {sec.exclusions.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-400 mt-1.5 shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
            {sec.steps && (
              <ol class="space-y-2">
                {sec.steps.map((step, si) => (
                  <li class="flex items-start gap-3">
                    <span class="w-5 h-5 rounded-full bg-brand-100 text-brand-700 font-black text-[10px] flex items-center justify-center shrink-0 mt-0.5">{si + 1}</span>
                    <span set:html={step} />
                  </li>
                ))}
              </ol>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</Layout>
