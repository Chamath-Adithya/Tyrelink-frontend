---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://tyrelink.lk/' },
  { name: 'About Us', item: 'https://tyrelink.lk/about' }
];
---

<Layout
  title="About Tyrelink — Sri Lanka's Islandwide Tyre & Garage Partner"
  description="Learn more about Tyrelink, our mission to make tyre buying simple, transparent, and trusted with verified manufacture dates, fitment guidance, and islandwide delivery."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-12">
    
    <!-- Hero header -->
    <div class="space-y-4 text-left reveal">
      <span class="section-badge">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
        Our Story & Commitment
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 font-display tracking-tight leading-[1.08]">
        The Right Tyre.<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-red-600">Made Simple & Trusted.</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl font-sans">
        <b>Tyrelink</b> was created to solve the real problems Sri Lankan drivers and workshops face: opaque pricing, questionable tyre manufacture dates, and confusing fitment choices. We combine transparent pricing with verified factory stock, expert guidance on WhatsApp, and islandwide delivery.
      </p>
      <p class="text-xs sm:text-sm text-slate-400 font-sinhala leading-relaxed">
        ඔබේ වාහනයට නිවැරදිම ටයරය සාධාරණ මිලකට, නිරවුල් වගකීමක් සහිතව දිවයිනේ ඕනෑම තැනකට ගෙන්වාගැනීමේ විශ්වාසය.
      </p>
    </div>

    <!-- Core Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger-children">
      <div class="reveal-scale p-7 rounded-xl bg-white/80 backdrop-blur-2xl shadow-[0_12px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_48px_rgba(237,28,36,0.15)] hover:-translate-y-2 transition-all duration-300 space-y-4 border border-white/90 glass-card">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/15 to-red-500/8 text-brand-600 flex items-center justify-center">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9v-2h2v2zm0-4H9V7h2v5z"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 font-display">Verified DOT & Dates</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Every tyre is checked for genuine manufacture batch dates and official warranty before it is dispatched to you.
        </p>
      </div>

      <div class="reveal-scale p-7 rounded-xl bg-white/80 backdrop-blur-2xl shadow-[0_12px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_48px_rgba(16,185,129,0.15)] hover:-translate-y-2 transition-all duration-300 space-y-4 border border-white/90 glass-card">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500/15 to-teal-500/8 text-emerald-600 flex items-center justify-center">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 font-display">Human Fitment Guidance</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Not sure about rim sizes, load ratings, or tread patterns? Our tyre experts confirm fitment on WhatsApp before you buy.
        </p>
      </div>

      <div class="reveal-scale p-7 rounded-xl bg-white/80 backdrop-blur-2xl shadow-[0_12px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_48px_rgba(37,211,102,0.15)] hover:-translate-y-2 transition-all duration-300 space-y-4 border border-white/90 glass-card">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500/15 to-green-500/8 text-[#25D366] flex items-center justify-center">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 font-display">1-Click WhatsApp</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Order in seconds without registration friction. Conversational confirmations and Cash on Delivery across all 25 districts.
        </p>
      </div>
    </div>

    <!-- Islandwide Network & Fulfillment -->
    <div class="reveal p-8 sm:p-10 rounded-xl bg-gradient-to-br from-slate-950 to-slate-900 text-white space-y-5 relative overflow-hidden">
      <!-- Background decoration -->
      <div class="absolute inset-0 tech-dot-grid-dark opacity-30 pointer-events-none"></div>
      <div class="absolute -top-16 -right-16 w-48 h-48 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-brand-500/20 border border-brand-500/30 flex items-center justify-center text-brand-400 shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <h2 class="text-xl font-bold text-white font-display">
          Islandwide Delivery & Service Network
        </h2>
      </div>
      <p class="relative text-xs sm:text-sm text-slate-400 leading-relaxed">
        We deliver tyres, wheels, and garage tools to workshops, garages, and vehicle owners across all 25 districts in Sri Lanka. Every order is inspected for bead integrity and sidewall condition prior to dispatch.
      </p>
      <div class="relative pt-2">
        <a 
          href="https://wa.me/94783724920?text=Hello%20Tyrelink,%20I%20need%20help%20with%20tyres" 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-brand-500 hover:bg-brand-600 text-white font-bold text-xs shadow-glow-sm transition-all"
        >
          <span>Speak with a Tyre Specialist</span>
          <span>↗</span>
        </a>
      </div>
    </div>

  </div>
</Layout>
