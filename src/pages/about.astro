---
import Layout from '../layouts/Layout.astro';
import GoogleReviewsAndMap from '../components/GoogleReviewsAndMap.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://tyrelink.lk/' },
  { name: 'About Us', item: 'https://tyrelink.lk/about' }
];
---

<Layout
  title="About Tyrelink — Sri Lanka's Authoritative Tyre & Garage Partner"
  description="Learn about Tyrelink (Pvt) Ltd: Sri Lanka's trusted distributor of genuine CEAT, Michelin, Dunlop, and DSI tyres. Certified manufacture dates, warehouse distribution, and islandwide delivery."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
    
    <!-- Hero Header -->
    <div class="space-y-4 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-slate-800 text-[11px] font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
        <span>Corporate Profile & Engineering Standards</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 font-display tracking-tight leading-[1.08]">
        Built on Engineering Rigor. <br />
        <span class="text-brand-600">Trusted on Every Highway.</span>
      </h1>

      <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-3xl font-normal">
        <b>Tyrelink (Pvt) Ltd</b> is Sri Lanka's modern automotive tyre distributor and workshop solutions partner. We bridge the gap between world-class tyre manufacturers and Sri Lankan motorists by eliminating unverified stock, grey-market imports, and obsolete manufacture dates.
      </p>

      <p class="text-xs sm:text-sm text-slate-500 font-sinhala leading-relaxed">
        ශ්‍රී ලංකාවේ මෝටර් රථ, SUV, මෝටර්සයිකල් සහ වාණිජ රථ සඳහා නිල සමාගම් වගකීම් සහතික සහිත 100% ක් සත්‍ය ටයර් විශ්වාසයෙන් ලබාදෙන එකම තාක්ෂණික හවුල්කරු.
      </p>
    </div>

    <!-- Key Operational Strengths (Veloretti Minimalist Bento) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="p-8 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-card hover:-translate-y-1 transition-all">
        <div class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-center text-brand-600 mb-6 font-bold">
          01
        </div>
        <h2 class="text-lg font-bold text-slate-900 font-display mb-2">Climate-Controlled Warehousing</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          Tyres degrade rapidly in direct UV light and humidity. Our Horana distribution hub maintains strict environmental controls to preserve compound elasticity, bead strength, and tread lifespan.
        </p>
      </div>

      <div class="p-8 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-card hover:-translate-y-1 transition-all">
        <div class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-center text-emerald-600 mb-6 font-bold">
          02
        </div>
        <h2 class="text-lg font-bold text-slate-900 font-display mb-2">Guaranteed DOT Verification</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          We inspect and record the four-digit DOT manufacture code on every tyre before dispatch. Customers are empowered to inspect the date and physical condition upon delivery before making payment.
        </p>
      </div>

      <div class="p-8 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-card hover:-translate-y-1 transition-all">
        <div class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-900 mb-6 font-bold">
          03
        </div>
        <h2 class="text-lg font-bold text-slate-900 font-display mb-2">Islandwide 24-48h Logistics</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          Covering all 25 districts with priority Cash on Delivery (COD) couriers. Whether you need passenger radials in Colombo or commercial fleet tyres in Jaffna, our distribution delivers on time.
        </p>
      </div>

    </div>

    <!-- Official Brand Partnerships -->
    <div class="p-8 sm:p-10 rounded-3xl bg-slate-50 border border-slate-200">
      <div class="text-center max-w-xl mx-auto mb-8">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Authorized Distribution Partnerships</span>
        <h3 class="text-2xl font-black text-slate-950 font-display mt-1">Direct from Certified Manufacturers</h3>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <div class="p-5 rounded-xl bg-white border border-slate-200/80 shadow-2xs">
          <div class="text-base font-black text-slate-900 font-display">CEAT</div>
          <div class="text-[11px] text-slate-500 mt-1">Certified Passenger & Moto</div>
        </div>

        <div class="p-5 rounded-xl bg-white border border-slate-200/80 shadow-2xs">
          <div class="text-base font-black text-slate-900 font-display">MICHELIN</div>
          <div class="text-[11px] text-slate-500 mt-1">Premium Performance</div>
        </div>

        <div class="p-5 rounded-xl bg-white border border-slate-200/80 shadow-2xs">
          <div class="text-base font-black text-slate-900 font-display">DUNLOP</div>
          <div class="text-[11px] text-slate-500 mt-1">4x4 All-Terrain Touring</div>
        </div>

        <div class="p-5 rounded-xl bg-white border border-slate-200/80 shadow-2xs">
          <div class="text-base font-black text-slate-900 font-display">DSI RADIALS</div>
          <div class="text-[11px] text-slate-500 mt-1">Sri Lankan Road Tuned</div>
        </div>
      </div>
    </div>

    <!-- Concise Executive Quote (Business Focus with Founder Statement) -->
    <div class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white border border-slate-800 relative overflow-hidden">
      <div class="max-w-2xl">
        <svg class="w-8 h-8 text-brand-500 opacity-60 mb-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>

        <blockquote class="text-base sm:text-xl font-normal leading-relaxed text-slate-200 italic">
          "Our commitment is straightforward: every tyre delivered by Tyrelink must guarantee safety, verified freshness, and genuine peace of mind for Sri Lankan families and commercial fleet operators."
        </blockquote>

        <div class="mt-6 pt-6 border-t border-slate-800 flex items-center justify-between">
          <div>
            <div class="text-sm font-bold text-white font-sans">Chamath Adithya</div>
            <div class="text-xs text-slate-400">Founder & Managing Director — Tyrelink (Pvt) Ltd</div>
          </div>
          <div class="text-[11px] font-mono text-emerald-400 bg-emerald-950/60 px-3 py-1 rounded-full border border-emerald-800/60">
            Registered & Verified Hub
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Integrated Google Reviews & Location Map -->
  <GoogleReviewsAndMap />
</Layout>
