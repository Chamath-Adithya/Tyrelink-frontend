---
import StoreLayout from '../layouts/StoreLayout.astro';
---
<StoreLayout title="About Tyrelink | Tyrelink"><section class="utility wrap"><p class="eyebrow">About Tyrelink</p><h1>Tyres, tools and practical help for Sri Lankan roads.</h1><p>Tyrelink is being built as a trusted specialist platform for finding, comparing and fitting tyres, with garage equipment and support for workshops.</p><a class="order" href="https://wa.me/94783724920">Talk to Tyrelink ↗</a></section></StoreLayout>
<style>.utility{padding:90px 0;max-width:720px}.eyebrow{color:#ed1c24;text-transform:uppercase;letter-spacing:2px;font-size:10px;font-weight:800}.utility h1{font-size:58px;letter-spacing:-3px;line-height:1}.utility p{color:#666;line-height:1.7}.order{display:inline-block;background:#ed1c24;color:#fff;padding:16px 20px;font-weight:800;font-size:13px}@media(max-width:760px){.utility{padding:50px 0}.utility h1{font-size:42px}}
</style>
