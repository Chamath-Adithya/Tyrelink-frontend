---
import Layout from '../layouts/Layout.astro';
import ProductCatalogFilter from '../components/ProductCatalogFilter';
import productsData from '../data/products.json';
import type { Product } from '../types';

const breadcrumbs = [
  { name: 'Home', item: 'https://tyrelink.lk/' },
  { name: 'Shop Tyres & Equipment', item: 'https://tyrelink.lk/shop' }
];

const products = productsData as Product[];
// Build ItemList for SEO — top 20 items only to keep schema compact
const itemListData = products.slice(0, 20).map((p, i) => ({
  name: p.title,
  url: `https://tyrelink.lk/product/${p.slug}`,
  position: i + 1
}));
---

<Layout
  title="Shop All Tyres, Wheels & Garage Equipment | Tyrelink Sri Lanka"
  description="Explore our full collection of genuine tyres (CEAT, DSI, Michelin, Bridgestone, Dunlop, Hankook) and garage equipment in Sri Lanka. Cash on Delivery (COD) & 1-Click WhatsApp Quick Order."
  breadcrumbs={breadcrumbs}
  itemList={itemListData}
>
  <div class="max-w-[1440px] mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-8 space-y-5 sm:space-y-8">
    
    <!-- Page Header Banner -->
    <div class="text-left space-y-2 sm:space-y-3 border-b border-slate-200/60 pb-4.5 sm:pb-7 reveal-blur">
      <div class="section-badge">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
        Tyre & Equipment Storefront — {productsData.length} Products
      </div>
      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 font-display tracking-tight leading-tight">
        All Tyres & Garage Equipment
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 font-sinhala leading-relaxed">
        දිවයින පුරා Cash on Delivery සහ 100% Genuine වගකීමක් සහිත අපගේ සියලුම භාණ්ඩ එකතුව
      </p>
    </div>

    <!-- Interactive Filter & Catalog Grid Island -->
    <ProductCatalogFilter client:load initialCategory="all" />

  </div>

  <!-- Dynamic Smooth Hash Anchor Anchor Scroll Manager -->
  <script>
    (function () {
      function checkAnchorScroll() {
        if (window.location.hash === '#catalog-products') {
          setTimeout(() => {
            const target = document.getElementById('catalog-products');
            if (target) {
              const headerOffset = 135;
              const elementPosition = target.getBoundingClientRect().top;
              const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
              window.scrollTo({
                top: Math.max(0, offsetPosition),
                behavior: 'smooth'
              });
            }
          }, 180);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', checkAnchorScroll);
      } else {
        checkAnchorScroll();
      }
      document.addEventListener('astro:page-load', checkAnchorScroll);
    })();
  </script>
</Layout>
