---
import Layout from '../layouts/Layout.astro';
const faqs = [
  {question:'Do I need an account to order?',answer:'No. Browse the collection, choose your products and use the cart or quick-order option. You can send your enquiry through WhatsApp without creating a customer account.'},
  {question:'How do I find the right tyre size?',answer:'Look for the size on your current tyre sidewall, such as 195/65 R15, and check your vehicle handbook. Send us a photo and your vehicle details if you need help. Our team can help confirm fitment before you order.'},
  {question:'Are online prices and stock final?',answer:'Please confirm the current price, available quantity and product details with our team before making payment. Availability and the final order total are confirmed when we discuss your order.'},
  {question:'Can you arrange delivery?',answer:'Contact us with your town and the items you need. We will confirm whether delivery is available for your order, together with its cost and estimated timing before you proceed.'},
  {question:'Can I collect my order?',answer:'Ask our team to confirm your items and arrange collection from TyreLink in Walasmulla. Our listed opening hours are 8:00 am to 5:00 pm daily. Calling ahead helps us prepare your order.'},
  {question:'Which payment methods can I use?',answer:'Our team will explain the payment options available for your order. Please confirm any cash-on-delivery or instalment arrangement, including its conditions, before paying.'},
  {question:'How do I check the manufacture date and warranty?',answer:'Ask our team to confirm the manufacture date and applicable warranty for the exact tyre or product you are buying. Warranty terms vary by product and supplier. Keep your invoice and contact us if you need help with a claim.'},
  {question:'What if I need to change or return an order?',answer:'Contact us as soon as possible with your order details. We will explain the options and any applicable conditions for your particular order. Please confirm suitability before fitting or using a product.'},
  {question:'Where can I leave a Google review?',answer:'Our verified Google review link will be added once our business profile is connected. In the meantime, you can share feedback by phone, email or WhatsApp.'}
];
---
<Layout title="Questions, answered | TyreLink" description="Straightforward answers about tyre sizes, guest orders, delivery, payment and product support at TyreLink." faq={faqs}>
  <div class="tl-container">
    <section class="tl-section"><p class="tl-eyebrow">Good to know</p><h1 class="tl-title">A clearer road<br />to the right choice.</h1><p class="tl-copy">Straightforward answers to the questions we hear most. If yours is not here, our team is a message away.</p></section>
    <section class="faq-layout" aria-label="Frequently asked questions">
      <aside><p class="tl-eyebrow">Personal assistance</p><h2>Rather talk it through?</h2><p class="tl-copy">Send us your question or a photo of your tyre. Let’s work it out together.</p><a class="tl-button" href="https://wa.me/94712500420" target="_blank" rel="noopener noreferrer">Ask on WhatsApp ↗</a></aside>
      <div class="faq-list">{faqs.map((faq,index)=><details open={index===0}><summary><span>{faq.question}</span><span class="faq-plus" aria-hidden="true">+</span></summary><p class="faq-answer tl-copy">{faq.answer}</p></details>)}</div>
    </section>
    <section class="tl-section"><a href="/shop" class="tl-button-secondary">Back to the collection ↗</a></section>
  </div>
</Layout>
<style>
.faq-layout{display:grid;grid-template-columns:1fr 2fr;gap:clamp(2rem,6vw,7rem)}.faq-layout aside h2{font-size:2rem;line-height:1.2;margin:1rem 0}.faq-layout aside .tl-button{margin-top:1.5rem}.faq-list details{border-top:1px solid var(--tl-line,#ddd9d0)}.faq-list details:last-child{border-bottom:1px solid var(--tl-line,#ddd9d0)}.faq-list summary{display:flex;justify-content:space-between;align-items:center;gap:2rem;padding:1.6rem 0;cursor:pointer;font-size:1.05rem;list-style:none}.faq-list summary::-webkit-details-marker{display:none}.faq-plus{font-size:1.6rem;font-weight:300;transition:transform .2s}.faq-list details[open] .faq-plus{transform:rotate(45deg)}.faq-answer{padding:0 2rem 1.6rem 0;line-height:1.8}@media(max-width:760px){.faq-layout{grid-template-columns:1fr}.faq-layout aside{padding-bottom:1.5rem}}
</style>
