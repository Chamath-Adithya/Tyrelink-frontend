---
import StoreLayout from '../layouts/StoreLayout.astro';
---
<StoreLayout title="Tyrelink Admin"><section class="admin wrap"><p class="eyebrow">Internal workspace</p><h1>Catalogue control.</h1><p>This admin surface is a foundation. Authentication and database-backed product/campaign editing are the next protected backend slice.</p><div class="admin-grid"><a href="/shop">Preview catalogue →</a><a href="/faq">Review customer FAQs →</a><a href="/contact">Open support channel →</a></div></section></StoreLayout>
<style>.admin{padding:90px 0}.eyebrow{color:#ed1c24;text-transform:uppercase;letter-spacing:2px;font-size:10px;font-weight:800}.admin h1{font-size:58px;letter-spacing:-3px}.admin p{color:#666;line-height:1.6}.admin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:35px}.admin-grid a{background:#111;color:#fff;padding:25px;font-weight:800}@media(max-width:760px){.admin{padding:50px 0}.admin h1{font-size:42px}.admin-grid{grid-template-columns:1fr}}
</style>
