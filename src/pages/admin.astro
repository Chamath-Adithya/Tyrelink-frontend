---
import Layout from '../layouts/Layout.astro';
import AdminGatewayForm from '../components/admin/AdminGatewayForm';

const breadcrumbs = [
  { name: 'Home', item: 'https://tyrelink.lk/' },
  { name: 'Admin Gateway', item: 'https://tyrelink.lk/admin' },
];
---

<Layout
  title="Admin Gateway & Live Edit Mode | Tyrelink"
  description="Secure merchant authentication portal for Tyrelink store managers."
  breadcrumbs={breadcrumbs}
>
  <div class="min-h-[75vh] flex items-center justify-center px-4 py-12 sm:py-16 relative overflow-hidden">
    <!-- Subtle Background Tech Grid -->
    <div class="absolute inset-0 tech-dot-grid opacity-20 pointer-events-none" />

    <AdminGatewayForm client:load />
  </div>
</Layout>
