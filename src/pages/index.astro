---
const categories = [
  { icon: '◉', title: 'Tyres by vehicle', text: 'Find a safe match for your car, bike, van or three-wheeler.' },
  { icon: '⌁', title: 'Tyres by size', text: 'Search the sidewall code and compare verified options.' },
  { icon: '▣', title: 'Garage equipment', text: 'Build, upgrade and maintain your workshop with confidence.' },
];
const trustPoints = ['Verified stock & manufacture date', 'Transparent fitted pricing', 'Human fitment confirmation'];
const products = [
  { brand: 'CEAT', name: 'Milaze 3', size: '155/70 R13', price: 'Rs. 18,500', tier: 'Value' },
  { brand: 'DSI', name: 'S-Drive', size: '185/65 R15', price: 'Rs. 29,900', tier: 'Balanced' },
  { brand: 'Michelin', name: 'Energy XM2+', size: '195/65 R15', price: 'Rs. 54,500', tier: 'Premium' },
];
const whatsapp = '94783724920';
---
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Tyrelink helps Sri Lanka find, compare, buy and fit the right tyres, with trusted garage equipment and service support." /><link rel="icon" href="/favicon.svg" /><title>Tyrelink | Find the right tyre. Fit it with confidence.</title></head>
<body>
<header class="nav shell"><a class="brand" href="/"><span class="brand-mark">›››</span><span>TYRE<span>LINK</span></span></a><nav><a href="#shop">Shop tyres</a><a href="#services">Services</a><a href="#garages">For garages</a><a href="#learn">Learn</a></nav><div class="nav-actions"><a class="text-link" href="tel:+94783724920">24/7 help</a><a class="button small" href="#finder">Find my tyre</a></div></header>
<main>
<section class="hero shell" id="finder"><div class="hero-copy"><p class="eyebrow"><span class="pulse"></span> Sri Lanka's islandwide tyre partner</p><h1>The right tyre.<br /><em>Made simple.</em></h1><p class="sinhala-hero">ඔබේ වාහනයට ගැළපෙන ටයරය පහසුවෙන් සොයාගන්න.</p><p class="lede">Find, compare and fit tyres with confidence. Public prices, islandwide delivery and expert help on WhatsApp—24 hours a day.</p><div class="hero-actions"><a class="button" href="#shop">Shop tyres <span>↗</span></a><a class="button ghost" href={`https://wa.me/${whatsapp}?text=${encodeURIComponent('Hello Tyrelink, I need help choosing a tyre.')}`}>WhatsApp an expert <span>↗</span></a></div><div class="proof-row">{trustPoints.map((point) => <span><b>✓</b> {point}</span>)}</div></div><div class="hero-visual"><div class="hero-glow"></div><div class="road-line"></div><img class="hero-tyre" src="/hero-tyre.png" alt="Tyrelink performance tyre illustration" /><div class="floating-card stock"><span class="check">✓</span><span><strong>Islandwide delivery</strong><small>Order through WhatsApp</small></span></div><div class="floating-card fit"><span class="mini-icon">◉</span><span><strong>Fitment guidance</strong><small>By a Tyrelink expert</small></span></div></div></section>
<section class="finder shell" id="shop"><div class="section-heading"><div><p class="eyebrow">Start here</p><h2>How do you want to find your tyre?</h2></div><p>Not sure? <a href={`https://wa.me/${whatsapp}`}>Ask an expert →</a></p></div><div class="finder-grid">{categories.map((category) => <a class="finder-card" href="#products"><span class="category-icon">{category.icon}</span><span><h3>{category.title}</h3><p>{category.text}</p></span><span class="arrow">↗</span></a>)}</div></section>
<section class="service-strip" id="services"><div class="shell strip-inner"><span>One platform. More confidence.</span><p>From your first search to your next replacement.</p><a href="#catalog">Explore our services →</a></div></section>
<section class="products shell" id="products"><div class="section-heading"><div><p class="eyebrow">Popular picks</p><h2>Public prices.<br /><span>Easy WhatsApp orders.</span></h2></div><p>Prices are examples for launch. Confirm fitment and final delivery details with our team before ordering.</p></div><div class="product-grid">{products.map((product) => <article class="product-card"><div class="product-art"><span>{product.brand}</span><strong>{product.tier}</strong></div><p class="product-brand">{product.brand}</p><h3>{product.name}</h3><p class="product-size">{product.size}</p><div class="product-bottom"><strong>{product.price}</strong><a href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(`Hello Tyrelink, I want to order ${product.brand} ${product.name} ${product.size}. Please confirm fitment and delivery.`)}`}>Buy via WhatsApp ↗</a></div></article>)}</div></section>
<section class="catalog shell" id="catalog"><div class="section-heading"><div><p class="eyebrow">Shop with clarity</p><h2>Good. Better. Best.<br /><span>Always the right fit.</span></h2></div><p>Every option comes with clear specs, availability and a price you can understand.</p></div><div class="choice-grid"><article><span class="choice-tag value">VALUE</span><h3>Reliable everyday performance</h3><p>Smart choices for daily rides and commercial use.</p><a href="#">Explore value tyres →</a></article><article class="featured"><span class="choice-tag balanced">BALANCED</span><h3>Comfort for every journey</h3><p>Our most popular mix of comfort, grip and tread life.</p><a href="#">Explore balanced tyres →</a></article><article><span class="choice-tag premium">PREMIUM</span><h3>Performance without compromise</h3><p>For drivers who want confidence in every condition.</p><a href="#">Explore premium tyres →</a></article></div></section>
<section class="garage shell" id="garages"><div class="garage-copy"><p class="eyebrow">For garages & businesses</p><h2>Build a better<br /><em>workshop.</em></h2><p>From a puncture-shop starter kit to a complete tyre centre, get the equipment, installation and after-sales support to grow with confidence.</p><a class="button dark" href="#">Explore garage solutions <span>↗</span></a></div><div class="garage-art"><div class="tool tool-one">▱</div><div class="tool tool-two">◒</div><div class="tool tool-three">⌁</div><div class="garage-label">TYRELINK<br /><small>WORKSHOP SYSTEMS</small></div></div></section>
<section class="learn shell" id="learn"><div class="section-heading"><div><p class="eyebrow">Learn before you buy</p><h2>Tyre knowledge,<br /><span>without the jargon.</span></h2></div><a href="#">Visit the learning centre →</a></div><div class="learn-grid"><article><p>GUIDE 01</p><h3>What do the numbers on a tyre mean?</h3><a href="#">Read guide →</a></article><article><p>GUIDE 02</p><h3>When should you replace your tyres?</h3><a href="#">Read guide →</a></article><article><p>GUIDE 03</p><h3>How to choose the right tyre for Sri Lankan roads</h3><a href="#">Read guide →</a></article></div></section>
</main>
<a class="whatsapp-float" href={`https://wa.me/${whatsapp}?text=${encodeURIComponent('Hello Tyrelink, I need help with tyres.')}`} aria-label="Chat with Tyrelink on WhatsApp">⌕ <span>WhatsApp us</span></a><footer><div class="shell footer-top"><a class="brand" href="/"><span class="brand-mark">›››</span><span>TYRE<span>LINK</span></span></a><p>ඔබේ ගමනට නිවැරදි ටයරය.<br />Find the right tyre. Fit it with confidence.</p><div><a href="tel:+94783724920">078 372 4920</a><a href={`https://wa.me/${whatsapp}`}>WhatsApp - 24 hours</a></div></div><div class="shell footer-bottom"><span>© 2026 Tyrelink. All rights reserved.</span><span>Islandwide service. Sinhala support.</span></div></footer>
</body></html>
