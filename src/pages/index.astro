---
import Layout from '../layouts/Layout.astro';
import VelorettiHero from '../components/VelorettiHero';
import CategoryStrip from '../components/CategoryStrip.astro';
import ProductCard from '../components/ProductCard.astro';
import GoogleReviewsAndMap from '../components/GoogleReviewsAndMap.astro';
import TrustSection from '../components/TrustSection.astro';
import CinematicVideoShowcase from '../components/CinematicVideoShowcase.astro';

import productsData from '../data/products.json';
import campaignsData from '../data/campaigns.json';
import type { Product } from '../types';

const products = productsData as Product[];

// Map flash deals directly from campaigns.json schedule / selection
const flashIds = new Set(campaignsData.flashSale?.productIds || []);
const flashDeals = products.filter(p => flashIds.has(p.id) || p.isFlashDeal).slice(0, 4);

// Map trending products
const trendingIds = new Set(campaignsData.trending?.productIds || []);
const bestSellers = products.filter(p => trendingIds.has(p.id) || p.isBestSeller).slice(0, 8);

const faqData = [
  {
    question: 'How do I place an order with 1-Click WhatsApp Quick Order?',
    answer: 'Simply click "Buy via WhatsApp" or "Quick Order" on any tyre or tool, fill in your delivery name, address, and mobile number. Your order is registered in our system and pre-filled in WhatsApp to confirm fitment and delivery.'
  },
  {
    question: 'Is Cash on Delivery (COD) available throughout Sri Lanka?',
    answer: 'Yes! We provide islandwide Cash on Delivery (COD) to all 25 districts in Sri Lanka within 1-3 business days. You can inspect the tyre manufacture dates (DOT) and condition upon arrival.'
  },
  {
    question: 'How do I get help with a product warranty?',
    answer: 'Keep your invoice and contact our WhatsApp support desk. Our team will confirm the applicable manufacturer warranty and guide you through the claim process.'
  }
];
---

<Layout 
  title="Tyrelink — Sri Lanka's Trusted Tyre, Wheel & Garage Equipment Store"
  description="Find, compare and fit tyres with confidence. 1-Click WhatsApp Quick Order, Islandwide Cash on Delivery (COD), verified manufacture dates, and genuine company warranty in Sri Lanka."
  faq={faqData}
>
  <!-- Hero Section: Veloretti Minimalist Engineering + Interactive Dimension Finder -->
  <section aria-labelledby="home-hero-heading" class="w-full pt-4 sm:pt-6 pb-6 px-4 sm:px-6 lg:px-8 max-w-[1600px] mx-auto">
    <h1 id="home-hero-heading" class="sr-only">Find the right tyres and garage equipment in Sri Lanka</h1>
    <VelorettiHero client:load />
  </section>

  <!-- Curated Vehicle Categories -->
  <CategoryStrip />

  <!-- Featured Products & Fast Movers (Veloretti Minimalist Luxury Grid) -->
  <section class="w-full py-12 sm:py-16 bg-white border-b border-slate-200/80">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-12">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 border border-red-200/80 text-brand-600 text-[10px] font-bold uppercase tracking-widest mb-2">
            Top Picks • ප්‍රමුඛතම තේරීම්
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-950 font-display tracking-tight">
            Featured Tyres & Fast Movers
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 font-sinhala font-medium mt-1">
            ශ්‍රී ලංකාවේ වැඩිපුරම අලෙවි වන, 100% ක් සහතික කළ සමාගම් වගකීම් සහිත ටයර්
          </p>
        </div>

        <a 
          href="/shop" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-sm hover:-translate-y-0.5 active:scale-95 shrink-0 self-start sm:self-auto cursor-pointer"
        >
          <span>View All Products</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Minimalist Luxury 4-Column Product Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {bestSellers.map((prod) => (
          <div class="flex">
            <ProductCard product={prod} />
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Interactive Google Reviews Wall & Horana Hub Location Map -->
  <GoogleReviewsAndMap />

  <!-- Core Trust & Brand Guarantees -->
  <TrustSection />

  <!-- Cinematic Video Showcase -->
  <CinematicVideoShowcase />

  <!-- Ready to Order Bottom Strip (Clean Studio Minimalist CTA) -->
  <section class="w-full py-16 bg-[#FAFBFC] border-t border-slate-200/80">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-14 rounded-3xl bg-slate-950 text-white text-center shadow-card border border-slate-800 relative overflow-hidden">
        
        {/* Subtle grid accent */}
        <div class="absolute inset-0 bg-[radial-gradient(#334155_1px,transparent_1px)] [background-size:20px_20px] opacity-25 pointer-events-none"></div>

        <div class="relative z-10 max-w-xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 text-white text-[11px] font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Zero-Friction Ordering</span>
          </div>

          <h2 class="text-2xl sm:text-4xl font-black text-white font-display tracking-tight">
            Not Sure Which Tyre Fits? <br />
            <span class="text-brand-500">We Verify Fitment Before You Pay.</span>
          </h2>

          <p class="text-xs sm:text-sm text-slate-300 font-normal">
            Send your car model or tyre photo on WhatsApp. Our tyre specialists confirm the exact profile, rim clearance, and dispatch date within minutes.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="https://wa.me/94783724920?text=Hi%20Tyrelink,%20I%20need%20help%20choosing%20the%20right%20tyres"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:-translate-y-0.5 active:scale-95 cursor-pointer"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              <span>WhatsApp Fitment Advice</span>
            </a>

            <a
              href="/shop"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-xs sm:text-sm border border-white/15 transition-all cursor-pointer"
            >
              <span>Browse All Tyres</span>
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>

</Layout>
