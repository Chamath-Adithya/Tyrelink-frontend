---
import Layout from '../layouts/Layout.astro';
import HeroTyreStage from '../components/HeroTyreStage.astro';
import FastTyreFinder from '../components/FastTyreFinder.astro';
import ServiceStrip from '../components/ServiceStrip.astro';
import TierComparisonGrid from '../components/TierComparisonGrid.astro';
import WorkshopSystemsSection from '../components/WorkshopSystemsSection.astro';
import TyreLearningSection from '../components/TyreLearningSection.astro';
import BrandSlider from '../components/BrandSlider.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductCarousel from '../components/ProductCarousel';
import HomeExploreProducts from '../components/HomeExploreProducts';
import TrustSection from '../components/TrustSection.astro';

import productsData from '../data/products.json';
import campaignsData from '../data/campaigns.json';
import type { Product } from '../types';

const products = productsData as Product[];

// Map flash deals directly from campaigns.json schedule / selection
const flashIds = new Set(campaignsData.flashSale?.productIds || []);
const flashDeals = products.filter(p => flashIds.has(p.id) || p.isFlashDeal).slice(0, 6);
const flashDealIds = new Set(flashDeals.map(p => p.id));

// Map trending products directly from campaigns.json selection
const trendingIds = new Set(campaignsData.trending?.productIds || []);
const bestSellers = products.filter(p => (trendingIds.has(p.id) || p.isBestSeller) && !flashDealIds.has(p.id)).slice(0, 6);

const faqData = [
  {
    question: 'How do I place an order with 1-Click WhatsApp Quick Order?',
    answer: 'Simply click "Buy via WhatsApp" on any tyre or tool. Your vehicle tyre size and preferred model are pre-filled in WhatsApp to immediately verify DOT manufacture date, stock, and delivery details.'
  },
  {
    question: 'Is Cash on Delivery (COD) available throughout Sri Lanka?',
    answer: 'Yes! We provide islandwide Cash on Delivery (COD) to all 25 districts in Sri Lanka within 1-3 business days. You can inspect the tyre manufacture dates (DOT) and condition upon arrival.'
  },
  {
    question: 'How can I verify the warranty of my purchased tyres or equipment?',
    answer: 'Visit our public /warranty-check portal anytime and enter your invoice number or tyre serial/DOT code to view active coverage, expiration dates, and claim status.'
  }
];
---

<Layout 
  title="Tyrelink | The right tyre. Made simple. — Sri Lanka's Islandwide Tyre Store"
  description="Find, compare and fit tyres with confidence. Public prices, verified manufacture dates (DOT), 1-Click WhatsApp Quick Order, and Islandwide Cash on Delivery (COD) in Sri Lanka."
  faq={faqData}
>
  <!-- 1. The Iconic Tyrelink Editorial Hero Stage (With Carbon Halo & Floating Tyre) -->
  <HeroTyreStage />

  <!-- 2. Fast Tyre Finder: 3 Architectural Categories (By vehicle, By size, Garage equipment) -->
  <FastTyreFinder />

  <!-- 3. Red Service Strip: One platform. More confidence. -->
  <ServiceStrip />

  <!-- ============================================================
       4. FLASH DEALS / TRACK SPECIALS (Sticky Pinned on Desktop)
       Pins under the sticky navbar as the user scrolls on desktop;
       scrolls fluidly on mobile
       ============================================================ -->
  <div id="flash-deals-sticky-wrapper" class="relative md:sticky md:top-[var(--header-height,98px)] transition-[top] duration-300 ease-out z-10 w-full overflow-hidden">
    <div id="flash-deals-blur-stage" class="w-full will-change-transform will-change-[filter,opacity] transition-all duration-75">
      <ProductCarousel 
        client:load 
        title="Tyrelink Track Specials & Flash Deals" 
        sinhalaTitle="අද දවසේ සුවිශේෂී මිල අඩුකිරීම් (Limited Stocks)"
        badge="HOT DEALS"
        products={flashDeals}
        countdownTimer="04h : 35m : 22s"
      />
    </div>
  </div>

  <!-- ============================================================
       5. POPULAR PICKS & BEST SELLERS (Stacking Section)
       Slides up OVER Flash Deals with smooth physical elevation
       ============================================================ -->
  <div 
    id="trending-stacking-section" 
    class="relative z-20 w-full rounded-none shadow-none border-t-0 overflow-hidden"
    style="background-color: #0c0d10; background-image: radial-gradient(ellipse at 50% 0%, rgba(237, 28, 36, 0.16) 0%, transparent 55%), radial-gradient(ellipse at 85% 30%, rgba(180, 20, 25, 0.10) 0%, transparent 50%), radial-gradient(ellipse at 15% 45%, rgba(237, 28, 36, 0.08) 0%, transparent 45%);"
  >
    <!-- Background tech dot grid -->
    <div class="absolute inset-0 tech-dot-grid-dark opacity-15 pointer-events-none"></div>

    <div class="relative z-10 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12 pb-12 space-y-4">

      <!-- Popular Picks Grid -->
      <section class="py-6 sm:py-8 reveal" id="products">
        <div class="flex items-end justify-between mb-6 sm:mb-8 flex-wrap gap-4 text-left">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900/90 text-[#ed1c24] border border-[#ed1c24]/35 text-[10px] font-black uppercase tracking-widest backdrop-blur-md shadow-md mb-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#ed1c24] animate-pulse"></span>
              <span>Popular Picks · ප්‍රමුඛතම තේරීම්</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-black text-white font-display tracking-tight leading-tight">
              Public prices.<br />
              <span class="text-slate-400">Easy WhatsApp orders.</span>
            </h2>
            <p class="text-xs sm:text-sm text-slate-400 font-sinhala font-medium mt-1">
              ලංකාවේ වැඩිපුරම අලෙවි වන CEAT, DSI, Michelin සහ Dunlop ටයර්
            </p>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <!-- Admin In-Section Actions (Shown only when in Edit Mode) -->
            <div class="admin-trending-controls hidden items-center gap-1.5 sm:gap-2">
              <button
                type="button"
                onclick="window.dispatchEvent(new CustomEvent('tyrelink:open-trending-modal'))"
                title="Select Existing Products for Trending"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-white text-[11px] font-black transition-all shadow-md hover:scale-105 active:scale-95 cursor-pointer"
              >
                <span>+ Pick Products</span>
              </button>

              <button
                type="button"
                onclick="window.dispatchEvent(new CustomEvent('tyrelink:open-trending-modal'))"
                title="Manage Trending & Best Sellers Collection"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-950 border border-brand-500/50 text-brand-300 text-[11px] font-bold transition-all shadow-sm hover:scale-105 active:scale-95 cursor-pointer"
              >
                <span>Edit Trending Collection</span>
              </button>
            </div>

            <a 
              href="/shop" 
              class="inline-flex items-center gap-1.5 text-xs font-bold text-white bg-white/10 hover:bg-white/20 px-4 py-2.5 rounded-xl transition-all border border-white/15 backdrop-blur-md group shadow-sm"
            >
              <span>View All Tyres</span>
              <span class="group-hover:translate-x-1 transition-transform">↗</span>
            </a>
          </div>
        </div>

        <!-- Product grid: responsive multi-column with authentic Tyrelink tyre cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-3 gap-5 stagger-children">
          {bestSellers.map((prod, i) => (
            <div class="reveal-scale" style={`transition-delay: ${i * 70}ms`}>
              <ProductCard product={prod} />
            </div>
          ))}
        </div>
      </section>

    </div>

    <!-- 6. Shop with Clarity: Good. Better. Best. (Tier Comparison Grid) -->
    <div class="w-full bg-[#f7f7f4] border-t border-slate-200">
      <TierComparisonGrid />
    </div>

    <!-- 7. For Garages & Businesses: Build a Better Workshop -->
    <div class="w-full bg-[#f7f7f4] border-t border-slate-200/80">
      <WorkshopSystemsSection />
    </div>

    <!-- 8. Tyre Knowledge Without the Jargon (Learning Centre) -->
    <div class="w-full bg-[#f7f7f4] border-t border-slate-200/80">
      <TyreLearningSection />
    </div>

    <!-- 9. Official Brands Carousel -->
    <div class="w-full bg-[#f7f7f4] border-t border-slate-200/80 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
      <BrandSlider />
    </div>

    <!-- 10. Complete Store Catalog Explore Feed with Filter Tabs -->
    <div 
      class="w-full relative z-10 border-t border-slate-200/80"
      style="background-color: #f7f7f4; background-image: radial-gradient(ellipse at 50% 0%, rgba(237, 28, 36, 0.06) 0%, transparent 55%), radial-gradient(ellipse at 90% 80%, rgba(201, 20, 27, 0.04) 0%, transparent 45%);"
    >
      <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12 pb-6">
        <HomeExploreProducts client:load />
      </div>

      <!-- 11. Full-width Trust Commitment Section -->
      <TrustSection />

      <!-- 12. Bottom WhatsApp Order Banner (Instant WhatsApp Order) -->
      <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="relative rounded-2xl overflow-hidden p-8 sm:p-12 text-center reveal"
          style="background: linear-gradient(135deg, #ed1c24 0%, #c9141b 50%, #8a0e13 100%);">
          <!-- Background texture -->
          <div class="absolute inset-0 tech-dot-grid opacity-20 pointer-events-none"></div>
          
          <div class="relative z-10 max-w-xl mx-auto space-y-5">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/20 text-white text-[10px] font-bold uppercase tracking-wider backdrop-blur-sm">
              <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
              Instant WhatsApp Order
            </div>
            <h2 class="text-3xl sm:text-4xl font-black text-white font-display tracking-tight leading-tight">
              Ready to Order? Chat With Us Now!
            </h2>
            <p class="text-sm text-white/90 font-sinhala">
              ඔබේ order WhatsApp හරහා ක්ෂණිකව දෙන්න — Islandwide Cash on Delivery
            </p>
            <a
              href="https://wa.me/94783724920?text=Hi%20Tyrelink,%20I%20would%20like%20to%20place%20an%20order"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-8 py-4 rounded-xl bg-white text-[#ed1c24] font-black text-sm uppercase tracking-wider hover:scale-105 hover:shadow-[0_12px_32px_rgba(0,0,0,0.3)] active:scale-95 transition-all"
            >
              <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
              <span>Chat on WhatsApp (078 372 4920)</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>

<!-- ============================================================
     CINEMATIC SCROLL STACKING & PROGRESSIVE BLUR ENGINE
     Tracks the physical overlap between Flash Deals and Trending,
     progressively applying smooth optical blur & depth scaling
     ============================================================ -->
<script>
  function initScrollStackingAndBlur() {
    const stickyWrapper = document.getElementById('flash-deals-sticky-wrapper');
    const blurTarget = document.getElementById('flash-deals-blur-stage');
    const stackingSection = document.getElementById('trending-stacking-section');

    if (!stickyWrapper || !blurTarget || !stackingSection) return;

    let ticking = false;

    function update() {
      if (window.innerWidth < 768) {
        blurTarget.style.filter = 'none';
        blurTarget.style.opacity = '1';
        blurTarget.style.transform = 'none';
        ticking = false;
        return;
      }

      const stickyRect = stickyWrapper.getBoundingClientRect();
      const stackingRect = stackingSection.getBoundingClientRect();

      const stickyHeight = stickyRect.height || 500;
      const stickyBottom = stickyRect.top + stickyHeight;
      const overlapPx = stickyBottom - stackingRect.top;

      let progress = overlapPx / stickyHeight;
      progress = Math.max(0, Math.min(1, progress));

      if (progress > 0.01) {
        const blurAmount = (progress * 14).toFixed(1);
        const opacity = (1 - progress * 0.55).toFixed(2);
        const scale = (1 - progress * 0.04).toFixed(3);

        blurTarget.style.filter = `blur(${blurAmount}px)`;
        blurTarget.style.opacity = opacity;
        blurTarget.style.transform = `scale(${scale})`;
        blurTarget.style.transformOrigin = 'center 15%';
      } else {
        blurTarget.style.filter = 'none';
        blurTarget.style.opacity = '1';
        blurTarget.style.transform = 'none';
      }

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.removeEventListener('scroll', onScroll);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollStackingAndBlur);
  } else {
    initScrollStackingAndBlur();
  }
  document.addEventListener('astro:page-load', initScrollStackingAndBlur);
</script>
