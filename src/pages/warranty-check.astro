---
import Layout from '../layouts/Layout.astro';
import WarrantyChecker from '../components/WarrantyChecker';

const breadcrumbs = [
  { name: 'Home', item: 'https://tyrelink.lk/' },
  { name: 'Warranty Verification', item: 'https://tyrelink.lk/warranty-check' }
];
---

<Layout
  title="Online Warranty Verification Portal | Tyrelink Sri Lanka"
  description="Check and verify your official product warranty and remaining coverage duration online with Tyrelink digital warranty tracking."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10 pb-20 space-y-12 sm:space-y-14">
    
    <!-- Hero Header Stage -->
    <div class="text-center max-w-xl mx-auto space-y-4 reveal">
      <span class="section-badge">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Official Trust Ecosystem
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 font-display tracking-tight leading-[1.08]">
        Online Warranty Verification
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 font-sinhala leading-relaxed pt-1">
        Tyrelink වෙතින් මිලදී ගත් ඕනෑම භාණ්ඩයක වගකීම් සහතිකය, කාලසීමාව සහ තත්ත්වය මෙතැනින් ක්ෂණිකව පරීක්ෂා කරගන්න.
      </p>
    </div>

    <!-- Search Tool Island -->
    <div class="reveal-scale">
      <WarrantyChecker client:load />
    </div>

    <!-- 3-Step Trust Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger-children">
      
      <div class="reveal-scale p-8 rounded-3xl bg-white/80 backdrop-blur-2xl shadow-[0_12px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_48px_rgba(16,185,129,0.18)] hover:-translate-y-2 transition-all duration-300 border border-white/90 space-y-4 text-left glass-card">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500/15 to-teal-500/8 text-emerald-600 flex items-center justify-center font-black text-base border border-emerald-100">
          01
        </div>
        <div class="space-y-1.5">
          <h3 class="text-sm font-black text-slate-900 font-display">Digital Serial Registration</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Every tyre, wheel, and machine dispatched is digitally mapped to its invoice and serial/DOT code in our verified database.
          </p>
        </div>
      </div>

      <div class="reveal-scale p-8 rounded-3xl bg-white/80 backdrop-blur-2xl shadow-[0_12px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_48px_rgba(237,28,36,0.18)] hover:-translate-y-2 transition-all duration-300 border border-white/90 space-y-4 text-left glass-card">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/15 to-red-500/8 text-brand-600 flex items-center justify-center font-black text-base border border-brand-100">
          02
        </div>
        <div class="space-y-1.5">
          <h3 class="text-sm font-black text-slate-900 font-display">Manufacturer Warranty Support</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            In the event of a manufacturing defect, tyres and tools qualify for official factory warranty claim and replacement.
          </p>
        </div>
      </div>

      <div class="reveal-scale p-8 rounded-3xl bg-white/80 backdrop-blur-2xl shadow-[0_12px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_48px_rgba(59,130,246,0.18)] hover:-translate-y-2 transition-all duration-300 border border-white/90 space-y-4 text-left glass-card">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500/15 to-indigo-500/8 text-blue-600 flex items-center justify-center font-black text-base border border-blue-100">
          03
        </div>
        <div class="space-y-1.5">
          <h3 class="text-sm font-black text-slate-900 font-display">Direct WhatsApp Claim Desk</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Zero complicated paperwork. Simply message our dedicated Horana technician desk with your serial number for instant support.
          </p>
        </div>
      </div>

    </div>

  </div>
</Layout>
