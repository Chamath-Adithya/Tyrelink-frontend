---
import StoreLayout from '../layouts/StoreLayout.astro';
---
<StoreLayout title="Warranty Check | Tyrelink"><section class="utility wrap"><p class="eyebrow">Customer support</p><h1>Check your warranty.</h1><p>Enter your invoice number and our team will confirm the warranty record.</p><form><label for="invoice">Invoice number</label><input id="invoice" placeholder="e.g. TL-2026-0001" /><button type="button">Check warranty</button></form><small>Demo portal for the initial release. Records will be connected after the warranty database is configured.</small></section></StoreLayout>
<style>.utility{padding:90px 0;max-width:650px}.eyebrow{color:#ed1c24;text-transform:uppercase;letter-spacing:2px;font-size:10px;font-weight:800}.utility h1{font-size:56px;letter-spacing:-3px;margin:10px 0}.utility p{color:#666;line-height:1.6}.utility form{background:#fff;padding:25px;margin:30px 0;display:grid;gap:10px}.utility label{font-size:12px;font-weight:800}.utility input{padding:14px;border:1px solid #ddd;font:inherit}.utility button{background:#ed1c24;color:#fff;border:0;padding:14px;font-weight:800}.utility small{color:#888}
</style>
