---
import Layout from '../layouts/Layout.astro';
const mapsSearch = 'https://www.google.com/maps/search/?api=1&query=Tyrelink+Walasmulla+Sri+Lanka';
const breadcrumbs = [{ name: 'Home', item: 'https://tyrelink.lk/' }, { name: 'Contact', item: 'https://tyrelink.lk/contact' }];
---
<Layout title="Contact TyreLink | Visit us in Walasmulla" description="Contact TyreLink in Walasmulla for tyre advice, product availability and delivery enquiries. Call 071 250 0420 or speak with our team on WhatsApp." breadcrumbs={breadcrumbs}>
  <div class="tl-container">
    <section class="tl-section tl-split">
      <div><p class="tl-eyebrow">A little help goes a long way</p><h1 class="tl-title">Let’s get you<br />on your way.</h1><p class="tl-copy">Not sure which tyre fits? Looking for something for your workshop? Speak with our team. We will help you take the next step.</p><div class="contact-actions"><a class="tl-button" href="https://wa.me/94712500420" target="_blank" rel="noopener noreferrer">Chat on WhatsApp ↗</a><a class="tl-button-secondary" href="tel:+94712500420">Call our team</a></div></div>
      <div class="tl-panel contact-details"><p class="tl-eyebrow">Visit TyreLink</p><h2>Walasmulla,<br />Sri Lanka.</h2><address>No. 69A, Thalahagamwaduwa,<br />Beliatta Road, Walasmulla 82450,<br />Sri Lanka</address><dl><div><dt>Opening hours</dt><dd>Daily · 8:00 am–5:00 pm</dd></div><div><dt>Telephone</dt><dd><a href="tel:+94712500420">071 250 0420</a><br /><a href="tel:+94472245600">047 224 5600</a></dd></div><div><dt>Email</dt><dd><a href="mailto:tyrelinkcin@gmail.com">tyrelinkcin@gmail.com</a></dd></div></dl></div>
    </section>
    <section class="tl-section tl-split contact-rule">
      <div class="tl-panel map-placeholder"><svg viewBox="0 0 600 280" fill="none" aria-hidden="true"><path d="M0 70H600M0 190H600M140 0V280M430 0V280M0 280L600 0" stroke="currentColor" stroke-width="2"/><path d="M300 80a37 37 0 0 0-37 37c0 30 37 65 37 65s37-35 37-65a37 37 0 0 0-37-37Z" fill="var(--tl-canvas,#f6f3ec)" stroke="currentColor" stroke-width="3"/><circle cx="300" cy="117" r="11" stroke="currentColor" stroke-width="3"/></svg><p class="tl-eyebrow">Find your way here</p><h2>We look forward<br />to seeing you.</h2><a class="tl-button-secondary" href={mapsSearch} target="_blank" rel="noopener noreferrer">Search on Google Maps ↗</a><p class="map-note">This opens a general Maps search. Our verified store pin will be added soon; call us to confirm directions.</p></div>
      <div class="contact-details"><p class="tl-eyebrow">Before you get in touch</p><h2>A few details help us<br />help you faster.</h2><ul><li>Your vehicle make, model and year.</li><li>The tyre size printed on the sidewall, or a clear photo.</li><li>The product and quantity you need.</li><li>Your town for collection or delivery advice.</li></ul><div class="review-note"><p class="tl-eyebrow">Customer experiences</p><h3>Your feedback matters.</h3><p class="tl-copy">Our Google review link and verified customer reviews will appear here once our business profile is connected. For now, share feedback directly with our team.</p><a href="mailto:tyrelinkcin@gmail.com" class="tl-button-secondary">Share your feedback ↗</a></div></div>
    </section>
  </div>
</Layout>
<style>
.contact-actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:2rem}.contact-details h2,.map-placeholder h2{font-size:clamp(2rem,4vw,3.2rem);line-height:1.1;margin:1rem 0 2rem}.contact-details address{font-style:normal;line-height:1.8}.contact-details dl{margin-top:2rem}.contact-details dl>div{display:grid;grid-template-columns:1fr 1.5fr;gap:1rem;padding:1.25rem 0;border-top:1px solid var(--tl-line,#ddd9d0)}dt{opacity:.65}dd{margin:0;overflow-wrap:anywhere}.contact-rule{border-top:1px solid var(--tl-line,#ddd9d0)}.map-placeholder{overflow:hidden}.map-placeholder svg{width:100%;opacity:.5}.map-note{font-size:.8rem;line-height:1.6;max-width:40ch;margin-top:1.5rem;opacity:.65}.contact-details ul{list-style:disc;padding-left:1.2rem;line-height:2}.review-note{margin-top:3rem;padding-top:2rem;border-top:1px solid var(--tl-line,#ddd9d0)}.review-note h3{font-size:1.6rem;margin-bottom:1rem}.review-note .tl-button-secondary{margin-top:1.5rem}
</style>
