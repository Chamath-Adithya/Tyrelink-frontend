---
import StoreLayout from '../layouts/StoreLayout.astro';
---
<StoreLayout title="Contact Tyrelink | Tyrelink"><section class="utility wrap"><p class="eyebrow">Contact</p><h1>Need a tyre answer?</h1><p>Send your vehicle, tyre size, location and preferred product. Our WhatsApp team is available 24 hours.</p><a class="order" href="https://wa.me/94783724920?text=Hello%20Tyrelink%2C%20I%20need%20help%20choosing%20a%20tyre.">WhatsApp 078 372 4920 ↗</a></section></StoreLayout>
<style>.utility{padding:90px 0;max-width:680px}.eyebrow{color:#ed1c24;text-transform:uppercase;letter-spacing:2px;font-size:10px;font-weight:800}.utility h1{font-size:58px;letter-spacing:-3px}.utility p{color:#666;line-height:1.7}.order{display:inline-block;background:#25d366;color:#fff;padding:16px 20px;font-weight:800;font-size:13px}@media(max-width:760px){.utility{padding:50px 0}.utility h1{font-size:42px}}
</style>
