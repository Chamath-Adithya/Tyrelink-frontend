---
import Layout from '../layouts/Layout.astro';
import OrderTracker from '../components/OrderTracker';

const breadcrumbs = [
  { name: 'Home', item: 'https://tyrelink.lk/' },
  { name: 'Track Order', item: 'https://tyrelink.lk/track-order' }
];
---

<Layout
  title="Track Courier Delivery Status | Tyrelink Sri Lanka"
  description="Live tracking for your Tyrelink islandwide Cash on Delivery parcel using your official tracking ID."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10 pb-20 space-y-10 sm:space-y-12 text-center">
    
    <!-- Hero Header -->
    <div class="space-y-4 max-w-xl mx-auto reveal">
      <div class="section-badge mx-auto w-fit">
        <span>🚚</span>
        Islandwide Express Tracking
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 font-display tracking-tight leading-tight">
        Track Your Courier Delivery
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 font-sinhala leading-6 sm:leading-7 pt-1">
        ඇණවුම දැමූ පසු ඔබගේ WhatsApp / SMS වෙත ලැබුණු නිල Tracking Reference ID අංකය ඇතුළත් කර පාර්සලය පවතින ස්ථානය සොයාගන්න.
      </p>
    </div>

    <!-- React Island for Order Tracking -->
    <div class="reveal-scale">
      <OrderTracker client:load />
    </div>

    <!-- Delivery FAQ & Guidelines Card -->
    <div class="reveal bg-white/80 backdrop-blur-2xl rounded-3xl p-7 sm:p-10 shadow-[0_12px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_48px_rgba(237,28,36,0.15)] transition-all duration-300 text-xs text-slate-600 space-y-4 text-left max-w-2xl mx-auto border border-white/90 glass-card">
      <h3 class="text-sm font-black uppercase tracking-wider text-slate-900 font-display flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
        Delivery Timeframes & Courier Guidelines
      </h3>
      <div class="space-y-3 text-slate-500 leading-relaxed">
        <p class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-full bg-brand-50 text-brand-600 font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">W</span>
          <span><b class="text-slate-700">Western Province (Colombo, Gampaha, Kalutara):</b> 1-2 Business Days.</span>
        </p>
        <p class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-full bg-slate-100 text-slate-600 font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">I</span>
          <span><b class="text-slate-700">Outstation & Islandwide Districts:</b> 2-3 Business Days.</span>
        </p>
        <p class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">!</span>
          <span>Our courier rider will contact your mobile number prior to doorstep delivery. Please ensure your phone is reachable!</span>
        </p>
      </div>
    </div>

  </div>
</Layout>
