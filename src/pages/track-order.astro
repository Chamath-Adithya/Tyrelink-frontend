---
import StoreLayout from '../layouts/StoreLayout.astro';
---
<StoreLayout title="Track Order | Tyrelink"><section class="utility wrap"><p class="eyebrow">Customer support</p><h1>Track your order.</h1><p>Use your Tyrelink reference number to request an update from our 24-hour WhatsApp team.</p><a class="order" href="https://wa.me/94783724920?text=Hello%20Tyrelink%2C%20I%20want%20to%20track%20my%20order.">Track on WhatsApp ↗</a></section></StoreLayout>
<style>.utility{padding:90px 0;max-width:650px}.eyebrow{color:#ed1c24;text-transform:uppercase;letter-spacing:2px;font-size:10px;font-weight:800}.utility h1{font-size:56px;letter-spacing:-3px}.utility p{color:#666;line-height:1.6}.order{display:inline-block;background:#25d366;color:#fff;padding:16px 20px;font-weight:800;font-size:13px}
</style>
