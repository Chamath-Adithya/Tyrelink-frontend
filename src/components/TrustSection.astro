---
---

<section class="py-20 relative overflow-hidden reveal">
  <!-- Deep dark premium background -->
  <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950"></div>
  <!-- Texture overlay -->
  <div class="absolute inset-0 tech-dot-grid-dark opacity-40"></div>
  <!-- Radial glow top -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[60%] h-[1px] bg-gradient-to-r from-transparent via-brand-500/40 to-transparent"></div>
  <!-- Orange radial glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-brand-500/8 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section heading -->
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/8 border border-white/10 text-[11px] font-bold uppercase tracking-wider text-brand-400 backdrop-blur-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
        The Tyrelink Commitment
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white font-display tracking-tight">
        The Right Tyre. <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-red-400">Fit It With Confidence.</span>
      </h2>
      <p class="text-xs text-slate-400 font-sinhala">
        නිරවද්‍ය ටයර් තේරීම, සත්‍ය සමාගම් වගකීම සහ දිවයින පුරා බෙදාහැරීමේ විශ්වාසය
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 stagger-children">
      
      <!-- Feature 1: Genuine Tech -->
      <div class="trust-card reveal-3d p-7 rounded-2xl bg-white/[0.04] border border-white/[0.08] backdrop-blur-sm hover:bg-white/[0.07] hover:border-white/[0.14]" data-delay="0">
        <!-- Icon -->
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500/20 to-teal-500/10 border border-emerald-500/20 flex items-center justify-center mb-5 text-emerald-400 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <div class="space-y-1 mb-3">
          <h3 class="text-sm font-bold text-white">Verified Tyres & Equipment</h3>
          <p class="text-[11px] text-slate-400 font-sinhala">සත්‍ය සමාගම් වගකීම</p>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">Directly sourced and quality tested prior to dispatch with official warranty coverage.</p>
        <!-- Glow dot -->
        <div class="mt-5 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider">100% Verified</span>
        </div>
      </div>

      <!-- Feature 2: Islandwide -->
      <div class="trust-card reveal-3d p-7 rounded-2xl bg-white/[0.04] border border-white/[0.08] backdrop-blur-sm hover:bg-white/[0.07] hover:border-white/[0.14]" data-delay="80">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-600/10 border border-brand-500/20 flex items-center justify-center mb-5 text-brand-400">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
          </svg>
        </div>
        <div class="space-y-1 mb-3">
          <h3 class="text-sm font-bold text-white">Islandwide Dispatch</h3>
          <p class="text-[11px] text-slate-400 font-sinhala">දිවයින පුරා බෙදාහැරීම</p>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">Fast doorstep delivery within 1-3 working days across all 25 districts in Sri Lanka.</p>
        <div class="mt-5 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
          <span class="text-[10px] text-brand-400 font-bold uppercase tracking-wider">All 25 Districts</span>
        </div>
      </div>

      <!-- Feature 3: Cash on Delivery -->
      <div class="trust-card reveal-3d p-7 rounded-2xl bg-white/[0.04] border border-white/[0.08] backdrop-blur-sm hover:bg-white/[0.07] hover:border-white/[0.14]" data-delay="160">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-slate-700/40 to-slate-900/20 border border-slate-600/40 flex items-center justify-center mb-5 text-slate-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <div class="space-y-1 mb-3">
          <h3 class="text-sm font-bold text-white">Cash on Delivery</h3>
          <p class="text-[11px] text-slate-400 font-sinhala">භාණ්ඩය ලැබුණු පසු මුදල් ගෙවන්න</p>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">Inspect your parcel upon arrival before completing payment safely with the courier.</p>
        <div class="mt-5 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-300 animate-pulse"></span>
          <span class="text-[10px] text-slate-300 font-bold uppercase tracking-wider">Zero Risk</span>
        </div>
      </div>

      <!-- Feature 4: WhatsApp -->
      <div class="trust-card reveal-3d p-7 rounded-2xl bg-white/[0.04] border border-white/[0.08] backdrop-blur-sm hover:bg-white/[0.07] hover:border-white/[0.14]" data-delay="240">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-whatsapp/20 to-emerald-500/10 border border-whatsapp/20 flex items-center justify-center mb-5">
          <svg class="w-6 h-6 fill-current text-[#25D366]" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        </div>
        <div class="space-y-1 mb-3">
          <h3 class="text-sm font-bold text-white">WhatsApp Fitment Concierge</h3>
          <p class="text-[11px] text-slate-400 font-sinhala">ක්ෂණික ටයර් සහ ගැළපුම් සහය</p>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">Instant tyre fitment advice, tyre size verification, and direct order confirmation on WhatsApp.</p>
        <div class="mt-5 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#25D366] animate-pulse"></span>
          <span class="text-[10px] text-[#25D366] font-bold uppercase tracking-wider">Always Online</span>
        </div>
      </div>

    </div>

    <!-- Bottom stat strip with Realtime Number Rollup Engine -->
    <div class="mt-12 pt-10 border-t border-white/[0.07] grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
      <div class="reveal-scale space-y-1" data-delay="0">
        <div class="text-2xl sm:text-3xl font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-rose-400">
          <span data-counter="2500" data-suffix="+">2,500+</span>
        </div>
        <div class="text-xs font-bold text-white">Happy Customers</div>
        <div class="text-[10px] text-slate-500 font-sinhala">සතුටු ගනුදෙනුකරුවන්</div>
      </div>

      <div class="reveal-scale space-y-1" data-delay="100">
        <div class="text-2xl sm:text-3xl font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-rose-400">
          <span data-counter="25" data-suffix="">25</span>
        </div>
        <div class="text-xs font-bold text-white">Districts Covered</div>
        <div class="text-[10px] text-slate-500 font-sinhala">දිස්ත්‍රික්ක 25ම ආවරණය</div>
      </div>

      <div class="reveal-scale space-y-1" data-delay="200">
        <div class="text-2xl sm:text-3xl font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-rose-400">
          1-3 Days
        </div>
        <div class="text-xs font-bold text-white">Delivery Speed</div>
        <div class="text-[10px] text-slate-500 font-sinhala">ඉක්මන් බෙදාහැරීම</div>
      </div>

      <div class="reveal-scale space-y-1" data-delay="300">
        <div class="text-2xl sm:text-3xl font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-rose-400">
          <span data-counter="4.9" data-suffix=" ★">4.9 ★</span>
        </div>
        <div class="text-xs font-bold text-white">Customer Rating</div>
        <div class="text-[10px] text-slate-500 font-sinhala">ගනුදෙනුකරු ඇගයීම</div>
      </div>
    </div>

  </div>
</section>
