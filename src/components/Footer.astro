---
import categories from '../data/categories.json';
---

<footer id="site-footer" class="bg-neutral-950 text-neutral-400 pt-16 pb-28 sm:pb-14 border-t border-neutral-800">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-neutral-800 text-left">
      
      <!-- Brand & Info Column -->
      <div class="lg:col-span-2 space-y-4">
        <!-- Official Brand Logo (Exact official white Tyrelink logo for dark footer) -->
        <a href="/" class="flex items-center gap-2 py-1" aria-label="Tyrelink Home">
          <img 
            src="/branding/tyrelink-logo-white.png" 
            alt="Tyrelink Official Logo" 
            class="h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-102"
            loading="lazy"
          />
        </a>
        
        <p class="text-xs text-neutral-400 max-w-sm leading-relaxed">
          Sri Lanka's trusted partner to find, compare and buy tyres, wheels, and garage workshop equipment with islandwide delivery, verified manufacture dates, and 1-Click WhatsApp fitment guidance.
        </p>

        <div class="pt-2 space-y-2.5 text-xs text-neutral-400 font-medium">
          <p class="flex items-center gap-2">
            <span>Islandwide Delivery & Partner Fitting Network, Sri Lanka</span>
          </p>
          <p class="flex items-center gap-2">
            <a href="https://wa.me/94712500420" class="text-emerald-400 hover:text-emerald-300 font-mono transition-colors">
              WhatsApp: 071 250 0420 (+94 71 250 0420)
            </a>
          </p>

          {/* Social Media Channels (YouTube, Facebook, TikTok) */}
          <div class="pt-2 flex items-center gap-2.5">
            {/* YouTube */}
            <a
              href="https://youtube.com/@tyrelinklk"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Tyrelink YouTube Channel"
              class="w-9 h-9 rounded-xl bg-neutral-900/90 border border-neutral-800 text-neutral-400 hover:text-red-500 hover:border-red-500/30 hover:bg-red-500/10 flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xs"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            {/* Facebook */}
            <a
              href="https://facebook.com/tyrelinklk"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Tyrelink Facebook Page"
              class="w-9 h-9 rounded-xl bg-neutral-900/90 border border-neutral-800 text-neutral-400 hover:text-brand-400 hover:border-brand-500/30 hover:bg-brand-500/10 flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xs"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>

            {/* TikTok */}
            <a
              href="https://tiktok.com/@tyrelinklk"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Tyrelink TikTok Profile"
              class="w-9 h-9 rounded-xl bg-neutral-900/90 border border-neutral-800 text-neutral-400 hover:text-brand-400 hover:border-brand-500/30 hover:bg-brand-500/10 flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xs"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.74 1.45-.04 2.76-.98 3.2-2.36.21-.57.26-1.19.26-1.81V.02z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-200 mb-4">
          Tyres & Equipment
        </h3>
        <ul class="space-y-2.5 text-xs">
          {categories.map((cat) => (
            <li>
              <a 
                href={`/category/${cat.id}`} 
                class="hover:text-white transition-colors text-neutral-400"
              >
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Portals -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-200 mb-4">
          Customer Care
        </h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="/faq" class="hover:text-white text-neutral-400 transition-colors">
              Frequently Asked Questions
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-white text-neutral-400 transition-colors">
              Support Desk
            </a>
          </li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-200 mb-4">
          Platform
        </h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="/about" class="hover:text-white text-neutral-400 transition-colors">
              About Tyrelink
            </a>
          </li>
          <li>
            <a href="/faq" class="hover:text-white text-neutral-400 transition-colors">
              Cash on Delivery Terms
            </a>
          </li>
          <li>
            <a href="/admin" class="hover:text-brand-400 text-neutral-500 transition-colors flex items-center gap-1 font-mono text-[11px]">
              <span>Merchant Terminal</span>
              <span class="text-[9px] px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-400 font-sans">Staff</span>
            </a>
          </li>
          <li>
            <a href="/llms.txt" class="hover:text-brand-400 text-neutral-500 font-mono transition-colors">
              AI Index (llms.txt)
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Animated Tyre & Garage Workshop Scene -->
    <div class="w-full overflow-hidden pt-2">
      <svg class="block w-full max-w-[1440px] mx-auto h-auto" viewBox="0 0 1440 300" role="img" aria-label="Animated tyre and garage tools workshop scene">
        <defs>
          <pattern id="footer-peg" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="7" cy="7" r="1.3" fill="#2a2a31"/></pattern>
          <linearGradient id="footer-cone" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd27a" stop-opacity=".32"/><stop offset="1" stop-color="#ffd27a" stop-opacity="0"/></linearGradient>
        </defs>

        <!-- pegboard with tools -->
        <rect x="70" y="70" width="250" height="180" rx="6" fill="#141418" stroke="#26262c"/>
        <rect x="70" y="70" width="250" height="180" rx="6" fill="url(#footer-peg)"/>
        <g stroke-linecap="round" fill="none">
          <g transform="translate(110 96)"><g class="ft-sway"><path d="M0 0V70" stroke="#a9a9b2" stroke-width="8"/><circle cx="0" cy="80" r="12" stroke="#a9a9b2" stroke-width="6"/><rect x="-3" y="66" width="6" height="12" fill="#141418" stroke="none"/></g></g>
          <g transform="translate(155 96)"><g class="ft-sway"><path d="M0 0V74" stroke="#e11d2a" stroke-width="7"/><circle cx="0" cy="-2" r="9" stroke="#e11d2a" stroke-width="5"/><circle cx="0" cy="82" r="9" stroke="#e11d2a" stroke-width="5"/></g></g>
          <g transform="translate(205 96)"><g class="ft-sway"><path d="M0 0V70" stroke="#7a5a3a" stroke-width="6"/><rect x="-18" y="-8" width="36" height="16" rx="3" fill="#a9a9b2" stroke="none"/></g></g>
          <g transform="translate(250 96)"><g class="ft-sway"><path d="M-9 0L-2 56M9 0L2 56" stroke="#e11d2a" stroke-width="6"/><path d="M-3 56L-1 72M3 56L1 72" stroke="#a9a9b2" stroke-width="5"/></g></g>
          <g transform="translate(290 96)"><g class="ft-sway"><rect x="-6" y="-8" width="12" height="30" rx="4" fill="#e11d2a" stroke="none"/><path d="M0 22V74" stroke="#a9a9b2" stroke-width="4"/></g></g>
        </g>
        <rect x="85" y="214" width="220" height="6" rx="3" fill="#26262c"/>

        <!-- ceiling lamps -->
        <g transform="translate(450 0)"><g class="ft-lamp" style="transform-origin:0 0"><path d="M0 0V58" stroke="#3a3a42" stroke-width="3"/><path d="M-22 84L-10 58H10L22 84Z" fill="#b3121c"/><polygon points="-18,86 18,86 70,262 -70,262" fill="url(#footer-cone)"/></g></g>
        <g transform="translate(975 0)"><g class="ft-lamp ft-lamp-b" style="transform-origin:0 0"><path d="M0 0V50" stroke="#3a3a42" stroke-width="3"/><path d="M-22 76L-10 50H10L22 76Z" fill="#b3121c"/><polygon points="-18,78 18,78 70,160 -70,160" fill="url(#footer-cone)"/></g></g>

        <!-- tyre rack -->
        <g fill="#1c1c21"><rect x="350" y="140" width="8" height="130"/><rect x="562" y="140" width="8" height="130"/><rect x="350" y="200" width="220" height="6"/></g>
        <g>
          <g transform="translate(386 172)"><circle r="28" fill="#0e0e10" stroke="#2c2c33" stroke-width="2"/><circle r="22" fill="none" stroke="#e11d2a" stroke-opacity=".6"/><circle r="14" fill="#1a1a1f" stroke="#c9c9cf" stroke-width="1.5"/><circle r="4" fill="#c9c9cf"/></g>
          <g transform="translate(456 172)"><circle r="28" fill="#0e0e10" stroke="#2c2c33" stroke-width="2"/><circle r="22" fill="none" stroke="#e11d2a" stroke-opacity=".6"/><g class="ft-slow ft-fb"><circle r="14" fill="#1a1a1f" stroke="#c9c9cf" stroke-width="1.5"/><path d="M0-14V14M-14 0H14" stroke="#c9c9cf"/></g></g>
          <g transform="translate(526 172)"><circle r="28" fill="#0e0e10" stroke="#2c2c33" stroke-width="2"/><circle r="22" fill="none" stroke="#e11d2a" stroke-opacity=".6"/><circle r="14" fill="#1a1a1f" stroke="#c9c9cf" stroke-width="1.5"/><circle r="4" fill="#c9c9cf"/></g>
        </g>
        <g transform="translate(386 242)"><circle r="28" fill="#0e0e10" stroke="#2c2c33" stroke-width="2"/><circle r="22" fill="none" stroke="#e11d2a" stroke-opacity=".6"/><circle r="14" fill="#1a1a1f" stroke="#c9c9cf" stroke-width="1.5"/><circle r="4" fill="#c9c9cf"/></g>
        <g transform="translate(456 242)"><circle r="28" fill="#0e0e10" stroke="#2c2c33" stroke-width="2"/><circle r="22" fill="none" stroke="#e11d2a" stroke-opacity=".6"/><circle r="14" fill="#1a1a1f" stroke="#c9c9cf" stroke-width="1.5"/><circle r="4" fill="#c9c9cf"/></g>
        <g transform="translate(526 242)"><circle r="28" fill="#0e0e10" stroke="#2c2c33" stroke-width="2"/><circle r="22" fill="none" stroke="#e11d2a" stroke-opacity=".6"/><circle r="14" fill="#1a1a1f" stroke="#c9c9cf" stroke-width="1.5"/><circle r="4" fill="#c9c9cf"/></g>

        <!-- wheel balancer -->
        <rect x="640" y="168" width="62" height="102" rx="6" fill="#1c1c21" stroke="#2e2e35"/>
        <rect x="652" y="180" width="38" height="22" rx="3" fill="#0b0b0d"/><circle class="ft-blink" cx="662" cy="191" r="3.5" fill="#e11d2a"/><circle cx="676" cy="191" r="3.5" fill="#3a3a42"/>
        <path d="M702 222H770" stroke="#8d8d96" stroke-width="6"/>
        <g transform="translate(770 222)">
          <circle r="40" fill="#0e0e10" stroke="#2c2c33" stroke-width="2"/>
          <circle r="34" fill="none" stroke="#e11d2a" stroke-opacity=".5" stroke-dasharray="10 6"/>
          <g class="ft-spin ft-fb"><circle r="22" fill="#1a1a1f" stroke="#c9c9cf" stroke-width="2"/><path d="M0-22V22M-22 0H22M-15.5-15.5L15.5 15.5M-15.5 15.5L15.5-15.5" stroke="#c9c9cf" stroke-width="2"/></g>
          <circle r="5" fill="#e11d2a"/>
          <path d="M-48 0A48 48 0 0 1 48 0" fill="none" stroke="#3a3a42" stroke-width="3"/>
        </g>

        <!-- tool chest -->
        <rect x="916" y="158" width="118" height="9" rx="2" fill="#2a2a31"/>
        <path d="M940 158L1010 148" stroke="#a9a9b2" stroke-width="5" stroke-linecap="round"/><circle cx="1012" cy="147" r="6" fill="none" stroke="#a9a9b2" stroke-width="3"/>
        <rect x="920" y="167" width="110" height="98" rx="4" fill="#b3121c"/>
        <rect x="926" y="196" width="98" height="26" fill="#0b0b0d"/><path d="M934 214h36" stroke="#8d8d96" stroke-width="4" stroke-linecap="round"/><path d="M980 208l30 4" stroke="#e11d2a" stroke-width="4" stroke-linecap="round"/>
        <g class="ft-drawer"><rect x="926" y="196" width="98" height="26" rx="2" fill="#8c0f18" stroke="#e11d2a" stroke-opacity=".6"/><rect x="960" y="206" width="30" height="5" rx="2.5" fill="#d9d9de"/></g>
        <rect x="926" y="172" width="98" height="20" rx="2" fill="#8c0f18"/><rect x="960" y="180" width="30" height="5" rx="2.5" fill="#d9d9de"/>
        <rect x="926" y="228" width="98" height="30" rx="2" fill="#8c0f18"/><rect x="960" y="240" width="30" height="5" rx="2.5" fill="#d9d9de"/>
        <circle cx="932" cy="268" r="5" fill="#26262c"/><circle cx="1018" cy="268" r="5" fill="#26262c"/>

        <!-- small tyre stack -->
        <g transform="translate(1060 270)">
          <rect x="0" y="-15" width="56" height="15" rx="7" fill="#161619" stroke="#e11d2a" stroke-opacity=".6"/>
          <rect x="3" y="-30" width="50" height="15" rx="7" fill="#1d1d21" stroke="#e11d2a" stroke-opacity=".6"/>
          <rect x="0" y="-45" width="56" height="15" rx="7" fill="#161619" stroke="#e11d2a" stroke-opacity=".6"/>
          <rect x="3" y="-60" width="50" height="15" rx="7" fill="#1d1d21" stroke="#e11d2a" stroke-opacity=".6"/>
        </g>

        <!-- compressor + wheel with air gun -->
        <rect x="1200" y="256" width="8" height="14" fill="#26262c"/><rect x="1302" y="256" width="8" height="14" fill="#26262c"/>
        <rect x="1190" y="212" width="132" height="46" rx="23" fill="#b3121c"/>
        <rect x="1262" y="190" width="42" height="22" rx="3" fill="#3a3a42"/><rect x="1268" y="196" width="30" height="4" fill="#8d8d96"/>
        <circle cx="1230" cy="206" r="13" fill="#0b0b0d" stroke="#c9c9cf" stroke-width="2"/>
        <path class="ft-needle" d="M1230 206V196" stroke="#e11d2a" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="1230" cy="206" r="2.5" fill="#c9c9cf"/>
        <path class="ft-air" d="M1322 238C1350 250 1350 262 1366 252" fill="none" stroke="#e11d2a" stroke-width="3" stroke-linecap="round"/>
        <g transform="translate(1392 246)">
          <circle r="24" fill="#0e0e10" stroke="#2c2c33" stroke-width="2"/><circle r="19" fill="none" stroke="#e11d2a" stroke-opacity=".6"/>
          <g class="ft-slow ft-fb"><circle r="12" fill="#1a1a1f" stroke="#c9c9cf" stroke-width="1.5"/><path d="M0-12V12M-12 0H12" stroke="#c9c9cf"/></g>
          <g fill="#ffd27a"><rect class="ft-spark" x="-28" y="-6" width="5" height="2"/><rect class="ft-spark" x="-30" y="2" width="5" height="2"/><rect class="ft-spark" x="-26" y="-12" width="4" height="2"/></g>
        </g>

        <!-- floor dust -->
        <g fill="#fff" opacity=".35"><circle class="ft-dust" cx="320" cy="250" r="1.5"/><circle class="ft-dust" style="animation-delay:-2s" cx="840" cy="240" r="1.5"/><circle class="ft-dust" style="animation-delay:-3s" cx="1150" cy="245" r="1.5"/></g>

        <!-- floor -->
        <rect y="270" width="1440" height="30" fill="#121214"/>
        <rect y="270" width="1440" height="2" fill="#e11d2a" opacity=".7"/>
        <path d="M0 286H1440" stroke="#26262c" stroke-width="2" stroke-dasharray="30 22"/>
      </svg>
    </div>

    <!-- Bottom -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500">
      <p>
        © {new Date().getFullYear()} <span class="text-neutral-300 font-semibold">Tyrelink</span>. Tyre & Garage Equipment Store.
      </p>

      <div class="flex items-center gap-2 flex-wrap">
        <span class="px-2.5 py-1 rounded-md bg-neutral-900 border border-neutral-800 text-[10px] font-medium text-neutral-300">
          Cash on Delivery
        </span>
        <a href="https://paykoko.com/" target="_blank" rel="noopener noreferrer" class="px-2 py-1 rounded-md bg-neutral-900 border border-neutral-800 hover:border-neutral-700 text-[10px] font-medium text-neutral-300 inline-flex items-center gap-1.5 transition-colors" title="Koko Buy Now Pay Later">
          <img src="/images/payments/koko-logo.png" alt="Koko" class="h-3 object-contain brightness-95" />
          <span class="text-[9px] text-neutral-400">BNPL</span>
        </a>
        <a href="https://payzy.lk/" target="_blank" rel="noopener noreferrer" class="px-2 py-1 rounded-md bg-neutral-900 border border-neutral-800 hover:border-neutral-700 text-[10px] font-medium text-neutral-300 inline-flex items-center gap-1.5 transition-colors" title="PayZy Buy Now Pay Later">
          <img src="/images/payments/payzy-logo.png" alt="PayZy" class="h-2.5 object-contain brightness-95" />
          <span class="text-[9px] text-neutral-400">BNPL</span>
        </a>
        <span class="px-2.5 py-1 rounded-md bg-neutral-900 border border-neutral-800 text-[10px] font-medium text-emerald-400">
          WhatsApp Verified
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .ft-fb{transform-box:fill-box;transform-origin:center}
  .ft-sway{transform-box:fill-box;transform-origin:50% 0;animation:ft-sway 3.6s ease-in-out infinite alternate}
  .ft-sway:nth-child(2n){animation-duration:4.4s;animation-delay:-1s}
  .ft-sway:nth-child(3n){animation-duration:3.1s;animation-delay:-2s}
  @keyframes ft-sway{from{transform:rotate(-3.5deg)}to{transform:rotate(3.5deg)}}
  .ft-lamp{animation:ft-lamp 4.5s ease-in-out infinite alternate}
  .ft-lamp-b{animation-duration:5.5s;animation-delay:-2s}
  @keyframes ft-lamp{from{transform:rotate(-7deg)}to{transform:rotate(7deg)}}
  .ft-spin{animation:ft-spin .4s linear infinite}
  .ft-slow{animation:ft-spin 9s linear infinite}
  @keyframes ft-spin{to{transform:rotate(360deg)}}
  .ft-blink{animation:ft-blink 1s steps(1) infinite}
  @keyframes ft-blink{50%{opacity:.2}}
  .ft-drawer{animation:ft-drawer 6s ease-in-out infinite}
  @keyframes ft-drawer{0%,15%{transform:translateX(0)}35%,65%{transform:translateX(24px)}85%,100%{transform:translateX(0)}}
  .ft-needle{transform-origin:1230px 206px;animation:ft-needle 5s ease-in-out infinite alternate}
  @keyframes ft-needle{from{transform:rotate(-45deg)}to{transform:rotate(50deg)}}
  .ft-air{stroke-dasharray:6 10;animation:ft-air .6s linear infinite}
  @keyframes ft-air{to{stroke-dashoffset:-16}}
  .ft-spark{animation:ft-spark 1.1s linear infinite}
  .ft-spark:nth-child(2){animation-delay:.35s}
  .ft-spark:nth-child(3){animation-delay:.7s}
  @keyframes ft-spark{0%{opacity:0;transform:translate(0,0)}15%{opacity:1}100%{opacity:0;transform:translate(14px,-16px)}}
  .ft-dust{animation:ft-dust 5s ease-in-out infinite alternate}
  @keyframes ft-dust{to{transform:translateY(-10px);opacity:.15}}
  @media (prefers-reduced-motion:reduce){.ft-sway,.ft-lamp,.ft-spin,.ft-slow,.ft-blink,.ft-drawer,.ft-needle,.ft-air,.ft-spark,.ft-dust{animation:none!important}}
</style>
