---
import categories from '../data/categories.json';
---

<footer class="bg-neutral-950 text-neutral-400 pt-16 pb-28 sm:pb-14 border-t border-neutral-800">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-neutral-800 text-left">
      
      <!-- Brand & Info Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-1 py-1" aria-label="Tyrelink Home">
          <span class="text-[#ed1c24] text-2xl font-black tracking-[-8px] w-6 overflow-hidden inline-block transform -skew-x-[18deg] leading-none">›››</span>
          <span class="text-xl font-black tracking-tight text-white">TYRE<span class="text-[#ed1c24]">LINK</span></span>
        </a>

        <p class="font-sinhala text-xs text-neutral-300 font-semibold">
          ඔබේ ගමනට නිවැරදි ටයරය. Find the right tyre. Fit it with confidence.
        </p>
        
        <p class="text-xs text-neutral-400 max-w-sm leading-relaxed">
          Sri Lanka's trusted partner to find, compare and buy tyres, wheels, and garage workshop equipment with islandwide delivery, verified manufacture dates, and 1-Click WhatsApp fitment guidance.
        </p>

        <div class="pt-2 space-y-2.5 text-xs text-neutral-400 font-medium">
          <p class="flex items-center gap-2">
            <span>Islandwide Delivery & Partner Fitting Network, Sri Lanka</span>
          </p>
          <p class="flex items-center gap-2">
            <a href="https://wa.me/94783724920" class="text-emerald-400 hover:text-emerald-300 font-mono transition-colors">
              WhatsApp: 078 372 4920 (+94 78 372 4920)
            </a>
          </p>

          {/* Social Media Channels (YouTube, Facebook, TikTok) */}
          <div class="pt-2 flex items-center gap-2.5">
            {/* YouTube */}
            <a
              href="https://youtube.com/@tyrelinklk"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Tyrelink YouTube Channel"
              class="w-9 h-9 rounded-xl bg-neutral-900/90 border border-neutral-800 text-neutral-400 hover:text-red-500 hover:border-red-500/30 hover:bg-red-500/10 flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xs"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            {/* Facebook */}
            <a
              href="https://facebook.com/tyrelinklk"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Tyrelink Facebook Page"
              class="w-9 h-9 rounded-xl bg-neutral-900/90 border border-neutral-800 text-neutral-400 hover:text-blue-500 hover:border-blue-500/30 hover:bg-blue-500/10 flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xs"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>

            {/* TikTok */}
            <a
              href="https://tiktok.com/@tyrelinklk"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Tyrelink TikTok Profile"
              class="w-9 h-9 rounded-xl bg-neutral-900/90 border border-neutral-800 text-neutral-400 hover:text-cyan-400 hover:border-cyan-500/30 hover:bg-cyan-500/10 flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-2xs"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.74 1.45-.04 2.76-.98 3.2-2.36.21-.57.26-1.19.26-1.81V.02z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-200 mb-4">
          Tyres & Equipment
        </h3>
        <ul class="space-y-2.5 text-xs">
          {categories.map((cat) => (
            <li>
              <a 
                href={`/category/${cat.id}`} 
                class="hover:text-white transition-colors text-neutral-400"
              >
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Portals -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-200 mb-4">
          Verification
        </h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="/warranty-check" class="hover:text-white transition-colors text-emerald-400 font-medium">
              Warranty Verification
            </a>
          </li>
          <li>
            <a href="/track-order" class="hover:text-white transition-colors text-brand-400 font-medium">
              Track Courier Delivery
            </a>
          </li>
          <li>
            <a href="/warranty-policy" class="hover:text-white text-neutral-400 transition-colors">
              Warranty Terms
            </a>
          </li>
          <li>
            <a href="/faq" class="hover:text-white text-neutral-400 transition-colors">
              Frequently Asked Questions
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-white text-neutral-400 transition-colors">
              Support Desk
            </a>
          </li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-200 mb-4">
          Platform
        </h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="/about" class="hover:text-white text-neutral-400 transition-colors">
              About Tyrelink
            </a>
          </li>
          <li>
            <a href="/faq" class="hover:text-white text-neutral-400 transition-colors">
              Cash on Delivery Terms
            </a>
          </li>
          <li>
            <a href="/admin" class="hover:text-brand-400 text-neutral-500 transition-colors flex items-center gap-1 font-mono text-[11px]">
              <span>Merchant Terminal</span>
              <span class="text-[9px] px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-400 font-sans">Staff</span>
            </a>
          </li>
          <li>
            <a href="/llms.txt" class="hover:text-brand-400 text-neutral-500 font-mono transition-colors">
              AI Index (llms.txt)
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500">
      <p>
        © {new Date().getFullYear()} <span class="text-neutral-300 font-semibold">Tyrelink</span>. Tyre & Garage Equipment Store.
      </p>

      <div class="flex items-center gap-2 flex-wrap">
        <span class="px-2.5 py-1 rounded-md bg-neutral-900 border border-neutral-800 text-[10px] font-medium text-neutral-300">
          Cash on Delivery
        </span>
        <a href="https://paykoko.com/" target="_blank" rel="noopener noreferrer" class="px-2 py-1 rounded-md bg-neutral-900 border border-neutral-800 hover:border-neutral-700 text-[10px] font-medium text-neutral-300 inline-flex items-center gap-1.5 transition-colors" title="Koko Buy Now Pay Later">
          <img src="/images/payments/koko-logo.png" alt="Koko" class="h-3 object-contain brightness-95" />
          <span class="text-[9px] text-neutral-400">BNPL</span>
        </a>
        <a href="https://payzy.lk/" target="_blank" rel="noopener noreferrer" class="px-2 py-1 rounded-md bg-neutral-900 border border-neutral-800 hover:border-neutral-700 text-[10px] font-medium text-neutral-300 inline-flex items-center gap-1.5 transition-colors" title="PayZy Buy Now Pay Later">
          <img src="/images/payments/payzy-logo.png" alt="PayZy" class="h-2.5 object-contain brightness-95" />
          <span class="text-[9px] text-neutral-400">BNPL</span>
        </a>
        <span class="px-2.5 py-1 rounded-md bg-neutral-900 border border-neutral-800 text-[10px] font-medium text-emerald-400">
          WhatsApp Verified
        </span>
      </div>
    </div>
  </div>
</footer>
