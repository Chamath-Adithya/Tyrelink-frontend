---
---

<section class="w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 reveal" id="catalog">
  <!-- Section Heading -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 text-left border-b border-slate-200/80 pb-5">
    <div>
      <p class="text-[10px] font-black uppercase tracking-widest text-[#ed1c24] mb-1">
        Shop with clarity
      </p>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-display tracking-tight">
        Good. Better. Best.<br />
        <span class="text-slate-400">Always the right fit for your budget.</span>
      </h2>
    </div>
    <p class="text-xs sm:text-sm text-slate-500 font-medium max-w-sm">
      Every option comes with transparent specs, verified manufacture dates, and a price you can understand.
    </p>
  </div>

  <!-- 3 Tier Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    
    <!-- Tier 1: VALUE -->
    <article class="bg-[#e9e9e5] p-8 rounded-2xl flex flex-col justify-between min-h-[300px] text-left border border-slate-300/60 hover:shadow-lg transition-all duration-300 relative group">
      <div>
        <span class="choice-tag value block mb-3 text-slate-500">VALUE</span>
        <h3 class="text-2xl font-black text-slate-900 font-display tracking-tight leading-tight mb-2">
          Reliable everyday performance
        </h3>
        <p class="text-xs text-slate-600 leading-relaxed mb-4">
          Smart choices for daily city rides, commercial three-wheelers, and high-mileage commuting where durability and economy matter most.
        </p>
        <div class="space-y-1 text-[11px] font-mono text-slate-500">
          <p>✓ High mileage compounds</p>
          <p>✓ CEAT Milaze, DSI, Linglong</p>
          <p>✓ Best cost-per-kilometer</p>
        </div>
      </div>
      <div class="pt-6 border-t border-slate-300/50 mt-4">
        <a href="/shop?brand=CEAT#catalog-products" class="text-xs font-black text-slate-900 group-hover:text-[#ed1c24] flex items-center justify-between transition-colors">
          <span>Explore value tyres</span>
          <span>→</span>
        </a>
      </div>
    </article>

    <!-- Tier 2: BALANCED (Featured Dark Card with Racing Red Accent) -->
    <article class="bg-[#111111] text-white p-8 rounded-2xl flex flex-col justify-between min-h-[300px] text-left border-2 border-[#ed1c24] shadow-[0_16px_40px_rgba(237,28,36,0.22)] transition-all duration-300 relative group transform md:-translate-y-1">
      <!-- Popular Ribbon -->
      <div class="absolute -top-3 right-6 bg-[#ed1c24] text-white text-[9px] font-black uppercase tracking-widest px-3 py-1 rounded-full shadow-md">
        Most Popular Pick
      </div>

      <div>
        <span class="choice-tag balanced block mb-3 text-[#ed1c24]">BALANCED</span>
        <h3 class="text-2xl font-black text-white font-display tracking-tight leading-tight mb-2">
          Comfort for every journey
        </h3>
        <p class="text-xs text-slate-300 leading-relaxed mb-4">
          Our most recommended mix of refined ride comfort, low cabin road noise, responsive wet grip, and proven tread life on Sri Lankan roads.
        </p>
        <div class="space-y-1 text-[11px] font-mono text-slate-400">
          <p>✓ Quiet highway cruising & low rolling resistance</p>
          <p>✓ DSI S-Drive, Dunlop SP Touring, Yokohama</p>
          <p>✓ Superb wet braking safety</p>
        </div>
      </div>
      <div class="pt-6 border-t border-slate-800 mt-4">
        <a href="/shop?brand=DUNLOP#catalog-products" class="text-xs font-black text-[#ed1c24] hover:text-white flex items-center justify-between transition-colors">
          <span>Explore balanced tyres</span>
          <span>→</span>
        </a>
      </div>
    </article>

    <!-- Tier 3: PREMIUM -->
    <article class="bg-[#e9e9e5] p-8 rounded-2xl flex flex-col justify-between min-h-[300px] text-left border border-slate-300/60 hover:shadow-lg transition-all duration-300 relative group">
      <div>
        <span class="choice-tag premium block mb-3 text-slate-700">PREMIUM</span>
        <h3 class="text-2xl font-black text-slate-900 font-display tracking-tight leading-tight mb-2">
          Performance without compromise
        </h3>
        <p class="text-xs text-slate-600 leading-relaxed mb-4">
          For drivers who demand precision cornering, exceptional monsoon wet grip, shorter braking distances, and prestige engineering.
        </p>
        <div class="space-y-1 text-[11px] font-mono text-slate-500">
          <p>✓ Maximum high-speed stability</p>
          <p>✓ Michelin Primacy / Pilot Sport, Pirelli, Bridgestone</p>
          <p>✓ Premium vehicle OEM specifications</p>
        </div>
      </div>
      <div class="pt-6 border-t border-slate-300/50 mt-4">
        <a href="/shop?brand=MICHELIN#catalog-products" class="text-xs font-black text-slate-900 group-hover:text-[#ed1c24] flex items-center justify-between transition-colors">
          <span>Explore premium tyres</span>
          <span>→</span>
        </a>
      </div>
    </article>

  </div>
</section>

