---
// Tyrelink Animated Background — Flowing Tread Waves with Brand Red Accents
// Pure Canvas 2D · Matte · Mouse-reactive · Scroll-parallax
---

<div
  id="bg-canvas-wrap"
  class="fixed inset-0 pointer-events-none -z-10 overflow-hidden select-none"
  aria-hidden="true"
>
  <canvas id="bg-canvas" class="w-full h-full block"></canvas>
</div>

<script>
  (function initAnimatedBackground() {
    const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0;
    let H = 0;
    let dpr = 1;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth;
      H = window.innerHeight;
      canvas!.width = W * dpr;
      canvas!.height = H * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();

    let resizeTimer: ReturnType<typeof setTimeout> | null = null;
    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 120);
    }, { passive: true });

    // ── Mouse ──
    let mouseX = W * 0.5, mouseY = H * 0.5;
    let tMX = mouseX, tMY = mouseY;
    window.addEventListener('pointermove', (e) => { tMX = e.clientX; tMY = e.clientY; }, { passive: true });

    // ── Scroll ──
    let scrollY = 0, tScrollY = 0;
    window.addEventListener('scroll', () => { tScrollY = window.scrollY; }, { passive: true });

    // ── Visibility ──
    let visible = !document.hidden;
    document.addEventListener('visibilitychange', () => { visible = !document.hidden; });

    // ═══════════════════════════════════════════
    //  CONFIG
    // ═══════════════════════════════════════════
    const WAVE_GROUPS = [
      // Group 1: Wide, slow-moving tread grooves (slate)
      { count: 7, speed: 0.25, ampBase: 22, freq: 3.5, lineWidth: 1.8,
        color: (a: number) => `rgba(100,116,139,${a})`, alphaBase: 0.06 },
      // Group 2: Fine detail lines (slate, thinner)
      { count: 9, speed: 0.4,  ampBase: 14, freq: 6.0, lineWidth: 1,
        color: (a: number) => `rgba(148,163,184,${a})`, alphaBase: 0.04 },
      // Group 3: Brand red accent sweeps (sparse, elegant)
      { count: 4, speed: 0.18, ampBase: 30, freq: 2.2, lineWidth: 2,
        color: (a: number) => `rgba(237,28,36,${a})`, alphaBase: 0.045 },
    ];

    const POINTS = 90;

    // Pre-seed each line for organic variation
    type LineSeed = { seed: number; yOffset: number; phaseShift: number; group: number };
    const lines: LineSeed[] = [];
    WAVE_GROUPS.forEach((g, gi) => {
      for (let i = 0; i < g.count; i++) {
        const t = i / (g.count - 1 || 1);
        lines.push({
          seed: Math.random() * 1000,
          yOffset: t,
          phaseShift: Math.random() * Math.PI * 2,
          group: gi,
        });
      }
    });

    // Floating accent particles (brand red micro-dots drifting)
    type Particle = { x: number; y: number; vx: number; vy: number; r: number; life: number; maxLife: number };
    const particles: Particle[] = [];
    const PARTICLE_COUNT = 24;
    function spawnParticle(): Particle {
      return {
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.2 - 0.1,
        r: 1 + Math.random() * 1.5,
        life: 0,
        maxLife: 400 + Math.random() * 600,
      };
    }
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const p = spawnParticle();
      p.life = Math.random() * p.maxLife; // stagger initial life
      particles.push(p);
    }

    // ═══════════════════════════════════════════
    //  DRAW LOOP
    // ═══════════════════════════════════════════
    let time = 0;
    let frameId = 0;

    function draw() {
      frameId = requestAnimationFrame(draw);
      if (!visible || !ctx) return;

      const dt = prefersReducedMotion ? 0 : 0.016;
      time += dt;

      // Smooth lerp
      mouseX += (tMX - mouseX) * 0.05;
      mouseY += (tMY - mouseY) * 0.05;
      scrollY += (tScrollY - scrollY) * 0.07;

      const mx = mouseX / W;   // 0–1 normalized

      ctx.clearRect(0, 0, W, H);

      // ── 1. Draw subtle radial gradient wash that follows mouse ──
      const gx = mouseX;
      const gy = mouseY;
      const gradRadius = Math.max(W, H) * 0.55;
      const radGrad = ctx.createRadialGradient(gx, gy, 0, gx, gy, gradRadius);
      radGrad.addColorStop(0, 'rgba(237, 28, 36, 0.018)');
      radGrad.addColorStop(0.4, 'rgba(237, 28, 36, 0.006)');
      radGrad.addColorStop(1, 'rgba(237, 28, 36, 0)');
      ctx.fillStyle = radGrad;
      ctx.fillRect(0, 0, W, H);

      // ── 2. Flowing wave lines ──
      for (const line of lines) {
        const g = WAVE_GROUPS[line.group];
        const baseY = H * 0.04 + line.yOffset * H * 0.92;
        const scrollShift = Math.sin(line.yOffset * Math.PI + scrollY * 0.0012) * 14;
        const tiltShift = (mx - 0.5) * 10 * Math.sin(line.yOffset * Math.PI * 2 + line.seed);

        // Fade edges for clean blend into page
        ctx.strokeStyle = g.color(g.alphaBase);
        ctx.lineWidth = g.lineWidth;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        ctx.beginPath();

        for (let p = 0; p <= POINTS; p++) {
          const xNorm = p / POINTS;
          const px = xNorm * W;

          // Edge fade factor (fade out at left/right 8%)
          const edgeFade = Math.min(xNorm / 0.08, (1 - xNorm) / 0.08, 1);

          // Multi-layer sine waves
          const phase = line.phaseShift;
          const t1 = time * g.speed;
          const w1 = Math.sin(xNorm * g.freq + t1 * 1.3 + line.seed) * g.ampBase;
          const w2 = Math.sin(xNorm * g.freq * 1.8 - t1 * 0.9 + line.seed * 0.6 + phase) * g.ampBase * 0.4;
          const w3 = Math.cos(xNorm * g.freq * 0.5 + t1 * 0.4 + line.seed * 1.4) * g.ampBase * 0.55;

          // Mouse proximity repulsion
          const dx = px - mouseX;
          const dy = (baseY + w1) - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const mouseWave = dist < 200
            ? (1 - dist / 200) * 22 * Math.sin(dist * 0.035 - time * 2.8) * edgeFade
            : 0;

          const py = baseY + (w1 + w2 + w3) * edgeFade + mouseWave + scrollShift + tiltShift * edgeFade;

          if (p === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
        ctx.stroke();
      }

      // ── 3. Intersection accent nodes on red lines ──
      for (const line of lines) {
        if (line.group !== 2) continue; // only red group
        const g = WAVE_GROUPS[line.group];
        const baseY = H * 0.04 + line.yOffset * H * 0.92;

        for (let n = 0; n < 3; n++) {
          const xNorm = 0.15 + n * 0.3 + Math.sin(time * 0.3 + line.seed + n * 2) * 0.06;
          const px = xNorm * W;
          const t1 = time * g.speed;
          const w1 = Math.sin(xNorm * g.freq + t1 * 1.3 + line.seed) * g.ampBase;
          const w2 = Math.sin(xNorm * g.freq * 1.8 - t1 * 0.9 + line.seed * 0.6 + line.phaseShift) * g.ampBase * 0.4;
          const w3 = Math.cos(xNorm * g.freq * 0.5 + t1 * 0.4 + line.seed * 1.4) * g.ampBase * 0.55;
          const scrollShift = Math.sin(line.yOffset * Math.PI + scrollY * 0.0012) * 14;
          const py = baseY + w1 + w2 + w3 + scrollShift;

          // Pulsing radius
          const radius = 2 + Math.sin(time * 1.8 + line.seed + n) * 1;

          ctx.beginPath();
          ctx.arc(px, py, radius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(237, 28, 36, 0.08)`;
          ctx.fill();

          // Thin ring around it
          ctx.beginPath();
          ctx.arc(px, py, radius + 3, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(237, 28, 36, 0.035)`;
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }
      }

      // ── 4. Floating micro-particles (drifting red dust) ──
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.life += 1;
        if (p.life > p.maxLife) {
          particles[i] = spawnParticle();
          continue;
        }

        // Smooth fade in / out
        const lifeRatio = p.life / p.maxLife;
        const fade = lifeRatio < 0.15
          ? lifeRatio / 0.15
          : lifeRatio > 0.8
            ? (1 - lifeRatio) / 0.2
            : 1;

        // Drift with slight mouse influence
        const mDx = (mouseX - p.x) * 0.0003;
        const mDy = (mouseY - p.y) * 0.0003;
        p.x += p.vx + mDx;
        p.y += p.vy + mDy;

        // Wrap
        if (p.x < -20) p.x = W + 20;
        if (p.x > W + 20) p.x = -20;
        if (p.y < -20) p.y = H + 20;
        if (p.y > H + 20) p.y = -20;

        const alpha = 0.09 * fade;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = i % 3 === 0
          ? `rgba(237, 28, 36, ${alpha})`     // brand red
          : `rgba(148, 163, 184, ${alpha * 0.7})`; // slate
        ctx.fill();
      }

      // ── 5. Subtle horizontal scan-line shimmer (automotive HUD feel) ──
      const scanY = (H * 0.3 + Math.sin(time * 0.6) * H * 0.25) % H;
      const scanGrad = ctx.createLinearGradient(0, scanY - 40, 0, scanY + 40);
      scanGrad.addColorStop(0, 'rgba(237, 28, 36, 0)');
      scanGrad.addColorStop(0.5, 'rgba(237, 28, 36, 0.012)');
      scanGrad.addColorStop(1, 'rgba(237, 28, 36, 0)');
      ctx.fillStyle = scanGrad;
      ctx.fillRect(0, scanY - 40, W, 80);
    }

    draw();

    window.addEventListener('beforeunload', () => { cancelAnimationFrame(frameId); });
  })();
</script>
