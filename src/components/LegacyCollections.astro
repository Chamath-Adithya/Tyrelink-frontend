 {name:'Jacks',image:'H464abae489cf4f04bd1b26a9a6b947754.avif',query:'hydraulic jack'},
 {name:'Tool sets',image:'HTB1d_p.dA5E3KVjSZFCq6zuzXXaq-e1730624378651.avif',query:'tool sets'},
 {name:'Impact wrenches',image:'BIG-1.jpg',query:'impact wrench'},
 {name:'Machinery',image:'1000022240.jpg',query:'nitrogen machine'},
 {name:'Tyre & tube patches',image:'tyre-and-tube-patches.webp',query:'tyre patches'},
 {name:'Valves',image:'valves-sri-lanka.webp',query:'valves'}
