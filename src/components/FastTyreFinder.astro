---
const categories = [
  { 
    icon: '◉', 
    title: 'Tyres by vehicle', 
    text: 'Find a safe match for your car, SUV, bike, van or three-wheeler.',
    link: '/category/car-tyres',
    tag: 'Passenger & Commercial'
  },
  { 
    icon: '⌁', 
    title: 'Tyres by size', 
    text: 'Search your sidewall code (e.g. 185/65 R15) and compare verified options.',
    link: '/shop#catalog-products',
    tag: '13" to 22" Rim Sizes'
  },
  { 
    icon: '▣', 
    title: 'Garage equipment', 
    text: 'Build, upgrade and maintain your tyre shop or workshop with confidence.',
    link: '/category/garage-equipment',
    tag: 'Professional Systems'
  },
];

const whatsapp = '94783724920';
---

<section class="w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 reveal" id="finder-cards">
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 text-left border-b border-slate-200/80 pb-5">
    <div>
      <p class="text-[10px] font-black uppercase tracking-widest text-[#ed1c24] mb-1">
        Start here
      </p>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 font-display tracking-tight">
        How do you want to find your tyre?
      </h2>
    </div>
    <p class="text-xs sm:text-sm text-slate-500 font-medium">
      Not sure about your size? <a href={`https://wa.me/${whatsapp}?text=${encodeURIComponent('Hello Tyrelink, I need help identifying my tyre size.')}`} target="_blank" rel="noopener noreferrer" class="text-[#ed1c24] hover:underline font-bold">Ask an expert on WhatsApp →</a>
    </p>
  </div>

  <!-- 3 Architectural Category Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {categories.map((category) => (
      <a 
        href={category.link}
        class="group min-h-[220px] bg-white p-7 rounded-2xl flex flex-col justify-between border border-slate-200/90 hover:border-[#ed1c24] shadow-[0_4px_16px_rgba(0,0,0,0.04)] hover:shadow-[0_16px_36px_rgba(237,28,36,0.12)] transition-all duration-300 hover:-translate-y-1 text-left cursor-pointer relative overflow-hidden"
      >
        <!-- Top Row: Icon & Tag -->
        <div class="flex items-center justify-between">
          <span class="text-3xl text-[#ed1c24] font-black leading-none group-hover:scale-110 transition-transform">
            {category.icon}
          </span>
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 bg-slate-100 px-2.5 py-1 rounded-md">
            {category.tag}
          </span>
        </div>

        <!-- Middle Content -->
        <div class="space-y-1.5 my-4">
          <h3 class="text-xl font-black text-slate-900 font-display group-hover:text-[#ed1c24] transition-colors">
            {category.title}
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed max-w-xs">
            {category.text}
          </p>
        </div>

        <!-- Bottom Action Arrow -->
        <div class="flex items-center justify-between text-xs font-bold text-slate-900 group-hover:text-[#ed1c24] pt-2 border-t border-slate-100">
          <span>Explore options</span>
          <span class="text-base group-hover:translate-x-1 transition-transform">↗</span>
        </div>
      </a>
    ))}
  </div>
</section>

