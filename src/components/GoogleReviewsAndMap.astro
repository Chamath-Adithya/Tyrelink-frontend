---
interface Review {
  id: string;
  name: string;
  city: string;
  vehicle: string;
  rating: number;
  date: string;
  comment: string;
  sinhalaComment?: string;
  verified: boolean;
}

const reviews: Review[] = [
  {
    id: 'rev-1',
    name: 'Dr. Nuwan Senanayake',
    city: 'Kandy',
    vehicle: 'Suzuki Wagon R FX',
    rating: 5,
    date: '3 days ago',
    comment: 'Ordered 4 CEAT Milaze tyres for my Wagon R. Delivered to Kandy in under 48 hours with Cash on Delivery. Inspected the DOT manufacture dates on arrival—100% fresh 2024 stock. Exceptional service!',
    sinhalaComment: 'දින 2කින් නුවරටම ගෙනත් දුන්නා. Cash on Delivery මඟින් ටයර් පරීක්ෂා කර මුදල් ගෙවීමට හැකිවීම ඉතාම පහසුයි.',
    verified: true,
  },
  {
    id: 'rev-2',
    name: 'Chaminda Perera',
    city: 'Horana / Panadura',
    vehicle: 'Toyota Hilux Revo 4x4',
    rating: 5,
    date: '1 week ago',
    comment: 'Fitted Dunlop Grandtrek AT5 tyres. The WhatsApp consultation helped me select the exact rim profile. Excellent grip on wet roads and zero road noise on the Southern Expressway.',
    sinhalaComment: 'WhatsApp හරහා නිවැරදි ටයර් ප්‍රමාණය තෝරාගැනීමට විශිෂ්ට සහයක් ලැබුණා.',
    verified: true,
  },
  {
    id: 'rev-3',
    name: 'Roshan Jayasuriya',
    city: 'Colombo 05',
    vehicle: 'Yamaha FZ-S Version 3',
    rating: 5,
    date: '2 weeks ago',
    comment: 'Best price in Sri Lanka for CEAT Zoom Plus motorcycle tyres. Direct company warranty card included with invoice. 1-click WhatsApp order was totally frictionless.',
    sinhalaComment: 'සමාගම් වගකීම් සහතිකය සහිතව අඩුම මිලට ලැබුණා. සුපිරි සේවාවක්!',
    verified: true,
  },
  {
    id: 'rev-4',
    name: 'Malith Bandara',
    city: 'Galle',
    vehicle: 'Honda Vezel Hybrid',
    rating: 5,
    date: '3 weeks ago',
    comment: 'Michelin Primacy tyres delivered safely to Galle. Fast courier handling, genuine packaging and seamless customer care. Tyrelink is easily the most trusted tyre platform in SL.',
    sinhalaComment: 'ගාල්ලටම ආරක්ෂිතව පැමිණියා. ඉතාම විශ්වාසදායක සේවාවක්.',
    verified: true,
  },
];
---

<section id="google-reviews-section" class="w-full py-16 sm:py-24 bg-white border-t border-slate-200/80">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Google Business Rating Badge -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 sm:mb-16">
      <div class="max-w-2xl">
        <!-- Google Trust Pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-50 border border-slate-200/90 text-slate-800 text-xs font-semibold mb-4 shadow-2xs">
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span class="font-bold">Google Business Verified Rating: 4.9 ★★★★★</span>
          <span class="text-slate-400 font-normal">| 120+ Motorist Reviews</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-950 font-display tracking-tight leading-tight">
          Trusted by Drivers Across <span class="text-brand-600">All 25 Districts</span>.
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
          Read genuine experiences from Sri Lankan drivers who rely on Tyrelink for verified manufacture dates, islandwide COD, and prompt warranty support.
        </p>
      </div>

      <!-- Action Button: Write a Google Review -->
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="https://maps.google.com/?q=Horana,Sri+Lanka"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-sm hover:-translate-y-0.5 active:scale-95 cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current text-yellow-400" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span>Write a Google Review</span>
        </a>
      </div>
    </div>

    <!-- Verified Reviews Grid (Veloretti Minimalist Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {reviews.map((rev) => (
        <div class="flex flex-col justify-between p-6 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-card hover:-translate-y-1 transition-all duration-300">
          <div>
            <!-- Stars & Verified Badge -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-1 text-amber-500">
                {[...Array(rev.rating)].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200/60">
                <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Verified
              </span>
            </div>

            <!-- Review Text -->
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-normal mb-3">
              "{rev.comment}"
            </p>

            {rev.sinhalaComment && (
              <p class="text-xs text-slate-500 font-sinhala leading-normal italic mb-4">
                "{rev.sinhalaComment}"
              </p>
            )}
          </div>

          <!-- Reviewer Footer -->
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <div class="text-xs font-bold text-slate-900">{rev.name}</div>
              <div class="text-[11px] text-slate-500">{rev.vehicle} • {rev.city}</div>
            </div>
            <span class="text-[10px] text-slate-400 font-mono">{rev.date}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Interactive Google Map & Flagship Center Card -->
    <div class="rounded-3xl border border-slate-200 overflow-hidden bg-slate-900 text-white grid grid-cols-1 lg:grid-cols-12 shadow-card">
      
      <!-- Center Info Column -->
      <div class="lg:col-span-5 p-8 sm:p-12 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-slate-300 text-[11px] font-bold uppercase tracking-wider mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Flagship Fitment Hub & Logistics Center
          </div>

          <h3 class="text-2xl sm:text-3xl font-black font-display tracking-tight text-white mb-4">
            Visit Our Horana Service Center
          </h3>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 font-normal">
            Equipped with Italian 3D computer wheel aligners, precision robotic tyre changers, and nitrogen inflation bays. Walk-in tyre inspection and professional fitment available daily.
          </p>

          <div class="space-y-3 text-xs sm:text-sm text-slate-300">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>Main Street, Horana 12400, Western Province, Sri Lanka</span>
            </div>

            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Monday – Saturday: 8:30 AM – 7:30 PM | Sunday: 9:00 AM – 4:00 PM</span>
            </div>

            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>Direct Fitment Hotline: +94 78 372 4920</span>
            </div>
          </div>
        </div>

        <div class="pt-8 mt-8 border-t border-white/10 flex items-center gap-4">
          <a
            href="https://maps.google.com/?q=Horana,Sri+Lanka"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold transition-all shadow-md active:scale-95 cursor-pointer"
          >
            <span>Get Google Maps Directions</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Embedded Google Map Frame -->
      <div class="lg:col-span-7 min-h-[340px] sm:min-h-[420px] relative bg-slate-800">
        <iframe
          title="Tyrelink Horana Center Google Map"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d31698.815779039643!2d80.04601445749712!3d6.715300078864758!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ae24bb387498c0d%3A0x6b9d628d0b2e88a0!2sHorana%2C%20Sri%20Lanka!5e0!3m2!1sen!2slk!4v1700000000000!5m2!1sen!2slk"
          class="w-full h-full border-0 absolute inset-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

  </div>
</section>
