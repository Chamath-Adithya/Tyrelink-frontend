---
// CinematicVideoShowcase.astro — Pure Cinema Viewport (Expanding Fullscreen & Pinned Blur Slide-Over)
// Ultra-optimized for low-data mobile connection (612KB loop)
---

<section class="cinema-section" id="cinematic-showcase">
  <div class="cinema-sticky-stage" id="cinema-stage">
    
    <!-- Expanding Video Chassis (Starts as compact floating frame, expands to 100vw x 100vh fullscreen) -->
    <div class="cinema-frame" id="cinema-frame">
      <div class="cinema-monitor">
        
        <!-- Ultra-Optimized Infinite Looping Video (Zero bandwidth waste, 600KB, muted, playsinline) -->
        <video 
          id="cinema-player"
          class="cinema-video"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster="/videos/tyrelink-cinematic-poster.webp"
        >
          <source src="/videos/tyrelink-cinematic.mp4" type="video/mp4" />
        </video>

        <!-- Soft Blur & Scrim Overlay for Slide-Over Transition -->
        <div class="cinema-blur-scrim" id="cinema-blur-scrim" aria-hidden="true"></div>

      </div>
    </div>

  </div>
</section>

<script>
  // Measure the actual document position each frame so lazy-loaded imagery
  // above this section cannot leave stale scroll-trigger coordinates.
  let cleanupCinema: (() => void) | undefined;
  function initCinema() {
    cleanupCinema?.();
    const section = document.getElementById('cinematic-showcase');
    const frame = document.getElementById('cinema-frame');
    const video = document.getElementById('cinema-player') as HTMLVideoElement | null;
    const scrim = document.getElementById('cinema-blur-scrim');
    const next = document.getElementById('ready-to-order-section');
    if (!section || !frame || !video) return;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let pending = 0;
    const clamp = (n: number) => Math.max(0, Math.min(1, n));
    function update() {
      pending = 0;
      const vh = window.innerHeight;
      const mobile = window.innerWidth < 768;
      const progress = motion.matches ? 0 : clamp(-section!.getBoundingClientRect().top / (vh * .7));
      const ease = progress * progress * (3 - 2 * progress);
      const startWidth = mobile ? window.innerWidth - 32 : Math.min(window.innerWidth * .76, 1100);
      const startHeight = Math.min(vh * (mobile ? .42 : .56), 620);
      frame!.style.width = `${startWidth + (window.innerWidth - startWidth) * ease}px`;
      frame!.style.maxWidth = '100vw';
      frame!.style.height = `${startHeight + (vh - startHeight) * ease}px`;
      frame!.style.maxHeight = '100vh';
      frame!.style.borderRadius = `${24 * (1 - ease)}px`;
      const overlap = motion.matches || !next ? 0 : clamp((vh - next.getBoundingClientRect().top) / vh);
      video!.style.filter = `blur(${overlap * 14}px)`;
      if (scrim) scrim.style.opacity = String(overlap * .55);
    }
    const schedule = () => { if (!pending) pending = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, {passive: true});
    window.addEventListener('resize', schedule, {passive: true});
    motion.addEventListener('change', schedule);
    update();
    if (!motion.matches) video.play().catch(() => {});
    else video.pause();
    cleanupCinema = () => { cancelAnimationFrame(pending); window.removeEventListener('scroll',schedule); window.removeEventListener('resize',schedule); motion.removeEventListener('change',schedule); };
  }
  initCinema();
  document.addEventListener('astro:page-load',initCinema);
  document.addEventListener('astro:before-swap',()=>cleanupCinema?.());
</script>

<style>
  /* ==========================================================================
     CINEMA SECTION (STICKY TRACK: COMPACT -> FULLSCREEN -> BLUR SLIDE-OVER)
     ========================================================================== */
  .cinema-section {
    position: relative;
    height: 180vh; /* Scroll track distance for smooth expansion */
    background: transparent;
    z-index: 15;
  }

  /* Sticky Viewport Stage */
  .cinema-sticky-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: transparent;
  }

  /* Expanding Frame Vessel */
  .cinema-frame {
    position: relative;
    background: #090d16;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    will-change: width, height, border-radius, box-shadow;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cinema-monitor {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #090d16;
  }

  .cinema-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    will-change: filter, transform;
  }

  /* Dark Scrim overlay during blur */
  .cinema-blur-scrim {
    position: absolute;
    inset: 0;
    background: rgba(9, 13, 22, 0.7);
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }

  @media (max-width: 768px) {
    .cinema-section {
      height: 160vh;
    }
  }
</style>

