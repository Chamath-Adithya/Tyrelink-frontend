<div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-sm space-y-4 animate-pulse">
  <!-- Image Skeleton -->
  <div class="aspect-[4/3] sm:aspect-square max-h-[250px] sm:max-h-none w-full rounded-2xl shimmer"></div>

  <!-- Content Skeleton -->
  <div class="space-y-2">
    <div class="flex items-center justify-between">
      <div class="h-3 w-16 rounded-md shimmer"></div>
      <div class="h-3 w-12 rounded-md shimmer"></div>
    </div>
    <div class="h-4 w-full rounded-md shimmer"></div>
    <div class="h-4 w-3/4 rounded-md shimmer"></div>
    <div class="h-3 w-24 rounded-md shimmer"></div>
  </div>

  <!-- Pricing Skeleton -->
  <div class="pt-3 border-t border-slate-100 space-y-2">
    <div class="h-6 w-28 rounded-md shimmer"></div>
    <div class="h-3 w-36 rounded-md shimmer"></div>
    <div class="grid grid-cols-2 gap-2 pt-1">
      <div class="h-9 rounded-xl shimmer"></div>
      <div class="h-9 rounded-xl shimmer"></div>
    </div>
  </div>
</div>
