---
interface Props {
  title: string;
  images?: string[];
  featuredImage: string;
  isFlashDeal?: boolean;
  flashDealDiscount?: number;
}

const {
  title,
  images = [],
  featuredImage,
  isFlashDeal,
  flashDealDiscount,
} = Astro.props;

// Ensure non-empty gallery array
const rawList = images && images.length > 0 ? images : [featuredImage];
const galleryImages = rawList.filter(Boolean);
const initialImage = galleryImages[0] || featuredImage;
---

<div class="space-y-4" id="product-gallery-container">
  <!-- =====================================================
      CRISP WHITE LUXURY STAGE (CLEAN WHITE STUDIO)
      ===================================================== -->
  <div
    id="gallery-main-stage"
    class="relative h-[300px] sm:h-[420px] lg:h-[480px] w-full rounded-3xl overflow-hidden bg-white/80 backdrop-blur-2xl shadow-[0_12px_40px_rgba(0,0,0,0.04)] flex items-center justify-center border border-white/90 group select-none cursor-zoom-in"
    title="Click to view full screen high-resolution image"
  >
    <!-- Subtle radial light gradient -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-50/40 via-white/30 to-slate-50/20 pointer-events-none"></div>

    <!-- The Main High-Res Image with Optical Zoom Lens on Hover -->
    <div id="gallery-zoom-viewport" class="w-full h-full p-4 sm:p-8 lg:p-10 flex items-center justify-center overflow-hidden">
      <img
        id="gallery-main-img"
        src={initialImage}
        alt={`${title} - Main Angle`}
        class="w-full h-full object-contain drop-shadow-md transition-transform duration-150 ease-out origin-center pointer-events-none"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- Top Left: Flash Discount Ribbon with Lightning Bolt ⚡ -->
    {isFlashDeal && flashDealDiscount && (
      <span class="absolute top-5 left-5 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-gradient-to-r from-red-600 to-rose-500 text-white shadow-md z-20 pointer-events-none">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
        </svg>
        -{flashDealDiscount}% OFF
      </span>
    )}

    <!-- Top Right: Angle Pill & Fullscreen Button -->
    <div class="absolute top-5 right-5 flex items-center gap-2 z-20">
      {galleryImages.length > 1 && (
        <span 
          id="gallery-angle-counter"
          class="px-3 py-1.5 rounded-full text-xs font-bold bg-white/80 backdrop-blur-xl text-slate-700 shadow-sm border border-white/90 pointer-events-none"
        >
          1 / {galleryImages.length}
        </span>
      )}

      <button
        type="button"
        id="gallery-open-fullscreen-btn"
        aria-label="Open Fullscreen Lightbox"
        class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-brand-500 hover:bg-brand-600 text-white text-xs font-bold shadow-md transition-all hover:scale-105 active:scale-95 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
        </svg>
        <span class="hidden sm:inline">Fullscreen</span>
      </button>
    </div>

    <!-- Floating Prev / Next Arrow Buttons on Stage -->
    {galleryImages.length > 1 && (
      <>
        <button
          type="button"
          id="gallery-stage-prev-btn"
          aria-label="Previous image angle"
          class="absolute left-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/85 hover:bg-brand-500 hover:text-white backdrop-blur-xl border border-white/90 shadow-md text-slate-700 flex items-center justify-center transition-all hover:scale-110 active:scale-90 z-20 cursor-pointer"
        >
          <svg class="w-5 h-5 -translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button
          type="button"
          id="gallery-stage-next-btn"
          aria-label="Next image angle"
          class="absolute right-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/85 hover:bg-brand-500 hover:text-white backdrop-blur-xl border border-white/90 shadow-md text-slate-700 flex items-center justify-center transition-all hover:scale-110 active:scale-90 z-20 cursor-pointer"
        >
          <svg class="w-5 h-5 translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </>
    )}

    <!-- Optical Magnifier Hint Pill -->
    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full bg-slate-900/85 backdrop-blur-md text-white text-[11px] font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none flex items-center gap-1.5 shadow-lg">
      <svg class="w-3.5 h-3.5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="11" y1="8" x2="11" y2="14"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
      <span>Move cursor to zoom in • Click for fullscreen</span>
    </div>
  </div>

  <!-- =====================================================
      THUMBNAIL STRIP (LUXURY STUDIO IMAGE SWITCHER)
      ===================================================== -->
  {galleryImages.length > 1 && (
    <div class="flex items-center gap-3.5 overflow-x-auto py-2 px-1 scrollbar-none" id="gallery-thumbnails-strip">
      {galleryImages.map((img, idx) => (
        <button
          type="button"
          data-gallery-thumb-idx={idx}
          class={`gallery-thumb-btn relative w-20 h-20 sm:w-22 sm:h-22 rounded-2xl p-2 bg-white/80 backdrop-blur-md transition-all duration-200 cursor-pointer flex items-center justify-center shrink-0 border ${
            idx === 0
              ? 'border-brand-500 ring-2 ring-brand-500/25 shadow-[0_4px_16px_rgba(237,28,36,0.22)] scale-105 opacity-100'
              : 'border-white/90 opacity-70 hover:opacity-100 hover:border-brand-500/40 hover:scale-102'
          }`}
          aria-label={`Switch to angle ${idx + 1}`}
        >
          <img
            src={img}
            alt={`${title} thumbnail ${idx + 1}`}
            class="w-full h-full object-contain rounded-xl"
            loading="lazy"
          />
          <span 
            class={`thumb-indicator absolute -bottom-1 left-1/2 -translate-x-1/2 w-6 h-1 rounded-full bg-brand-500 transition-opacity duration-200 ${
              idx === 0 ? 'opacity-100' : 'opacity-0'
            }`}
          />
        </button>
      ))}
    </div>
  )}


  <!-- =====================================================
      TRUE FULLSCREEN STUDIO LIGHTBOX (TELEPORTED TO BODY)
      ===================================================== -->
  <div 
    id="product-lightbox-modal"
    class="fixed inset-0 z-[999999] w-screen h-screen bg-black/95 backdrop-blur-2xl hidden flex-col justify-between p-4 sm:p-6 select-none"
    style="margin: 0; top: 0; left: 0;"
  >
    <!-- Top Bar: Title, Zoom Controls, Close Button -->
    <header class="flex items-center justify-between gap-4 w-full max-w-[1440px] mx-auto z-20 shrink-0">
      <div class="text-left text-white min-w-0">
        <h2 class="text-sm sm:text-base font-bold truncate max-w-md">{title}</h2>
        <p id="lightbox-angle-indicator" class="text-xs text-slate-400">
          Angle 1 of {galleryImages.length} • High Resolution Studio Inspection
        </p>
      </div>

      <!-- Controls -->
      <div class="flex items-center gap-3 shrink-0">
        <!-- Zoom Buttons Bar -->
        <div class="flex items-center bg-white/10 rounded-2xl p-1 border border-white/15 backdrop-blur-md">
          <button
            type="button"
            id="lightbox-zoom-out-btn"
            aria-label="Zoom out"
            class="w-8 h-8 rounded-xl flex items-center justify-center text-white hover:bg-white/20 disabled:opacity-30 disabled:hover:bg-transparent transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>
          <span id="lightbox-zoom-label" class="text-xs font-mono font-bold text-white px-2.5">
            100%
          </span>
          <button
            type="button"
            id="lightbox-zoom-in-btn"
            aria-label="Zoom in"
            class="w-8 h-8 rounded-xl flex items-center justify-center text-white hover:bg-white/20 disabled:opacity-30 disabled:hover:bg-transparent transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>
          <button
            type="button"
            id="lightbox-zoom-reset-btn"
            aria-label="Reset zoom"
            class="hidden w-8 h-8 rounded-xl items-center justify-center text-white hover:bg-white/20 transition-colors ml-1 cursor-pointer"
            title="Reset zoom to 100%"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1 4 1 10 7 10"></polyline>
              <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
          </button>
        </div>

        <!-- Close Button -->
        <button
          type="button"
          id="lightbox-close-btn"
          aria-label="Close Fullscreen View"
          class="w-10 h-10 rounded-full bg-white/10 hover:bg-red-500 hover:text-white border border-white/20 text-white flex items-center justify-center transition-all hover:scale-105 active:scale-95 cursor-pointer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main Lightbox Stage Area -->
    <div id="lightbox-stage-area" class="relative flex-1 flex items-center justify-center w-full max-w-[1440px] mx-auto overflow-hidden my-2">
      <!-- Lightbox Prev Button -->
      {galleryImages.length > 1 && (
        <button
          type="button"
          id="lightbox-prev-btn"
          aria-label="Previous image"
          class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 border border-white/20 text-white flex items-center justify-center transition-all hover:scale-110 active:scale-90 z-30 backdrop-blur-md cursor-pointer"
        >
          <svg class="w-6 h-6 -translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      )}

      <!-- Image Canvas -->
      <div id="lightbox-img-container" class="relative max-w-full max-h-[72vh] flex items-center justify-center overflow-auto p-4 transition-transform duration-200">
        <img
          id="lightbox-main-img"
          src={initialImage}
          alt={title}
          class="max-w-full max-h-[68vh] object-contain drop-shadow-[0_20px_50px_rgba(0,0,0,0.8)] select-none transition-transform duration-200 cursor-grab"
        />
      </div>

      <!-- Lightbox Next Button -->
      {galleryImages.length > 1 && (
        <button
          type="button"
          id="lightbox-next-btn"
          aria-label="Next image"
          class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 border border-white/20 text-white flex items-center justify-center transition-all hover:scale-110 active:scale-90 z-30 backdrop-blur-md cursor-pointer"
        >
          <svg class="w-6 h-6 translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      )}
    </div>

    <!-- Lightbox Bottom Navigation Bar -->
    <footer class="w-full max-w-3xl mx-auto flex flex-col items-center gap-2 z-20 shrink-0">
      {galleryImages.length > 1 && (
        <div class="flex items-center justify-center gap-2 sm:gap-3 p-2 rounded-2xl bg-white/10 border border-white/15 backdrop-blur-md overflow-x-auto max-w-full" id="lightbox-thumbnails-strip">
          {galleryImages.map((img, idx) => (
            <button
              type="button"
              data-lightbox-thumb-idx={idx}
              class={`lightbox-thumb-btn w-14 h-14 sm:w-16 sm:h-16 rounded-xl p-1 bg-white/10 transition-all cursor-pointer flex items-center justify-center border shrink-0 ${
                idx === 0
                  ? 'ring-2 ring-brand-500 border-white scale-110 bg-white/30'
                  : 'border-white/20 opacity-50 hover:opacity-90 hover:scale-105'
              }`}
            >
              <img src={img} alt={`Thumb ${idx + 1}`} class="w-full h-full object-contain rounded-lg" />
            </button>
          ))}
        </div>
      )}
      <p class="text-[11px] text-slate-400">
        Press <kbd class="px-1.5 py-0.5 rounded bg-white/20 text-white font-mono text-[10px]">Esc</kbd> to exit • Use <kbd class="px-1.5 py-0.5 rounded bg-white/20 text-white font-mono text-[10px]">←</kbd> <kbd class="px-1.5 py-0.5 rounded bg-white/20 text-white font-mono text-[10px]">→</kbd> to browse
      </p>
    </footer>
  </div>
</div>

<script is:inline define:vars={{ galleryImages }}>
  (function initProductGallery() {
    let currentIndex = 0;
    let currentZoom = 1;

    // Elements
    const mainStage = document.getElementById('gallery-main-stage');
    const zoomViewport = document.getElementById('gallery-zoom-viewport');
    const mainImg = document.getElementById('gallery-main-img');
    const angleCounter = document.getElementById('gallery-angle-counter');
    const stagePrevBtn = document.getElementById('gallery-stage-prev-btn');
    const stageNextBtn = document.getElementById('gallery-stage-next-btn');
    const openFullscreenBtn = document.getElementById('gallery-open-fullscreen-btn');
    const thumbBtns = document.querySelectorAll('.gallery-thumb-btn');

    // Lightbox Elements
    const modal = document.getElementById('product-lightbox-modal');
    const lightboxMainImg = document.getElementById('lightbox-main-img');
    const lightboxAngleInd = document.getElementById('lightbox-angle-indicator');
    const lightboxPrevBtn = document.getElementById('lightbox-prev-btn');
    const lightboxNextBtn = document.getElementById('lightbox-next-btn');
    const lightboxCloseBtn = document.getElementById('lightbox-close-btn');
    const lightboxZoomIn = document.getElementById('lightbox-zoom-in-btn');
    const lightboxZoomOut = document.getElementById('lightbox-zoom-out-btn');
    const lightboxZoomReset = document.getElementById('lightbox-zoom-reset-btn');
    const lightboxZoomLabel = document.getElementById('lightbox-zoom-label');
    const lightboxThumbBtns = document.querySelectorAll('.lightbox-thumb-btn');
    const lightboxStageArea = document.getElementById('lightbox-stage-area');

    if (!mainImg || !galleryImages || galleryImages.length === 0) return;

    // Teleport lightbox modal directly to document.body to break free of any parent transforms
    if (modal && modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    // Function to switch to image index
    function setIndex(index) {
      if (index < 0) index = galleryImages.length - 1;
      if (index >= galleryImages.length) index = 0;
      currentIndex = index;

      const newSrc = galleryImages[currentIndex];

      // Update main image
      if (mainImg) {
        mainImg.src = newSrc;
      }

      // Update angle counter
      if (angleCounter) {
        angleCounter.textContent = `${currentIndex + 1} / ${galleryImages.length}`;
      }

      // Update main stage thumbnail styles
      thumbBtns.forEach((btn, idx) => {
        const indicator = btn.querySelector('.thumb-indicator');
        if (idx === currentIndex) {
          btn.className = 'gallery-thumb-btn relative w-20 h-20 sm:w-22 sm:h-22 rounded-2xl p-2 bg-white transition-all duration-200 cursor-pointer flex items-center justify-center shrink-0 border border-brand-500 ring-2 ring-brand-500/25 shadow-[0_4px_16px_rgba(237,28,36,0.22)] scale-105 opacity-100';
          if (indicator) {
            indicator.className = 'thumb-indicator absolute -bottom-1 left-1/2 -translate-x-1/2 w-6 h-1 rounded-full bg-brand-500 transition-opacity duration-200 opacity-100';
          }
        } else {
          btn.className = 'gallery-thumb-btn relative w-20 h-20 sm:w-22 sm:h-22 rounded-2xl p-2 bg-white transition-all duration-200 cursor-pointer flex items-center justify-center shrink-0 border border-slate-200/90 opacity-65 hover:opacity-100 hover:border-slate-300 hover:scale-102';
          if (indicator) {
            indicator.className = 'thumb-indicator absolute -bottom-1 left-1/2 -translate-x-1/2 w-6 h-1 rounded-full bg-brand-500 transition-opacity duration-200 opacity-0';
          }
        }
      });

      // Update Lightbox image & indicator
      if (lightboxMainImg) {
        lightboxMainImg.src = newSrc;
      }
      if (lightboxAngleInd) {
        lightboxAngleInd.textContent = `Angle ${currentIndex + 1} of ${galleryImages.length} • High Resolution Studio Inspection`;
      }

      // Update lightbox thumbnails
      lightboxThumbBtns.forEach((btn, idx) => {
        if (idx === currentIndex) {
          btn.className = 'lightbox-thumb-btn w-14 h-14 sm:w-16 sm:h-16 rounded-xl p-1 bg-white/10 transition-all cursor-pointer flex items-center justify-center border shrink-0 ring-2 ring-brand-500 border-white scale-110 bg-white/30';
        } else {
          btn.className = 'lightbox-thumb-btn w-14 h-14 sm:w-16 sm:h-16 rounded-xl p-1 bg-white/10 transition-all cursor-pointer flex items-center justify-center border shrink-0 border-white/20 opacity-50 hover:opacity-90 hover:scale-105';
        }
      });
    }

    // Attach click listeners to thumbnails
    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.getAttribute('data-gallery-thumb-idx') || '0', 10);
        setIndex(idx);
      });
    });

    // Stage Next / Prev
    if (stageNextBtn) {
      stageNextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setIndex(currentIndex + 1);
      });
    }

    if (stagePrevBtn) {
      stagePrevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setIndex(currentIndex - 1);
      });
    }

    // Optical Zoom on Hover on Stage
    if (mainStage && mainImg) {
      mainStage.addEventListener('mousemove', (e) => {
        const rect = mainStage.getBoundingClientRect();
        const x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
        const y = Math.max(0, Math.min(100, ((e.clientY - rect.top) / rect.height) * 100));
        mainImg.style.transformOrigin = `${x}% ${y}%`;
        mainImg.style.transform = 'scale(2.2)';
      });

      mainStage.addEventListener('mouseleave', () => {
        mainImg.style.transformOrigin = 'center center';
        mainImg.style.transform = 'scale(1)';
      });

      // Clicking main stage opens lightbox
      mainStage.addEventListener('click', (e) => {
        // Prevent opening if clicking next/prev or fullscreen button
        if (e.target.closest('#gallery-stage-prev-btn') || 
            e.target.closest('#gallery-stage-next-btn') || 
            e.target.closest('#gallery-open-fullscreen-btn')) {
          return;
        }
        openLightbox();
      });
    }

    // Fullscreen Lightbox Open / Close Logic
    function openLightbox() {
      if (!modal) return;
      currentZoom = 1;
      updateLightboxZoom();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      currentZoom = 1;
      updateLightboxZoom();
    }

    if (openFullscreenBtn) {
      openFullscreenBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox();
      });
    }

    if (lightboxCloseBtn) {
      lightboxCloseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeLightbox();
      });
    }

    // Close on backdrop click (click outside header, image, footer)
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal || e.target === lightboxStageArea) {
          closeLightbox();
        }
      });
    }

    // Lightbox navigation
    if (lightboxNextBtn) {
      lightboxNextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setIndex(currentIndex + 1);
      });
    }

    if (lightboxPrevBtn) {
      lightboxPrevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setIndex(currentIndex - 1);
      });
    }

    // Lightbox thumbnails
    lightboxThumbBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.getAttribute('data-lightbox-thumb-idx') || '0', 10);
        setIndex(idx);
      });
    });

    // Lightbox Zoom Controls
    function updateLightboxZoom() {
      if (lightboxMainImg) {
        lightboxMainImg.style.transform = `scale(${currentZoom})`;
      }
      if (lightboxZoomLabel) {
        lightboxZoomLabel.textContent = `${Math.round(currentZoom * 100)}%`;
      }
      if (lightboxZoomIn) {
        lightboxZoomIn.disabled = currentZoom >= 3;
      }
      if (lightboxZoomOut) {
        lightboxZoomOut.disabled = currentZoom <= 1;
      }
      if (lightboxZoomReset) {
        if (currentZoom > 1) {
          lightboxZoomReset.classList.remove('hidden');
          lightboxZoomReset.classList.add('flex');
        } else {
          lightboxZoomReset.classList.add('hidden');
          lightboxZoomReset.classList.remove('flex');
        }
      }
    }

    if (lightboxZoomIn) {
      lightboxZoomIn.addEventListener('click', (e) => {
        e.stopPropagation();
        currentZoom = Math.min(currentZoom + 0.5, 3);
        updateLightboxZoom();
      });
    }

    if (lightboxZoomOut) {
      lightboxZoomOut.addEventListener('click', (e) => {
        e.stopPropagation();
        currentZoom = Math.max(currentZoom - 0.5, 1);
        updateLightboxZoom();
      });
    }

    if (lightboxZoomReset) {
      lightboxZoomReset.addEventListener('click', (e) => {
        e.stopPropagation();
        currentZoom = 1;
        updateLightboxZoom();
      });
    }

    // Keyboard Shortcuts (Esc to close, Arrow keys to navigate)
    window.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        closeLightbox();
      } else if (e.key === 'ArrowRight') {
        setIndex(currentIndex + 1);
      } else if (e.key === 'ArrowLeft') {
        setIndex(currentIndex - 1);
      }
    });

    // Touch Swipes for mobile
    let touchStartX = 0;
    if (mainStage) {
      mainStage.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      mainStage.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) setIndex(currentIndex + 1);
          else setIndex(currentIndex - 1);
        }
      }, { passive: true });
    }
  })();
</script>
