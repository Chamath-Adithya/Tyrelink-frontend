---
// Tyrelink Background — Architectural Technical Grid & Calm Animated CAD Blueprint Illustrations
// 100% Pure CSS & SVG · Zero Confusing Numbers/Words · Calm & Serene Automotive Motion
---

<div
  class="fixed inset-0 pointer-events-none -z-10 overflow-hidden select-none"
  aria-hidden="true"
>
  <!-- Minor 32px Drafting Grid (Clean, soft, subtle) -->
  <div 
    class="absolute inset-0"
    style="background-image: linear-gradient(to right, rgba(148, 163, 184, 0.14) 1px, transparent 1px), linear-gradient(to bottom, rgba(148, 163, 184, 0.14) 1px, transparent 1px); background-size: 32px 32px;"
  ></div>

  <!-- Major 128px Architectural Grid Lines (Subtle structure) -->
  <div 
    class="absolute inset-0"
    style="background-image: linear-gradient(to right, rgba(148, 163, 184, 0.20) 1px, transparent 1px), linear-gradient(to bottom, rgba(148, 163, 184, 0.20) 1px, transparent 1px); background-size: 128px 128px;"
  ></div>

  <!-- Precision Crosshair Dots at Intersections -->
  <div
    class="absolute inset-0"
    style="background-image: radial-gradient(rgba(100, 116, 139, 0.25) 1.2px, transparent 1.2px); background-size: 128px 128px; background-position: -0.6px -0.6px;"
  ></div>

  <!-- Soft subtle blend to maintain contrast for cards -->
  <div 
    class="absolute inset-0"
    style="background: radial-gradient(ellipse at 50% 40%, transparent 70%, rgba(241, 244, 248, 0.15) 100%);"
  ></div>

  <!-- ============================================================
       CALM ANIMATED CAD BLUEPRINT DRAWINGS (Pure Geometry · 0 Text)
       ============================================================ -->

  <!-- CAD Drawing 1: Concentric Wheel Rim & 5-Lug Hub Blueprint (Top Right) -->
  <div class="absolute top-8 right-4 lg:right-16 w-80 h-80 lg:w-[460px] lg:h-[460px] pointer-events-none cad-wheel-container">
    <svg class="w-full h-full text-slate-400/[0.22]" viewBox="0 0 200 200" fill="none" stroke="currentColor">
      {/* Outer Rim Ring with Calm Clockwise Rotation */}
      <circle 
        cx="100" cy="100" r="95" 
        stroke-width="1.2" 
        stroke-dasharray="6 6" 
        class="cad-spin-clockwise origin-center" 
      />
      <circle cx="100" cy="100" r="82" stroke-width="0.9" />
      <circle cx="100" cy="100" r="70" stroke-width="1.1" stroke-dasharray="4 4" class="cad-spin-counter origin-center" />

      {/* 5-Lug Bolt Pattern & Hub Flange */}
      <circle cx="100" cy="100" r="32" stroke-width="1" class="cad-ring-pulse origin-center" />
      <circle cx="100" cy="100" r="22" stroke-width="0.8" stroke-dasharray="2 3" />
      <circle cx="100" cy="100" r="8" stroke-width="1.4" />

      {/* 5-Lug Holes */}
      <g class="cad-spin-clockwise origin-center">
        <circle cx="100" cy="78" r="3" stroke-width="1" />
        <circle cx="121" cy="93" r="3" stroke-width="1" />
        <circle cx="113" cy="118" r="3" stroke-width="1" />
        <circle cx="87" cy="118" r="3" stroke-width="1" />
        <circle cx="79" cy="93" r="3" stroke-width="1" />
      </g>

      {/* Rotating Measurement Axes */}
      <g class="cad-spin-counter origin-center">
        <line x1="100" y1="2" x2="100" y2="198" stroke-width="0.75" stroke-dasharray="4 6" />
        <line x1="2" y1="100" x2="198" y2="100" stroke-width="0.75" stroke-dasharray="4 6" />
      </g>

      {/* Diagonal Calibration Crosshairs */}
      <line x1="30" y1="30" x2="170" y2="170" stroke-width="0.5" stroke-dasharray="2 6" />
      <line x1="170" y1="30" x2="30" y2="170" stroke-width="0.5" stroke-dasharray="2 6" />
    </svg>
  </div>

  <!-- CAD Drawing 2: Dynamic Tread Pitch & Longitudinal Grooves (Middle Left) -->
  <div class="absolute top-[32%] left-4 lg:left-12 w-72 h-72 lg:w-96 lg:h-96 pointer-events-none cad-tread-container">
    <svg class="w-full h-full text-slate-400/[0.20]" viewBox="0 0 200 200" fill="none" stroke="currentColor">
      {/* Tread Block Perimeter */}
      <polygon 
        points="15,40 185,40 160,160 40,160" 
        stroke-width="1.1" 
        stroke-dasharray="6 4" 
        class="cad-dash-crawl" 
      />
      {/* Longitudinal Channels */}
      <line x1="55" y1="40" x2="42" y2="160" stroke-width="0.8" />
      <line x1="95" y1="40" x2="82" y2="160" stroke-width="0.8" />
      <line x1="135" y1="40" x2="122" y2="160" stroke-width="0.8" />

      {/* Calming S-Curve Sipes & Water Evacuation Channels */}
      <path 
        d="M 95 40 A 28 28 0 0 1 112 65" 
        stroke-width="1" 
        stroke-dasharray="3 3"
        class="cad-dash-crawl-reverse"
      />
      <path 
        d="M 55 70 A 28 28 0 0 1 72 95" 
        stroke-width="0.8" 
        stroke-dasharray="3 3"
        class="cad-dash-crawl"
      />
      <path 
        d="M 65 110 A 35 35 0 0 0 135 110" 
        stroke-width="0.8" 
        stroke-dasharray="4 4"
        class="cad-dash-crawl"
      />
      <circle cx="100" cy="100" r="3" stroke-width="1.2" />
      <circle cx="100" cy="100" r="14" stroke-width="0.6" stroke-dasharray="2 3" class="cad-spin-clockwise origin-center" />
    </svg>
  </div>

  <!-- CAD Drawing 3: Coilover Suspension Strut & Damper Geometry (Middle Right) -->
  <div class="absolute top-[52%] right-6 lg:right-20 w-64 h-80 lg:w-80 lg:h-96 pointer-events-none cad-strut-container">
    <svg class="w-full h-full text-slate-400/[0.19]" viewBox="0 0 160 220" fill="none" stroke="currentColor">
      {/* Top Mount Plate */}
      <rect x="50" y="10" width="60" height="8" rx="2" stroke-width="1.1" />
      <circle cx="62" cy="14" r="2" fill="currentColor" stroke="none" />
      <circle cx="98" cy="14" r="2" fill="currentColor" stroke="none" />
      
      {/* Damper Piston Shaft */}
      <line x1="80" y1="18" x2="80" y2="80" stroke-width="1.5" />
      
      {/* Helical Coil Spring (CAD wireframe sine curves) */}
      <path 
        d="M 52 40 Q 80 32 108 40 Q 80 48 52 56 Q 80 48 108 56 Q 80 64 52 72 Q 80 64 108 72 Q 80 80 52 88 Q 80 80 108 88 Q 80 96 52 104 Q 80 96 108 104 Q 80 112 52 120 Q 80 112 108 120 Q 80 128 52 136 Q 80 128 108 136" 
        stroke-width="1.2" 
        stroke-linecap="round"
        class="cad-spring-pulse"
      />
      
      {/* Main Shock Absorber Cylinder Body */}
      <rect x="65" y="125" width="30" height="70" rx="3" stroke-width="1.2" stroke-dasharray="5 3" class="cad-dash-crawl" />
      <line x1="65" y1="145" x2="95" y2="145" stroke-width="0.8" />
      <line x1="65" y1="165" x2="95" y2="165" stroke-width="0.8" />
      
      {/* Lower Mounting Bushing */}
      <circle cx="80" cy="205" r="9" stroke-width="1.2" />
      <circle cx="80" cy="205" r="4" stroke-width="1" />
      <line x1="80" y1="5" x2="80" y2="215" stroke-width="0.5" stroke-dasharray="3 4" />
    </svg>
  </div>

  <!-- CAD Drawing 4: Aerodynamic Streamline Curvature & Venturi Flow (Bottom Left) -->
  <div class="absolute bottom-16 left-6 lg:left-24 w-72 h-64 lg:w-96 lg:h-80 pointer-events-none cad-aero-container">
    <svg class="w-full h-full text-slate-400/[0.18]" viewBox="0 0 220 160" fill="none" stroke="currentColor">
      {/* Aerodynamic Foil Cross-Section */}
      <path 
        d="M 20 80 C 50 30 160 50 200 80 C 160 90 70 95 20 80 Z" 
        stroke-width="1.2" 
        stroke-dasharray="5 4"
        class="cad-dash-crawl" 
      />
      
      {/* Streamline Vectors */}
      <path d="M 10 50 C 60 25 150 40 210 65" stroke-width="0.8" stroke-dasharray="4 6" class="cad-dash-crawl" />
      <path d="M 10 70 C 60 45 150 60 210 85" stroke-width="0.9" stroke-dasharray="3 4" class="cad-dash-crawl-reverse" />
      <path d="M 10 100 C 60 115 150 110 210 105" stroke-width="0.8" stroke-dasharray="4 6" class="cad-dash-crawl" />
      
      {/* Trailing Vortex Micro-Circles */}
      <g class="cad-spin-clockwise origin-center">
        <circle cx="195" cy="80" r="12" stroke-width="0.75" stroke-dasharray="2 3" />
        <circle cx="195" cy="80" r="6" stroke-width="0.9" />
      </g>
    </svg>
  </div>

  <!-- CAD Drawing 5: Steering Angle Radian Gauge (Bottom Right) -->
  <div class="absolute bottom-10 right-6 lg:right-32 w-64 h-64 lg:w-80 lg:h-80 pointer-events-none cad-telemetry-container">
    <svg class="w-full h-full text-slate-400/[0.18]" viewBox="0 0 200 200" fill="none" stroke="currentColor">
      <circle cx="100" cy="100" r="88" stroke-width="0.9" stroke-dasharray="4 8" class="cad-spin-clockwise origin-center" />
      <circle cx="100" cy="100" r="62" stroke-width="1.1" />
      <circle cx="100" cy="100" r="36" stroke-width="0.8" stroke-dasharray="3 4" class="cad-spin-counter origin-center" />
      <path d="M 30 100 A 70 70 0 0 1 100 30" stroke-width="1.2" class="cad-dash-crawl" stroke-dasharray="6 4" />
      <line x1="100" y1="12" x2="100" y2="188" stroke-width="0.6" stroke-dasharray="3 5" />
      <line x1="12" y1="100" x2="188" y2="100" stroke-width="0.6" stroke-dasharray="3 5" />
      {/* Precision calibration ticks */}
      <line x1="100" y1="12" x2="100" y2="22" stroke-width="1.2" />
      <line x1="188" y1="100" x2="178" y2="100" stroke-width="1.2" />
      <line x1="100" y1="188" x2="100" y2="178" stroke-width="1.2" />
      <line x1="12" y1="100" x2="22" y2="100" stroke-width="1.2" />
    </svg>
  </div>
</div>

<style>
  /* Calm, Serene, Ultra-Smooth Hardware-Accelerated CAD Blueprint Animations */

  /* 1. Calm, slow clockwise rotation (75s) */
  .cad-spin-clockwise {
    transform-origin: 100px 100px;
    animation: cadRotateClockwise 75s linear infinite;
    will-change: transform;
  }

  /* 2. Calm counter-clockwise rotation (60s) */
  .cad-spin-counter {
    transform-origin: 100px 100px;
    animation: cadRotateCounter 60s linear infinite;
    will-change: transform;
  }

  /* 3. Calm floating sway for wheel container (24s) */
  .cad-wheel-container {
    animation: cadFloatWheel 24s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* 4. Calm floating sway for tread container (28s) */
  .cad-tread-container {
    animation: cadFloatTread 28s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* 5. Calm vertical breath for suspension strut (18s) */
  .cad-strut-container {
    animation: cadFloatStrut 22s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* 6. Aerodynamic foil floating drift (26s) */
  .cad-aero-container {
    animation: cadFloatAero 26s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* 7. Steering telemetry float (24s) */
  .cad-telemetry-container {
    animation: cadFloatTelemetry 24s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* 8. Calm Dash Crawl (Laser CAD drafting effect) */
  .cad-dash-crawl {
    animation: cadDashMove 20s linear infinite;
  }

  .cad-dash-crawl-reverse {
    animation: cadDashMoveReverse 18s linear infinite;
  }

  /* 9. Calm radial pulse */
  .cad-ring-pulse {
    transform-origin: 100px 100px;
    animation: cadRingPulse 10s ease-in-out infinite alternate;
  }

  /* 10. Subtle spring tension pulse */
  .cad-spring-pulse {
    animation: cadSpringTension 12s ease-in-out infinite alternate;
  }

  @keyframes cadRotateClockwise {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cadRotateCounter {
    from {
      transform: rotate(360deg);
    }
    to {
      transform: rotate(0deg);
    }
  }

  @keyframes cadDashMove {
    to {
      stroke-dashoffset: -120;
    }
  }

  @keyframes cadDashMoveReverse {
    to {
      stroke-dashoffset: 120;
    }
  }

  @keyframes cadFloatWheel {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-8px, 10px, 0);
    }
    100% {
      transform: translate3d(6px, -8px, 0);
    }
  }

  @keyframes cadFloatTread {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(10px, -8px, 0);
    }
    100% {
      transform: translate3d(-6px, 8px, 0);
    }
  }

  @keyframes cadFloatStrut {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-6px, 12px, 0);
    }
    100% {
      transform: translate3d(8px, -6px, 0);
    }
  }

  @keyframes cadFloatAero {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(10px, 8px, 0);
    }
    100% {
      transform: translate3d(-8px, -10px, 0);
    }
  }

  @keyframes cadFloatTelemetry {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-10px, -6px, 0);
    }
    100% {
      transform: translate3d(5px, 10px, 0);
    }
  }

  @keyframes cadRingPulse {
    0% {
      transform: scale(0.99);
      opacity: 0.75;
    }
    100% {
      transform: scale(1.01);
      opacity: 1;
    }
  }

  @keyframes cadSpringTension {
    0% {
      opacity: 0.8;
      transform: translateY(0);
    }
    100% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .cad-spin-clockwise,
    .cad-spin-counter,
    .cad-wheel-container,
    .cad-tread-container,
    .cad-strut-container,
    .cad-aero-container,
    .cad-telemetry-container,
    .cad-dash-crawl,
    .cad-dash-crawl-reverse,
    .cad-ring-pulse,
    .cad-spring-pulse {
      animation: none !important;
    }
  }
</style>
