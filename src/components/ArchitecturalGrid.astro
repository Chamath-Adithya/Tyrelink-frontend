---
// Tyrelink Background — Architectural Technical Grid & Pure Geometric Blueprint Illustrations
// 100% Pure CSS & SVG · Zero Confusing Numbers/Words · Crisp Matte Visibility
---

<div
  class="fixed inset-0 pointer-events-none -z-10 overflow-hidden select-none"
  aria-hidden="true"
>
  <!-- Architectural Technical Grid (Crisp, clearly visible precision lines) -->
  <div 
    class="absolute inset-0 opacity-75"
    style="background-image: linear-gradient(to right, rgba(148, 163, 184, 0.22) 1px, transparent 1px), linear-gradient(to bottom, rgba(148, 163, 184, 0.22) 1px, transparent 1px); background-size: 32px 32px;"
  ></div>

  <!-- Micro-dot precision intersection points -->
  <div
    class="absolute inset-0 opacity-45"
    style="background-image: radial-gradient(rgba(100, 116, 139, 0.35) 1.2px, transparent 1.2px); background-size: 32px 32px;"
  ></div>

  <!-- Soft Vignette Gradient to keep center readable while edges show crisp grid -->
  <div 
    class="absolute inset-0"
    style="background: radial-gradient(ellipse at 50% 25%, transparent 35%, rgba(241, 244, 248, 0.45) 75%, #f1f4f8 100%);"
  ></div>

  <!-- Pure Geometric CAD Blueprint Watermark: Concentric Wheel & Caliper Circles (NO TEXT / NO NUMBERS) -->
  <svg class="absolute top-10 right-6 lg:right-16 w-72 h-72 lg:w-96 lg:h-96 text-slate-400/[0.22] pointer-events-none" viewBox="0 0 200 200" fill="none" stroke="currentColor">
    <circle cx="100" cy="100" r="94" stroke-width="1.2" stroke-dasharray="4 4" />
    <circle cx="100" cy="100" r="76" stroke-width="1" />
    <circle cx="100" cy="100" r="50" stroke-width="0.8" stroke-dasharray="2 3" />
    <circle cx="100" cy="100" r="26" stroke-width="1" />
    <circle cx="100" cy="100" r="6" stroke-width="1.2" />
    <line x1="100" y1="2" x2="100" y2="198" stroke-width="0.75" stroke-dasharray="3 4" />
    <line x1="2" y1="100" x2="198" y2="100" stroke-width="0.75" stroke-dasharray="3 4" />
    <!-- Diagonal crosshairs -->
    <line x1="30" y1="30" x2="170" y2="170" stroke-width="0.5" stroke-dasharray="2 5" />
    <line x1="170" y1="30" x2="30" y2="170" stroke-width="0.5" stroke-dasharray="2 5" />
  </svg>

  <!-- Pure Geometric CAD Blueprint Watermark: Tread Pitch Geometric Pattern (NO TEXT / NO NUMBERS) -->
  <svg class="absolute top-[42%] left-4 lg:left-14 w-64 h-64 lg:w-80 lg:h-80 text-slate-400/[0.18] pointer-events-none" viewBox="0 0 200 200" fill="none" stroke="currentColor">
    <polygon points="15,40 185,40 160,160 40,160" stroke-width="1" stroke-dasharray="4 4" />
    <line x1="55" y1="40" x2="42" y2="160" stroke-width="0.75" />
    <line x1="95" y1="40" x2="82" y2="160" stroke-width="0.75" />
    <line x1="135" y1="40" x2="122" y2="160" stroke-width="0.75" />
    <!-- Geometric pitch arcs -->
    <path d="M 95 40 A 28 28 0 0 1 112 65" stroke-width="0.75" />
    <circle cx="100" cy="100" r="3" stroke-width="1" />
  </svg>
</div>
