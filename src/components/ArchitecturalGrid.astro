---
// Tyrelink Background — Architectural Technical Grid & Animated CAD Blueprint Illustrations
// 100% Pure CSS & SVG · Zero Confusing Numbers/Words · Subtle & Elegant
---

<div
  class="fixed inset-0 pointer-events-none -z-10 overflow-hidden select-none"
  aria-hidden="true"
>
  <!-- Minor 32px Drafting Grid (Soft, subtle, not harsh) -->
  <div 
    class="absolute inset-0"
    style="background-image: linear-gradient(to right, rgba(148, 163, 184, 0.13) 1px, transparent 1px), linear-gradient(to bottom, rgba(148, 163, 184, 0.13) 1px, transparent 1px); background-size: 32px 32px;"
  ></div>

  <!-- Major 128px Architectural Grid Lines (Subtle structure) -->
  <div 
    class="absolute inset-0"
    style="background-image: linear-gradient(to right, rgba(148, 163, 184, 0.18) 1px, transparent 1px), linear-gradient(to bottom, rgba(148, 163, 184, 0.18) 1px, transparent 1px); background-size: 128px 128px;"
  ></div>

  <!-- Precision Crosshair Dots at Intersections (Very soft) -->
  <div
    class="absolute inset-0"
    style="background-image: radial-gradient(rgba(100, 116, 139, 0.22) 1.2px, transparent 1.2px); background-size: 128px 128px; background-position: -0.6px -0.6px;"
  ></div>

  <!-- Soft Vignette Blend to keep products clean & readable -->
  <div 
    class="absolute inset-0"
    style="background: radial-gradient(ellipse at 50% 30%, transparent 55%, rgba(241, 244, 248, 0.45) 90%, #f1f4f8 100%);"
  ></div>

  <!-- ============================================================
       ANIMATED CAD BLUEPRINT WATERMARKS (Pure Geometric · 0 Text)
       ============================================================ -->

  <!-- CAD Drawing 1: Concentric Wheel Caliper & Orbit Rings (Top Right) -->
  <div class="absolute top-10 right-4 lg:right-16 w-80 h-80 lg:w-[440px] lg:h-[440px] pointer-events-none cad-wheel-container">
    <svg class="w-full h-full text-slate-400/[0.22]" viewBox="0 0 200 200" fill="none" stroke="currentColor">
      {/* Outer Rotating Dashed Caliper Ring */}
      <circle 
        cx="100" cy="100" r="94" 
        stroke-width="1.2" 
        stroke-dasharray="6 6" 
        class="cad-spin-clockwise origin-center" 
      />

      {/* Solid Reference Ring with subtle pulse */}
      <circle cx="100" cy="100" r="78" stroke-width="1" class="cad-ring-pulse origin-center" />

      {/* Inner Counter-Rotating Dashed Orbit Ring */}
      <circle 
        cx="100" cy="100" r="54" 
        stroke-width="0.9" 
        stroke-dasharray="3 4" 
        class="cad-spin-counter origin-center" 
      />

      {/* Center Hub Circles */}
      <circle cx="100" cy="100" r="28" stroke-width="1.1" />
      <circle cx="100" cy="100" r="8" stroke-width="1.3" />

      {/* Rotating Measurement Crosshair Axes */}
      <g class="cad-spin-counter origin-center">
        <line x1="100" y1="2" x2="100" y2="198" stroke-width="0.8" stroke-dasharray="4 5" />
        <line x1="2" y1="100" x2="198" y2="100" stroke-width="0.8" stroke-dasharray="4 5" />
      </g>

      {/* Fixed Diagonal Precision Crosshairs */}
      <line x1="32" y1="32" x2="168" y2="168" stroke-width="0.5" stroke-dasharray="2 6" />
      <line x1="168" y1="32" x2="32" y2="168" stroke-width="0.5" stroke-dasharray="2 6" />

      {/* Orbiting Satellite Point */}
      <g class="cad-spin-clockwise origin-center">
        <circle cx="100" cy="6" r="2.5" fill="currentColor" stroke="none" />
        <circle cx="194" cy="100" r="2" fill="currentColor" stroke="none" />
      </g>
    </svg>
  </div>

  <!-- CAD Drawing 2: Dynamic Tread Pitch & Wireframe Geometry (Middle Left) -->
  <div class="absolute top-[38%] left-4 lg:left-14 w-72 h-72 lg:w-96 lg:h-96 pointer-events-none cad-tread-container">
    <svg class="w-full h-full text-slate-400/[0.20]" viewBox="0 0 200 200" fill="none" stroke="currentColor">
      {/* Animated Flowing Tread Contour Wireframe */}
      <polygon 
        points="15,40 185,40 160,160 40,160" 
        stroke-width="1.1" 
        stroke-dasharray="6 4" 
        class="cad-dash-crawl" 
      />
      <line x1="55" y1="40" x2="42" y2="160" stroke-width="0.8" />
      <line x1="95" y1="40" x2="82" y2="160" stroke-width="0.8" />
      <line x1="135" y1="40" x2="122" y2="160" stroke-width="0.8" />

      {/* Dynamic S-Curve Tread Pitch Arc */}
      <path 
        d="M 95 40 A 28 28 0 0 1 112 65" 
        stroke-width="1" 
        stroke-dasharray="3 3"
        class="cad-dash-crawl-reverse"
      />
      <path 
        d="M 65 100 A 35 35 0 0 0 135 100" 
        stroke-width="0.8" 
        stroke-dasharray="4 4"
        class="cad-dash-crawl"
      />
      <circle cx="100" cy="100" r="3" stroke-width="1.2" />
      <circle cx="100" cy="100" r="14" stroke-width="0.6" stroke-dasharray="2 3" class="cad-spin-clockwise origin-center" />
    </svg>
  </div>

  <!-- CAD Drawing 3: Telemetry Precision Arc & Radians (Bottom Right) -->
  <div class="absolute bottom-16 right-6 lg:right-28 w-64 h-64 lg:w-80 lg:h-80 pointer-events-none cad-telemetry-container">
    <svg class="w-full h-full text-slate-400/[0.18]" viewBox="0 0 200 200" fill="none" stroke="currentColor">
      <circle cx="100" cy="100" r="85" stroke-width="0.9" stroke-dasharray="4 8" class="cad-spin-clockwise origin-center" />
      <circle cx="100" cy="100" r="60" stroke-width="1.1" />
      <circle cx="100" cy="100" r="35" stroke-width="0.8" stroke-dasharray="3 3" class="cad-spin-counter origin-center" />
      <path d="M 30 100 A 70 70 0 0 1 100 30" stroke-width="1.2" class="cad-dash-crawl" stroke-dasharray="6 4" />
      <line x1="100" y1="15" x2="100" y2="185" stroke-width="0.6" stroke-dasharray="3 5" />
      <line x1="15" y1="100" x2="185" y2="100" stroke-width="0.6" stroke-dasharray="3 5" />
    </svg>
  </div>
</div>

<style>
  /* Ultra-smooth, Hardware-Accelerated CAD Blueprint Animations */

  /* 1. Slow, hypnotic clockwise rotation (60s) */
  .cad-spin-clockwise {
    transform-origin: 100px 100px;
    animation: cadRotateClockwise 60s linear infinite;
    will-change: transform;
  }

  /* 2. Counter-clockwise rotation (45s) */
  .cad-spin-counter {
    transform-origin: 100px 100px;
    animation: cadRotateCounter 45s linear infinite;
    will-change: transform;
  }

  /* 3. Subtle floating sway for wheel container */
  .cad-wheel-container {
    animation: cadFloatWheel 18s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* 4. Subtle floating sway for tread container */
  .cad-tread-container {
    animation: cadFloatTread 22s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* 5. Telemetry container float */
  .cad-telemetry-container {
    animation: cadFloatTelemetry 20s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* 6. Dash Crawl (Laser CAD drafting effect) */
  .cad-dash-crawl {
    animation: cadDashMove 16s linear infinite;
  }

  .cad-dash-crawl-reverse {
    animation: cadDashMoveReverse 12s linear infinite;
  }

  /* 7. Subtle radial pulse */
  .cad-ring-pulse {
    transform-origin: 100px 100px;
    animation: cadRingPulse 8s ease-in-out infinite alternate;
  }

  @keyframes cadRotateClockwise {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cadRotateCounter {
    from {
      transform: rotate(360deg);
    }
    to {
      transform: rotate(0deg);
    }
  }

  @keyframes cadDashMove {
    to {
      stroke-dashoffset: -100;
    }
  }

  @keyframes cadDashMoveReverse {
    to {
      stroke-dashoffset: 100;
    }
  }

  @keyframes cadFloatWheel {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-10px, 14px, 0);
    }
    100% {
      transform: translate3d(8px, -10px, 0);
    }
  }

  @keyframes cadFloatTread {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(12px, -12px, 0);
    }
    100% {
      transform: translate3d(-8px, 10px, 0);
    }
  }

  @keyframes cadFloatTelemetry {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-12px, -8px, 0);
    }
    100% {
      transform: translate3d(6px, 12px, 0);
    }
  }

  @keyframes cadRingPulse {
    0% {
      transform: scale(0.985);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.015);
      opacity: 1;
    }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .cad-spin-clockwise,
    .cad-spin-counter,
    .cad-wheel-container,
    .cad-tread-container,
    .cad-telemetry-container,
    .cad-dash-crawl,
    .cad-dash-crawl-reverse,
    .cad-ring-pulse {
      animation: none !important;
    }
  }
</style>
