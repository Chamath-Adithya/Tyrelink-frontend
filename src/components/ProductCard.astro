---
import type { Product } from '../types';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const kokoCount = product.kokoInstallmentCount || product.installmentCount || 3;
const kokoMonthly = product.kokoInstallmentAmount || product.installmentAmount || Math.round(product.price / kokoCount);
const payzyCount = product.payzyInstallmentCount || 4;
const payzyMonthly = product.payzyInstallmentAmount || Math.round(product.price / payzyCount);
const savings = product.originalPrice ? product.originalPrice - product.price : null;

// Extract tyre dimension if available in specs
const tyreSize = product.specs?.['Tyre Size'] || product.specs?.['Size'] || product.specs?.['Rim Size'] || '';

const whatsapp = '94783724920';
const waOrderMsg = `Hello Tyrelink, I want to order ${product.brand} ${product.title} (Rs. ${product.price.toLocaleString('en-US')}). Please confirm stock and delivery.`;
---

<div
  onclick={`if (!event.target.closest('a, button')) window.location.href='/product/${product.slug}'`}
  class="product-card tyrelink-product-card bg-white reveal-scale flex flex-col justify-between p-4 group relative text-left rounded-xl border border-slate-200 hover:border-brand-500 transition-all duration-300 hover:-translate-y-1 cursor-pointer overflow-hidden"
>
  <!-- Admin Edit Quick Button (Shown only when Edit Mode is active) -->
  <button
    type="button"
    class="admin-edit-badge hidden z-30 absolute top-2.5 right-2.5 px-2.5 py-1 rounded-full bg-slate-900/95 text-brand-300 border border-brand-500/60 shadow-lg text-[10px] font-bold items-center gap-1 hover:scale-105 active:scale-95 transition-all cursor-pointer backdrop-blur-md"
    onclick={`event.preventDefault(); event.stopPropagation(); window.dispatchEvent(new CustomEvent('tyrelink:edit-product', { detail: { product: ${JSON.stringify(product).replace(/'/g, "\\'")} } }))`}
  >
    <svg class="w-3 h-3 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
    <span>Edit Product</span>
  </button>

  <div>
    <!-- Full-bleed Image Stage with Crisp Glass Canvas -->
    <a 
      href={`/product/${product.slug}`}
      class="product-image-stage block relative aspect-[4/3] sm:aspect-square max-h-[250px] sm:max-h-none w-full rounded-lg overflow-hidden mb-3 border border-slate-200/80 flex items-center justify-center p-3"
    >
      <img
        src={product.featuredImage}
        alt={product.title}
        loading="lazy"
        class="w-full h-full object-contain group-hover:scale-106 transition-transform duration-500 ease-out drop-shadow-sm"
      />
      
      <!-- Top Left Discount / Savings Badges -->
      <div class="absolute top-2.5 left-2.5 flex flex-col gap-1 z-20 pointer-events-none">
        {product.isFlashDeal && product.flashDealDiscount && (
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-gradient-to-r from-red-600 to-rose-500 text-white shadow-md">
            <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            -{product.flashDealDiscount}% OFF
          </span>
        )}
        {savings && savings > 0 && !product.isFlashDeal && (
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-500 text-white shadow-sm">
            Save Rs. {savings.toLocaleString('en-US')}
          </span>
        )}
      </div>

      <!-- Wishlist Micro-Button -->
      <button 
        type="button"
        class="absolute top-2.5 right-2.5 z-20 w-8 h-8 rounded-full bg-white/85 hover:bg-white text-slate-400 hover:text-red-500 backdrop-blur-md flex items-center justify-center shadow-sm opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all duration-200 hover:scale-110 active:scale-95 border border-white/80 cursor-pointer"
        aria-label="Save to wishlist"
        onclick="event.preventDefault(); event.stopPropagation(); this.classList.toggle('text-red-500'); this.classList.toggle('wished')"
      >
        <svg class="w-4 h-4 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </button>
    </a>

    <!-- Product Brand & Size Strip -->
    <div class="flex items-center justify-between text-[11px] mb-1.5">
      <div class="flex items-center gap-1.5">
        <span class="text-brand-600 uppercase tracking-widest font-mono text-[10px] font-black bg-red-50 px-2 py-0.5 rounded border border-red-200/80">{product.brand}</span>
        {tyreSize && (
          <span class="text-[10px] font-mono font-bold text-slate-700 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">{tyreSize}</span>
        )}
      </div>
      {product.inStock !== false ? (
        <span class="text-[10px] font-bold text-emerald-600 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          In Stock
        </span>
      ) : (
        <span class="text-[10px] font-bold text-rose-500 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
          Out of Stock
        </span>
      )}
    </div>

    <!-- Product Title & Sinhala Subtitle -->
    <div class="space-y-0.5 sm:space-y-1">
      <a href={`/product/${product.slug}`} class="block">
        <h3 class="text-sm font-bold text-slate-900 line-clamp-2 group-hover:text-brand-600 transition-colors leading-snug font-sans">
          {product.title}
        </h3>
      </a>

      {product.sinhalaTitle && (
        <p class="text-xs sm:text-[11px] text-slate-400 font-sinhala line-clamp-1">
          {product.sinhalaTitle}
        </p>
      )}
    </div>
  </div>

  <!-- Pricing & Action Footer -->
  <div class="mt-3.5 pt-3 sm:mt-4 sm:pt-3.5 border-t border-slate-100 flex items-end justify-between gap-2">
    <div class="min-w-0 flex-1">
      <div class="flex items-baseline gap-2 flex-wrap">
        <span class="text-base sm:text-lg font-black text-slate-900 font-display tracking-tight leading-none">
          Rs. {product.price.toLocaleString('en-US')}
        </span>
        {product.originalPrice && (
          <span class="text-xs sm:text-[11px] text-slate-400 line-through font-mono">
            Rs. {product.originalPrice.toLocaleString('en-US')}
          </span>
        )}
      </div>
      
      <div class="flex items-center gap-1 text-[10px] text-slate-500 mt-1 font-medium flex-wrap">
        <span>or {kokoCount}× <b class="text-slate-800 font-mono font-bold">Rs. {kokoMonthly.toLocaleString('en-US')}</b></span>
        <div class="flex items-center gap-0.5 shrink-0">
          <a
            href="https://paykoko.com/"
            target="_blank"
            rel="noopener noreferrer"
            onclick="event.stopPropagation()"
            class="inline-flex items-center gap-0.5 hover:opacity-80 transition-opacity"
            title="Pay with Koko (opens paykoko.com)"
          >
            <img src="/images/payments/koko-logo.png" alt="Koko" class="h-3 object-contain" />
            <span class="w-3 h-3 rounded-full bg-slate-800 text-white inline-flex items-center justify-center text-[8px] font-serif font-bold">i</span>
          </a>
          <span class="text-slate-300">/</span>
          <a
            href="https://payzy.lk/"
            target="_blank"
            rel="noopener noreferrer"
            onclick="event.stopPropagation()"
            class="inline-flex items-center gap-0.5 hover:opacity-80 transition-opacity"
            title="Pay with PayZy (opens payzy.lk)"
          >
            <img src="/images/payments/payzy-logo.png" alt="PayZy" class="h-2.5 object-contain" />
            <span class="w-3 h-3 rounded-full bg-slate-800 text-white inline-flex items-center justify-center text-[8px] font-serif font-bold">i</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Dual Actions: WhatsApp Quick Order Icon + View Arrow -->
    <div class="flex items-center gap-1.5 shrink-0">
      <a
        href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(waOrderMsg)}`}
        target="_blank"
        rel="noopener noreferrer"
        onclick="event.stopPropagation()"
        title="Buy via WhatsApp"
        class="w-8.5 h-8.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white flex items-center justify-center transition-all shadow-xs hover:scale-105 active:scale-95"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      </a>

      <!-- Animated CTA arrow button with frosted glass -->
      <a 
        href={`/product/${product.slug}`}
        aria-label={`View ${product.title}`}
        class="w-8.5 h-8.5 rounded-xl bg-white/80 hover:bg-brand-500 text-slate-600 hover:text-white backdrop-blur-md border border-white/70 flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_8px_20px_rgba(237,28,36,0.35)] shrink-0 btn-magnetic"
      >
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</div>
