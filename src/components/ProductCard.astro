---
import type { Product } from '../types';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const kokoCount = product.kokoInstallmentCount || product.installmentCount || 3;
const kokoMonthly = product.kokoInstallmentAmount || product.installmentAmount || Math.round(product.price / kokoCount);
const savings = product.originalPrice ? product.originalPrice - product.price : null;

// Determine tyre tier for badge (Value, Balanced, Premium)
const getTyreTier = (prod: Product) => {
  const brand = (prod.brand || '').toUpperCase();
  const price = prod.price;
  if (brand.includes('MICHELIN') || brand.includes('PIRELLI') || brand.includes('BRIDGESTONE') || price > 45000) {
    return { name: 'PREMIUM', bg: 'bg-slate-900 text-white border-slate-700' };
  }
  if (brand.includes('DUNLOP') || brand.includes('YOKOHAMA') || brand.includes('HANKOOK') || (price >= 25000 && price <= 45000)) {
    return { name: 'BALANCED', bg: 'bg-red-50 text-[#ed1c24] border-red-200' };
  }
  return { name: 'VALUE', bg: 'bg-slate-100 text-slate-700 border-slate-200' };
};

const tier = getTyreTier(product);

// Extract tyre dimension if available in specs or title
const tyreSize = product.specs?.['Tyre Size'] || product.specs?.['Size'] || product.specs?.['Rim Size'] || '';

const whatsapp = '94783724920';
const waOrderMsg = `Hello Tyrelink, I want to order ${product.brand} ${product.title} (Rs. ${product.price.toLocaleString('en-US')}). Please confirm stock and fitment.`;
---

<div
  onclick={`if (!event.target.closest('a, button')) window.location.href='/product/${product.slug}'`}
  class="product-card tyrelink-product-card bg-white reveal-scale flex flex-col justify-between p-4 group relative text-left rounded-2xl border border-slate-200 hover:border-[#ed1c24] shadow-[0_2px_8px_-2px_rgba(15,23,42,0.06),0_10px_24px_-4px_rgba(15,23,42,0.08)] hover:shadow-[0_20px_40px_-10px_rgba(237,28,36,0.18)] transition-all duration-300 hover:-translate-y-1.5 cursor-pointer"
>
  <!-- Admin Edit Quick Button (Shown only when Edit Mode is active) -->
  <button
    type="button"
    class="admin-edit-badge hidden z-30 absolute top-2.5 right-2.5 px-2.5 py-1 rounded-full bg-slate-900/95 text-brand-300 border border-brand-500/60 shadow-lg text-[10px] font-bold items-center gap-1 hover:scale-105 active:scale-95 transition-all cursor-pointer backdrop-blur-md"
    onclick={`event.preventDefault(); event.stopPropagation(); window.dispatchEvent(new CustomEvent('tyrelink:edit-product', { detail: { product: ${JSON.stringify(product).replace(/'/g, "\\'")} } }))`}
  >
    <svg class="w-3 h-3 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
    <span>Edit Product</span>
  </button>

  <div>
    <!-- Automotive Tyre Frame with Tread Shine Stage -->
    <a 
      href={`/product/${product.slug}`}
      class="block relative aspect-square max-h-[220px] w-full rounded-xl overflow-hidden mb-3.5 bg-gradient-to-b from-[#f0f0eb] to-[#e8e8e3] border border-slate-200/80 flex items-center justify-center p-3 group-hover:border-[#ed1c24]/40 transition-colors"
    >
      <img
        src={product.featuredImage}
        alt={product.title}
        loading="lazy"
        class="w-full h-full object-contain group-hover:scale-108 transition-transform duration-500 ease-out drop-shadow-[0_12px_18px_rgba(0,0,0,0.18)]"
      />
      
      <!-- Top Left: Discount / Savings Badges -->
      <div class="absolute top-2.5 left-2.5 flex flex-col gap-1 z-20 pointer-events-none">
        {product.isFlashDeal && product.flashDealDiscount && (
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-[#ed1c24] text-white shadow-xs">
            <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            -{product.flashDealDiscount}% OFF
          </span>
        )}
        {savings && savings > 0 && !product.isFlashDeal && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-emerald-600 text-white shadow-xs">
            Save Rs. {savings.toLocaleString('en-US')}
          </span>
        )}
      </div>

      <!-- Top Right: Tier Badge (VALUE, BALANCED, PREMIUM) -->
      <span class={`absolute top-2.5 right-2.5 z-20 text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-md border ${tier.bg}`}>
        {tier.name}
      </span>
    </a>

    <!-- Tyre Brand & Technical Size Code Row -->
    <div class="flex items-center justify-between text-[11px] mb-1.5">
      <span class="text-[#ed1c24] uppercase tracking-widest font-mono text-[10px] font-black">
        {product.brand}
      </span>
      {tyreSize && (
        <span class="font-mono text-[11px] font-black text-slate-800 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
          {tyreSize}
        </span>
      )}
    </div>

    <!-- Product Title & Sinhala Subtitle -->
    <div class="space-y-0.5">
      <a href={`/product/${product.slug}`} class="block">
        <h3 class="text-sm font-black text-slate-900 line-clamp-2 group-hover:text-[#ed1c24] transition-colors leading-snug font-display">
          {product.title}
        </h3>
      </a>

      {product.sinhalaTitle && (
        <p class="text-[11px] text-slate-500 font-sinhala line-clamp-1">
          {product.sinhalaTitle}
        </p>
      )}
    </div>
  </div>

  <!-- Pricing & Action Footer -->
  <div class="mt-3.5 pt-3 border-t border-slate-100 space-y-3">
    <!-- Price & Installment Line -->
    <div class="flex items-baseline justify-between gap-2 flex-wrap">
      <div>
        <div class="flex items-baseline gap-2">
          <span class="text-lg font-black text-slate-900 font-display tracking-tight leading-none">
            Rs. {product.price.toLocaleString('en-US')}
          </span>
          {product.originalPrice && (
            <span class="text-xs text-slate-400 line-through font-mono">
              Rs. {product.originalPrice.toLocaleString('en-US')}
            </span>
          )}
        </div>
        <div class="text-[10px] text-slate-500 mt-1 font-medium">
          or 3× <b class="text-slate-800 font-mono font-bold">Rs. {kokoMonthly.toLocaleString('en-US')}</b> with Koko
        </div>
      </div>

      <!-- In Stock Badge -->
      {product.inStock !== false ? (
        <span class="text-[10px] font-bold text-emerald-600 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          In Stock
        </span>
      ) : (
        <span class="text-[10px] font-bold text-rose-500 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
          Out of Stock
        </span>
      )}
    </div>

    <!-- Action Buttons Row: WhatsApp 1-Click Order + View -->
    <div class="flex items-center gap-2 pt-1">
      <a 
        href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(waOrderMsg)}`}
        target="_blank"
        rel="noopener noreferrer"
        onclick="event.stopPropagation()"
        class="flex-1 py-2 px-3 rounded-xl bg-[#25D366] hover:bg-[#1faa53] text-white text-[11px] font-black uppercase tracking-wider flex items-center justify-center gap-1.5 shadow-2xs hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
      >
        <span>Buy via WhatsApp</span>
        <span class="text-xs">↗</span>
      </a>

      <a 
        href={`/product/${product.slug}`}
        aria-label={`View ${product.title}`}
        class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-900 text-slate-700 hover:text-white flex items-center justify-center transition-all shrink-0 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</div>
