---
const equipmentHighlights = [
  { name: 'Tyre Changers', desc: 'Semi-auto & robotic leverless changers for run-flats' },
  { name: 'Wheel Balancers', desc: 'Precision dynamic laser balancing systems' },
  { name: 'Nitrogen Generators', desc: 'Commercial membrane nitrogen inflation stations' },
  { name: 'Hydraulic Lifts', desc: 'Two-post and low-profile scissor service lifts' },
];
---

<section class="w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 reveal" id="garages">
  <div class="rounded-3xl bg-[#dcdcd6] overflow-hidden border border-slate-300 shadow-md">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center p-8 sm:p-12 lg:p-16">
      
      <!-- Left Copy Column -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 text-white text-[10px] font-black uppercase tracking-widest">
          <span class="w-1.5 h-1.5 rounded-full bg-[#ed1c24] animate-pulse"></span>
          For Garages & Businesses
        </div>

        <h2 class="text-4xl sm:text-5xl font-black text-slate-900 font-display tracking-tight leading-[0.98]">
          Build a better<br />
          <em class="text-[#ed1c24] not-italic">workshop.</em>
        </h2>

        <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl">
          From a puncture-shop starter kit to a full commercial tyre centre, Tyrelink provides commercial workshop equipment, installation, warranty, and after-sales maintenance support across Sri Lanka.
        </p>

        <!-- Equipment list -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          {equipmentHighlights.map((eq) => (
            <div class="p-3.5 rounded-xl bg-white/70 border border-slate-200/80 backdrop-blur-xs">
              <strong class="block text-xs font-black text-slate-900 font-display">{eq.name}</strong>
              <span class="text-[11px] text-slate-500 font-medium">{eq.desc}</span>
            </div>
          ))}
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-4">
          <a 
            href="/category/garage-equipment" 
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-[#111111] hover:bg-black text-white text-xs font-black tracking-wide uppercase transition-all shadow-md hover:scale-105 active:scale-95 cursor-pointer"
          >
            <span>Explore garage solutions</span>
            <span>↗</span>
          </a>

          <a 
            href="https://wa.me/94783724920?text=Hi%20Tyrelink,%20I%20am%20interested%20in%20Garage%20Equipment%20for%20my%20workshop." 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-900 border border-slate-300 text-xs font-bold transition-all shadow-xs cursor-pointer"
          >
            <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
            <span>Request Quotation</span>
          </a>
        </div>
      </div>

      <!-- Right Graphic / Brand Stage -->
      <div class="lg:col-span-5 flex items-center justify-center">
        <div class="w-full aspect-[4/3] rounded-2xl bg-gradient-to-br from-[#c7c7c1] via-[#deded9] to-[#b8b8b0] p-8 flex flex-col justify-between relative overflow-hidden border border-slate-300/80 shadow-inner">
          
          <!-- Graphic stylized tools -->
          <div class="absolute -left-6 -bottom-6 text-slate-900/20 text-8xl font-black select-none pointer-events-none transform -rotate-12">
            ▱
          </div>
          <div class="absolute -right-4 -top-4 text-slate-900/20 text-8xl font-black select-none pointer-events-none transform rotate-45">
            ◒
          </div>
          <div class="absolute right-12 bottom-12 text-[#ed1c24]/25 text-9xl font-black select-none pointer-events-none transform rotate-12">
            ⌁
          </div>

          <!-- Official Stamp -->
          <div class="relative z-10 flex items-center justify-between">
            <span class="text-xs font-black font-mono text-slate-600 tracking-widest uppercase">HEAVY DUTY SPEC</span>
            <span class="px-2.5 py-1 rounded bg-[#ed1c24] text-white text-[9px] font-black tracking-wider uppercase">COMMERCIAL GRADE</span>
          </div>

          <div class="relative z-10 text-center my-auto py-6">
            <div class="text-4xl text-slate-800 mb-2">⚙️ 🔧 🛞</div>
            <p class="text-xs font-mono font-bold text-slate-600">INSTALLATION · TRAINING · WARRANTY</p>
          </div>

          <!-- Bottom Label -->
          <div class="relative z-10 flex items-end justify-between border-t border-slate-400/40 pt-4">
            <div>
              <span class="text-[10px] text-slate-500 uppercase tracking-wider block font-bold">Islandwide Technical Support</span>
              <span class="text-xs font-black text-slate-900">Colombo · Kandy · Galle · Kurunegala</span>
            </div>
            <div class="text-right">
              <strong class="text-xs font-black text-slate-900 tracking-widest block font-display">TYRELINK</strong>
              <small class="text-[9px] font-black text-[#ed1c24] tracking-widest block font-mono">WORKSHOP SYSTEMS</small>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

