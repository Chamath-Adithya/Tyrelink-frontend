---
import categories from '../data/categories.json';

const getCategoryIconSvg = (id: string) => {
  switch (id) {
    case 'car-tyres':
      return `<svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v5M12 16v5M3 12h5M16 12h5"/></svg>`;
    case 'suv-4x4':
      return `<svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="3"/><circle cx="17" cy="17" r="3"/></svg>`;
    case 'motorcycle':
      return `<svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="5" cy="17" r="3"/><circle cx="19" cy="17" r="3"/><path d="M9 17h6M12 17l4-7h3M5 17l4-7 4 4"/></svg>`;
    case 'commercial':
      return `<svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`;
    case 'wheels':
      return `<svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><path d="m4.93 4.93 4.24 4.24M14.83 14.83l4.24 4.24M14.83 9.17l4.24-4.24M4.93 19.07l4.24-4.24"/></svg>`;
    case 'garage-tools':
      return `<svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`;
    case 'garage-equipment':
      return `<svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01M12 2v4M12 18v4"/></svg>`;
    default:
      return `<svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>`;
  }
};

const getCategoryTheme = (id: string) => {
  const themes: Record<string, {
    cardBg: string;
    shadow: string;
  }> = {
    'car-tyres': {
      cardBg: 'bg-red-600',
      shadow: 'hover:shadow-[0_16px_35px_rgba(220,38,38,0.35)]',
    },
    'suv-4x4': {
      cardBg: 'bg-slate-900',
      shadow: 'hover:shadow-[0_16px_35px_rgba(15,23,42,0.40)]',
    },
    'motorcycle': {
      cardBg: 'bg-zinc-800',
      shadow: 'hover:shadow-[0_16px_35px_rgba(24,24,27,0.32)]',
    },
    'commercial': {
      cardBg: 'bg-red-600',
      shadow: 'hover:shadow-[0_16px_35px_rgba(227,27,35,0.28)]',
    },
    'wheels': {
      cardBg: 'bg-zinc-800',
      shadow: 'hover:shadow-[0_16px_35px_rgba(39,39,42,0.35)]',
    },
    'garage-tools': {
      cardBg: 'bg-red-700',
      shadow: 'hover:shadow-[0_16px_35px_rgba(185,18,26,0.30)]',
    },
    'garage-equipment': {
      cardBg: 'bg-neutral-950',
      shadow: 'hover:shadow-[0_16px_35px_rgba(23,23,23,0.45)]',
    },
  };
  return themes[id] || themes['car-tyres'];
};

// Duplicate array for 100% seamless infinite marquee scrolling on any screen size
const allCategories = [...categories, ...categories, ...categories, ...categories];
---

<section class="w-full py-6 sm:py-8 reveal overflow-hidden">
  <!-- Section Header aligned with container layout -->
  <div class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8 mb-5">
    <div class="flex items-center justify-between px-1">
      <div class="text-left">
        <div class="section-badge mb-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
          Tyre & Garage Categories
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 font-display tracking-tight">
          Featured Categories
        </h2>
        <p class="text-[11px] text-slate-400 font-sinhala mt-0.5">
          ඔබේ වාහනයට හෝ වැඩබිමට ගැළපෙන ප්‍රධාන කාණ්ඩය තෝරාගන්න
        </p>
      </div>
      
      <a 
        href="/shop" 
        class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:text-brand-700 transition-colors group bg-brand-50 hover:bg-brand-100 px-4 py-2.5 rounded-xl shadow-2xs"
      >
        <span>View All Categories</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Marquee Container with Left & Right Luxury Fade Masks (Edge-to-Edge) -->
  <div class="relative w-full py-2 overflow-hidden">
    <!-- Left fade mask -->
    <div class="absolute left-0 top-0 bottom-0 w-8 sm:w-16 bg-gradient-to-r from-[#f7f7f4] via-[#f7f7f4]/80 to-transparent z-10 pointer-events-none"></div>
    <!-- Right fade mask -->
    <div class="absolute right-0 top-0 bottom-0 w-8 sm:w-16 bg-gradient-to-l from-[#f7f7f4] via-[#f7f7f4]/80 to-transparent z-10 pointer-events-none"></div>

    <div class="overflow-x-auto sm:overflow-hidden w-full no-scrollbar">
      <div class="category-marquee-track gap-4 sm:gap-5 py-3 px-4 sm:px-0">
        {allCategories.map((cat, i) => {
          const theme = getCategoryTheme(cat.id);
          return (
            <a
              href={`/category/${cat.id}`}
              class={`category-card-automotive flex flex-col items-center justify-center min-w-[165px] sm:min-w-[185px] p-5 sm:p-6 rounded-xl ${theme.cardBg} ${theme.shadow} shadow-[0_8px_24px_rgba(0,0,0,0.12)] hover:-translate-y-1 transition-all duration-300 group shrink-0 text-center relative overflow-hidden text-white border border-white/10 cursor-pointer`}
            >
              <!-- Category Icon in Clean Translucent White Squircle -->
              <div 
                class="relative w-13 h-13 sm:w-14 sm:h-14 rounded-lg bg-white/10 text-white flex items-center justify-center group-hover:bg-white/18 transition-all duration-300 mb-3 border border-white/15"
                set:html={getCategoryIconSvg(cat.id)}
              />

              <div class="relative z-10 space-y-0.5">
                <span class="block text-xs sm:text-sm font-black text-white font-sans tracking-tight whitespace-nowrap">
                  {cat.name}
                </span>
                <span class="block text-[10px] font-bold text-white/85 font-sinhala whitespace-nowrap">
                  {cat.sinhalaName}
                </span>
              </div>

              <!-- Item Count Micro-Badge in Frosted White -->
              <div class="relative z-10 mt-2.5">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-mono font-black bg-white/20 text-white transition-transform group-hover:scale-105 backdrop-blur-sm shadow-2xs">
                  <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                  {cat.itemCount || '10+'} Items
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>
