---
import categories from '../data/categories.json';

const getCategoryIconSvg = (id: string) => {
  switch (id) {
    case 'car-tyres':
      return `<svg class="w-5 h-5 text-slate-700 group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v5M12 16v5M3 12h5M16 12h5"/></svg>`;
    case 'suv-4x4':
      return `<svg class="w-5 h-5 text-slate-700 group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="3"/><circle cx="17" cy="17" r="3"/></svg>`;
    case 'motorcycle':
      return `<svg class="w-5 h-5 text-slate-700 group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="5" cy="17" r="3"/><circle cx="19" cy="17" r="3"/><path d="M9 17h6M12 17l4-7h3M5 17l4-7 4 4"/></svg>`;
    case 'commercial':
      return `<svg class="w-5 h-5 text-slate-700 group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`;
    case 'wheels':
      return `<svg class="w-5 h-5 text-slate-700 group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><path d="m4.93 4.93 4.24 4.24M14.83 14.83l4.24 4.24M14.83 9.17l4.24-4.24M4.93 19.07l4.24-4.24"/></svg>`;
    case 'garage-tools':
      return `<svg class="w-5 h-5 text-slate-700 group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`;
    case 'garage-equipment':
      return `<svg class="w-5 h-5 text-slate-700 group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01M12 2v4M12 18v4"/></svg>`;
    default:
      return `<svg class="w-5 h-5 text-slate-700 group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>`;
  }
};
---

<section class="w-full py-8 sm:py-12 border-b border-slate-200/80 bg-[#FAFBFC]">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex items-end justify-between mb-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-[10px] font-bold uppercase tracking-widest mb-1.5">
          Curated Catalog
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 font-display tracking-tight">
          Explore by Vehicle Category
        </h2>
      </div>

      <a
        href="/shop"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-brand-600 transition-colors group"
      >
        <span>View Full Catalog</span>
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Responsive Minimalist Category Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 sm:gap-4">
      {categories.map((cat) => (
        <a
          href={`/category/${cat.id}`}
          class="group p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:border-slate-400 hover:shadow-card hover:-translate-y-1 transition-all flex flex-col justify-between text-left"
        >
          <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-200/80 flex items-center justify-center mb-4 group-hover:bg-red-50 group-hover:border-red-100 transition-colors">
            <Fragment set:html={getCategoryIconSvg(cat.id)} />
          </div>

          <div>
            <h3 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-brand-600 transition-colors line-clamp-1 font-sans">
              {cat.name}
            </h3>
            <p class="text-[10px] text-slate-400 font-sinhala truncate mt-0.5">
              {cat.sinhalaName}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
