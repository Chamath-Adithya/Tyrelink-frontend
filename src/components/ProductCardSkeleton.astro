---
// ProductCardSkeleton.astro - Static high-fidelity luxury placeholder
---

<div class="flex flex-col justify-between bg-white rounded-xl p-4 h-[410px] border border-slate-200/80 relative overflow-hidden animate-pulse select-none">
  <div class="flex-1 flex flex-col min-h-0">
    <!-- Shimmer Thumbnail Frame -->
    <div class="relative h-[190px] w-full rounded-lg overflow-hidden bg-slate-100 mb-2.5 p-4 flex items-center justify-center shrink-0">
      <div class="w-3/4 h-3/4 rounded-xl shimmer"></div>
      <div class="absolute top-2.5 left-2.5 w-16 h-5 rounded-full shimmer"></div>
    </div>

    <!-- Brand Skeleton (24px) -->
    <div class="h-6 mb-1.5 flex items-center justify-between shrink-0">
      <div class="w-16 h-4 rounded-md shimmer"></div>
      <div class="w-12 h-4 rounded-md shimmer"></div>
    </div>

    <!-- Title & Subtitle Skeleton (52px) -->
    <div class="h-[52px] space-y-1.5 pt-0.5">
      <div class="w-full h-4 rounded-md shimmer"></div>
      <div class="w-2/3 h-3.5 rounded-md shimmer"></div>
    </div>
  </div>

  <!-- Price & Action Skeleton (64px) -->
  <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 h-[64px] shrink-0">
    <div class="space-y-1.5 flex-1 min-w-0">
      <div class="w-24 h-5 rounded-md shimmer"></div>
      <div class="w-32 h-3 rounded-md shimmer"></div>
    </div>

    <div class="w-8 h-8 rounded-xl bg-slate-100 shimmer shrink-0"></div>
  </div>
</div>
